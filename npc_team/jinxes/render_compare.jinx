jinx_name: render_compare
inputs:
  - url
  - name
  - build: "true"
  - model: "kimi-k2.7-code:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"
  - render_timeout: "120"
  - repo: ""

description: |
  Render a URL with Incognidium and Firefox and ask a vision-capable LLM to
  describe the visual differences. Returns a concise visual review; no pixel
  percentage is computed or reported.

  Local `file://` URLs are served over a temporary HTTP server so Firefox
  headless can load the page and its subresources.

steps:
  - name: render_and_review
    engine: python
    code: |
      import datetime, os, shutil, shlex, subprocess, threading, urllib.parse
      from http.server import SimpleHTTPRequestHandler, HTTPServer
      from npcpy.llm_funcs import get_llm_response

      os.environ.setdefault("OLLAMA_HOST", "http://127.0.0.1:11434")

      name = {{ name | tojson }}
      url = {{ url | tojson }}
      build_str = {{ build | default("true") | tojson }}
      do_build = str(build_str).lower() not in {"false", "0", "no", ""}
      model = {{ model | default("kimi-k2.6:cloud") | tojson }}
      provider = {{ provider | default("ollama") | tojson }}
      api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}
      render_timeout = int({{ render_timeout | default("120") | tojson }})
      log_dir = "/tmp/incognidium_tests"
      os.makedirs(log_dir, exist_ok=True)
      safe_name = "".join(c if c.isalnum() or c in "-_" else "_" for c in name)
      log_path = f"{log_dir}/render_compare_{safe_name}.log"
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      repo_input = {{ repo | default("") | tojson }}
      repo = repo_input if repo_input else os.getcwd()
      repo = os.path.abspath(repo)

      def log(msg):
          with open(log_path, "a") as f:
              f.write(f"[{datetime.datetime.now().isoformat()}] {msg}\n")

      with open(log_path, "w") as f:
          f.write(f"=== render_compare start: {datetime.datetime.now().isoformat()} ===\n")

      log(f"url={url} name={name} build={do_build} model={model} provider={provider}")

      # Serve local file:// URLs over HTTP because Firefox headless screenshots
      # do not load file:// subresources reliably.
      server = None
      server_thread = None
      if url.startswith("file://"):
          parsed = urllib.parse.urlparse(url)
          raw_path = urllib.parse.unquote((parsed.netloc or "") + parsed.path)
          if raw_path.startswith("/"):
              candidate = os.path.abspath(raw_path)
              if not os.path.exists(candidate):
                  candidate = os.path.abspath(os.path.join(repo, raw_path.lstrip("/")))
          else:
              candidate = os.path.abspath(os.path.join(repo, raw_path))
          file_path = candidate
          serve_dir = os.path.dirname(file_path) or repo
          rel_path = os.path.basename(file_path)

          class Handler(SimpleHTTPRequestHandler):
              def __init__(self, *args, **kwargs):
                  super().__init__(*args, directory=serve_dir, **kwargs)

              def log_message(self, fmt, *args):
                  log(f"http: {fmt % args}")

          server = HTTPServer(("127.0.0.1", 0), Handler)
          port = server.server_address[1]
          server_thread = threading.Thread(target=server.serve_forever, daemon=True)
          server_thread.start()
          url = f"http://127.0.0.1:{port}/{rel_path}"
          log(f"serving {serve_dir} at {url}")

      def cleanup_server():
          if server:
              server.shutdown()
          if server_thread:
              server_thread.join(timeout=2)

      try:
          if do_build:
              log("build: cargo build --release --bin render_to_png")
              r = subprocess.run([cargo, "build", "--release", "--bin", "render_to_png"], cwd=repo, capture_output=True, text=True, timeout=600)
              log(f"build: rc={r.returncode}")
              if r.returncode != 0:
                  output = f"Build failed: {r.stderr[-500:]}"
                  print(output)
                  context['output'] = output
                  raise SystemExit(1)
          else:
              log("build: skipped (using existing render_to_png binary)")

          inc_png = f"{log_dir}/{name}_incognidium.png"
          log(f"incognidium: {url} -> {inc_png}")
          r = subprocess.run([cargo, "run", "--release", "--bin", "render_to_png", url, inc_png], cwd=repo, capture_output=True, text=True, timeout=render_timeout)
          log(f"incognidium: rc={r.returncode}")
          if not os.path.exists(inc_png):
              output = "Incognidium PNG missing"
              print(output)
              context['output'] = output
              raise SystemExit(1)

          ff_png = f"{log_dir}/{name}_firefox.png"
          profile = f"/tmp/ff_profile_{name}_{os.getpid()}"
          shutil.rmtree(profile, ignore_errors=True)
          os.makedirs(profile, exist_ok=True)
          env = os.environ.copy()
          env["MOZ_HEADLESS"] = "1"
          env["MOZ_ENABLE_WAYLAND"] = "0"
          env["WAYLAND_DISPLAY"] = ""
          env["DISPLAY"] = ""
          log(f"firefox: {url} -> {ff_png}")
          cmd = (
              'trap "rm -rf ' + shlex.quote(profile) + '" EXIT\n'
              'rm -f ' + shlex.quote(ff_png) + '\n'
              'timeout 90 firefox --headless --screenshot ' + shlex.quote(ff_png) +
              ' --window-size=1024,2000 --profile ' + shlex.quote(profile) +
              ' --no-remote ' + shlex.quote(url) + '\n'
              'echo "rc=$?"'
          )
          r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=120, env=env, start_new_session=True)
          log(f"firefox: rc={r.returncode}")
          if not os.path.exists(ff_png):
              output = "Firefox PNG missing"
              print(output)
              context['output'] = output
              raise SystemExit(1)

          log(f"rendered: inc={inc_png} ff={ff_png}")

          prompt = f"""
              Compare the two attached render screenshots of the same page.
              Both images are capped at the same viewport height, so content that is simply
              cut off at the bottom is not a discrepancy.
              Left/attached-first is the Incognidium browser engine, right/attached-second is Firefox.
              Describe the visual differences using precise language.
              Focus on: missing or wrong colors, layout misalignment, spacing, missing content,
              font size mismatches, overflow, overlapping text, and any broken CSS feature.
              Do not report truncation at the bottom as a problem unless one browser shows
              content that the other cuts off within the same viewport.
              Do not compute or report any numeric pixel-difference score.
              Keep the review concise (3-5 bullet points if possible).
          """

          response = get_llm_response(
              prompt,
              model=model,
              provider=provider,
              api_url=api_url,
              images=[inc_png, ff_png],
              npc=npc,
              temperature=0.3,
              timeout=300,
          )
          review = response.get("response", "")
          if review is None:
              review = ""
          if isinstance(review, dict):
              import json
              review = json.dumps(review)

          log("visual review received")
          context['output'] = review
          print(review)
          log(f"review:\n{review}")
      finally:
          cleanup_server()
