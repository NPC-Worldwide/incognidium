jinx_name: render_compare
description: Render a URL with Incognidium and Firefox, save both PNGs and a local report.
inputs:
  - url
  - name
  - model: "ornith:9b"
  - provider: "ollama"
  - report: "false"

steps:
  - name: build
    engine: python
    code: |
      import subprocess, os
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      result = subprocess.run(
          [cargo, "build", "--release", "--bin", "render_to_png"],
          cwd=os.getcwd(),
          capture_output=True, text=True, timeout=600
      )
      output = "Build OK" if result.returncode == 0 else f"Build failed: {result.stderr[-500:]}"

  - name: render_incognidium
    engine: python
    code: |
      import subprocess
      url = {{ url | tojson }}
      name = {{ name | tojson }}
      outpath = f"/tmp/incognidium_tests/{name}_incognidium.png"
      import os
      os.makedirs("/tmp/incognidium_tests", exist_ok=True)
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      result = subprocess.run(
          [cargo, "run", "--release", "--bin", "render_to_png", url, outpath],
          cwd=os.getcwd(),
          capture_output=True, text=True, timeout=120
      )
      output = result.stderr[-1000:] if result.stderr else "No output"

  - name: render_firefox
    engine: python
    code: |
      import subprocess, os, shutil
      url = {{ url | tojson }}
      name = {{ name | tojson }}
      outpath = f"/tmp/incognidium_tests/{name}_firefox.png"
      os.makedirs(os.path.dirname(outpath), exist_ok=True)
      profile = f"/tmp/ff_profile_{name}_{os.getpid()}"
      shutil.rmtree(profile, ignore_errors=True)
      os.makedirs(profile, exist_ok=True)
      env = os.environ.copy()
      env["MOZ_HEADLESS"] = "1"
      env["MOZ_ENABLE_WAYLAND"] = "0"
      env["WAYLAND_DISPLAY"] = ""
      env["DISPLAY"] = ""
      import shlex
      cmd = (
          'trap "rm -rf ' + shlex.quote(profile) + '" EXIT\n'
          'rm -f ' + shlex.quote(outpath) + '\n'
          'timeout 90 firefox --headless --screenshot ' + shlex.quote(outpath) +
          ' --window-size=1024,2000 --profile ' + shlex.quote(profile) +
          ' --no-remote ' + shlex.quote(url) + '\n'
          'echo "rc=$?"'
      )
      result = subprocess.run(
          cmd, shell=True, capture_output=True, text=True, timeout=120,
          env=env, start_new_session=True
      )
      output = "Firefox render done: " + outpath + " (rc=" + str(result.returncode) + ")"
      if result.stderr:
          output += "\n" + result.stderr[-500:]
      elif result.stdout:
          output += "\n" + result.stdout[-500:]
      shutil.rmtree(profile, ignore_errors=True)

  - name: pixel_diff
    engine: python
    code: |
      from PIL import Image
      import os
      name = {{ name | tojson }}
      inc_png = f"/tmp/incognidium_tests/{name}_incognidium.png"
      ff_png = f"/tmp/incognidium_tests/{name}_firefox.png"
      diff_png = f"/tmp/incognidium_tests/{name}_diff.png"
      if not (os.path.exists(inc_png) and os.path.exists(ff_png)):
          context["diff_percent"] = "N/A"
          context["diff_pixels"] = "0"
          context["diff_total"] = "0"
          context["diff_png"] = ""
          output = "Missing PNGs for diff"
      else:
          inc = Image.open(inc_png).convert('RGB')
          ff = Image.open(ff_png).convert('RGB')
          w = min(inc.width, ff.width)
          h = min(inc.height, ff.height)
          inc = inc.crop((0, 0, w, h))
          ff = ff.crop((0, 0, w, h))
          inc_data = list(inc.getdata())
          ff_data = list(ff.getdata())
          threshold = 10
          diff_count = 0
          for a, b in zip(inc_data, ff_data):
              if isinstance(a, int):
                  a = (a, a, a)
              if isinstance(b, int):
                  b = (b, b, b)
              if len(a) == 4:
                  a = a[:3]
              if len(b) == 4:
                  b = b[:3]
              if sum(abs(x - y) for x, y in zip(a, b)) > threshold:
                  diff_count += 1
          total = len(inc_data)
          diff_percent = (diff_count / total * 100) if total > 0 else 0.0
          context["diff_percent"] = f"{diff_percent:.2f}"
          context["diff_pixels"] = str(diff_count)
          context["diff_total"] = str(total)
          # Save diff visualization
          diff_img = Image.new('RGB', (w, h))
          diff_pixels = []
          for a, b in zip(inc_data, ff_data):
              if isinstance(a, int):
                  a = (a, a, a)
              if isinstance(b, int):
                  b = (b, b, b)
              if len(a) == 4:
                  a = a[:3]
              if len(b) == 4:
                  b = b[:3]
              d = sum(abs(x - y) for x, y in zip(a, b))
              diff_pixels.append((255, 0, 0) if d > threshold else a)
          diff_img.putdata(diff_pixels)
          diff_img.save(diff_png)
          context["diff_png"] = diff_png
          context["diff_summary"] = f"{diff_percent:.2f}% ({diff_count}/{total} pixels)"
          output = f"Pixel diff: {diff_percent:.2f}% ({diff_count}/{total} pixels)"

  - name: build_report_prompt
    engine: python
    code: |
      import os
      report_enabled = str({{ report | default("false") | tojson }}).lower() == "true"
      if report_enabled:
          name = {{ name | tojson }}
          url = {{ url | tojson }}
          inc_png = f"/tmp/incognidium_tests/{name}_incognidium.png"
          ff_png = f"/tmp/incognidium_tests/{name}_firefox.png"
          inc_exists = os.path.exists(inc_png) and os.path.getsize(inc_png) > 100
          ff_exists = os.path.exists(ff_png) and os.path.getsize(ff_png) > 100
          inc_status = "OK" if inc_exists else "MISSING"
          ff_status = "OK" if ff_exists else "MISSING"
          diff_summary = str(context.get("diff_summary", "N/A"))
          prompt_text = """Render comparison for {{ name }} ({{ url }})
          Incognidium: {{ inc_png }} (""" + inc_status + """)
          Firefox:     {{ ff_png }} (""" + ff_status + """)
          Diff image:  {{ diff_png }}
          Pixel diff:  """ + diff_summary + """
          Incognidium stderr tail:
          {{ render_incognidium }}

          Summarize the render comparison as JSON with keys:
          - summary (string): overall assessment
          - errors (list of strings): build/render errors
          - visual_differences (list of strings): likely visual discrepancies based on the diff percentage and stderr
          - highest_impact_bug (string or null): the single most important bug to fix, or null if none
          - suggested_fix (string or null): which crate/files to investigate, or null if no bug
          """.strip()
          context["report_prompt"] = prompt_text
          output = "report prompt built"
      else:
          context["report_prompt"] = ""
          output = "report prompt skipped (report=false)"

  - name: report
    engine: python
    code: |
      report_enabled = str({{ report | default("false") | tojson }}).lower() == "true"
      if report_enabled:
          from npcpy.llm_funcs import get_llm_response

          prompt = context.get("report_prompt", "")
          response = get_llm_response(
              prompt,
              model={{ model | default("ornith:9b") | tojson }},
              provider={{ provider | default("ollama") | tojson }},
              format="json",
              temperature=0.3,
          )
          result = response.get("response", "")
          if result is None:
              result = ""
          if isinstance(result, dict):
              import json as _json
              result = _json.dumps(result)
          output = result
      else:
          output = "report skipped (report=false)"
