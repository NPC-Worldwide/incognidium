jinx_name: verify_sr_only_breakpoint

description: |
  Deterministic regression check that a screen-reader-only element whose
  hiding class is cancelled by a breakpoint prefix (e.g. sr-only md:not-sr-only)
  becomes visible. The fixture uses generic classes and CSS; assertions are on
  the text extracted by the renderer.

steps:
  - name: render_and_check
    engine: python
    code: |
        import os, sys, traceback

        try:
            repo = os.getcwd()
            if repo not in sys.path:
                sys.path.insert(0, repo)
            from npc_team.jinxes.lib.render_local import render_local_file

            fixture = os.path.join(repo, "tests", "test_sr_only_breakpoint.html")
            out_png = os.path.join(repo, "tests", "test_sr_only_breakpoint_incog.png")
            result = render_local_file(
                fixture,
                out_png,
                repo=repo,
                viewport_width=1024,
            )
            if not result.get("ok"):
                context["output"] = f"render failed: {result.get('stderr', '')}"
                print(context["output"])
                raise SystemExit(1)

            text = result.get("extracted_text", "")
            if "Menu" not in text:
                context["output"] = f"visible label missing; rendered text:\n{text}"
                print(context["output"])
                raise SystemExit(1)

            if "≡" not in text:
                context["output"] = f"icon missing; rendered text:\n{text}"
                print(context["output"])
                raise SystemExit(1)

            context["output"] = "PASS: not-sr-only breakpoint cancels sr-only hiding"
            print(context["output"])
        except Exception as e:
            msg = f"ERROR: {e}\n{traceback.format_exc()}"
            context["output"] = msg
            print(msg)
            raise SystemExit(1)
