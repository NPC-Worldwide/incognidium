      def verify_rounded_box_shadow():
          import os
          import shutil
          import subprocess
          import sys
          from PIL import Image
          from npcpy.llm_funcs import get_llm_response
          
          # The NPC runtime sometimes drops the explicit api_url for Ollama models
          # and routes them to a failing cloud endpoint. Force the local host here
          # before any LLM imports so the ollama client picks it up by default.
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          
          fixture = "test_box_shadow"
          if not fixture.endswith(".html"):
              fixture = fixture + ".html"
          
          model = "glm-5.3-flash:cloud"
          provider = "ollama"
          api_url = "http://127.0.0.1:11434"
          
          repo = os.getcwd()
          html_path = os.path.join(repo, "tests", fixture)
          base = fixture.replace(".html", "")
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          firefox_png = os.path.join(repo, "tests", base + "_firefox.png")
          side_by_side = os.path.join(repo, "tests", base + "_side_by_side.png")
          
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          incog = render_local_file(html_path, incog_png, repo=repo)
          if not incog.get("ok"):
              print("FAIL: Incognidium render failed")
              context["output"] = "FAIL: Incognidium render failed"
              raise SystemExit(1)
          
          profile = f"/tmp/ff_profile_{os.getpid()}"
          shutil.rmtree(profile, ignore_errors=True)
          os.makedirs(profile, exist_ok=True)
          env = os.environ.copy()
          env["MOZ_HEADLESS"] = "1"
          env["MOZ_ENABLE_WAYLAND"] = "0"
          env["WAYLAND_DISPLAY"] = ""
          env["DISPLAY"] = ":0"
          url = "file://" + html_path
          cmd = [
              "timeout", "90", "firefox", "--headless", "--screenshot", firefox_png,
              "--window-size=1024,2000", "--profile", profile, "--no-remote", url,
          ]
          ff = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=120, start_new_session=True)
          if not os.path.exists(firefox_png):
              print("FAIL: Firefox screenshot missing")
              context["output"] = "FAIL: Firefox screenshot missing"
              raise SystemExit(1)
          
          inc = Image.open(incog_png)
          ff = Image.open(firefox_png)
          h = max(inc.height, ff.height)
          combined = Image.new("RGB", (inc.width + ff.width, h), (255, 255, 255))
          combined.paste(inc, (0, 0))
          combined.paste(ff, (inc.width, 0))
          combined.save(side_by_side)
          
          prompt = f"""
              This image is split vertically. LEFT is the Incognidium browser,
              RIGHT is Firefox. Both show the same HTML page: a white rounded
              rectangle with an outset, blurred drop-shadow on a purple gradient
              background.
          
              Look closely at the rounded corners of the white card and the shadow,
              especially the top-left, top-right, bottom-left, and bottom-right
              corners. Does the LEFT side show any of these defects that the RIGHT
              side does not?
              - Dark wedge-shaped artifacts inside or around the corners
              - Transparent cutouts that reveal the purple background where the
                card corner should be white
              - A harsh, non-blurred dark ring or border instead of a soft shadow
          
              A shadow that is simply a little darker, lighter, or differently offset
              than Firefox is NOT a FAIL. Only fail for visible corner artifacts or
              a non-blurred hard edge.
          
              Answer with exactly one of these two lines first, then add one short
              sentence explaining your choice:
              - PASS: the Incognidium shadow is smooth and the corners are clean like Firefox.
              - FAIL: a corner artifact is visible in Incognidium (name the corner and the artifact).
          """
          
          last_error = None
          reviews = []
          for vote in range(3):
              response = None
              for attempt in range(3):
                  try:
                      response = get_llm_response(
                          prompt,
                          model=model,
                          provider=provider,
                          api_url=api_url,
                          images=[side_by_side],
                          npc=npc,
                          temperature=0.1,
                          timeout=300,
                      )
                      break
                  except Exception as e:
                      last_error = e
                      print(f"LLM call vote {vote + 1} attempt {attempt + 1} failed: {e}")
                      if attempt < 2:
                          import time
                          time.sleep(2)
              if response is None:
                  reviews.append(f"LLM_ERROR: {last_error}")
                  continue
              review = response.get("response", "")
              if review is None:
                  review = ""
              if isinstance(review, dict):
                  import json
                  review = json.dumps(review)
              review_text = str(review).strip()
              reviews.append(review_text)
              if review_text.upper().startswith("PASS"):
                  break
          
          context["review"] = "\n---\n".join(
              f"Vote {i + 1}:\n{r}" for i, r in enumerate(reviews)
          )
          context["side_by_side"] = side_by_side
          context["incog_png"] = incog_png
          context["firefox_png"] = firefox_png
          
          passing_review = next(
              (r for r in reviews if r.upper().startswith("PASS")),
              reviews[0] if reviews else "",
          )
          if any(r.upper().startswith("PASS") for r in reviews):
              print(passing_review)
              print("PASS: rounded box-shadow has no corner artifacts")
              context["output"] = "PASS: rounded box-shadow has no corner artifacts"
          elif reviews:
              print(reviews[-1])
              context["output"] = reviews[-1]
              raise SystemExit(1)
          else:
              context["output"] = f"FAIL: vision review failed after 3 attempts: {last_error}"
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_select_dropdown_arrow():
          import os
          import sys
          
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          
          from PIL import Image
          from npcpy.llm_funcs import get_llm_response
          from npcpy.npc_compiler import NPC
          
          fixture = "test_form_controls"
          if not fixture.endswith(".html"):
              fixture = fixture + ".html"
          
          model = "glm-5.3-flash:cloud"
          provider = "ollama"
          api_url = "http://127.0.0.1:11434"
          
          npc = NPC(
              name="verify_select_dropdown_arrow",
              primary_directive="Confirm a default select control shows a dropdown arrow affordance.",
              model=model,
              provider=provider,
          )
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          html_path = os.path.join(repo, "tests", fixture)
          base = fixture.replace(".html", "")
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          crop_path = os.path.join(repo, "tests", base + "_select_crop.png")
          
          incog = render_local_file(html_path, incog_png, repo=repo, max_height="600")
          if not incog.get("ok"):
              print("FAIL: Incognidium render failed")
              context["output"] = "FAIL: Incognidium render failed"
              raise SystemExit(1)
          
          select_box = None
          for b in incog.get("flat_box_lines", []):
              if b[1] == "select" and b[5] > 0 and b[6] > 0:
                  select_box = b
                  break
          if select_box is None:
              print("FAIL: no select box found in flat boxes")
              context["output"] = "FAIL: no select box found in flat boxes"
              raise SystemExit(1)
          
          _, _, _, x, y, w, h, _, _ = select_box
          margin = 2
          crop_box = (
              int(max(0, x - margin)),
              int(max(0, y - margin)),
              int(x + w + margin),
              int(y + h + margin),
          )
          
          img = Image.open(incog_png)
          crop = img.crop(crop_box)
          crop.save(crop_path)
          
          prompt = """
              This is a close-up of a default HTML `<select>` dropdown control
              rendered by a browser. Describe whether a small downward-pointing
              arrow or chevron is visible on the right side of the box, separate
              from the text on the left.
          
              Answer with exactly one of the following lines first, then one short
              sentence explaining your choice:
              - PASS: a downward arrow/chevron is clearly visible on the right side.
              - FAIL: no dropdown arrow/chevron is visible on the right side.
          """
          
          response = get_llm_response(
              prompt,
              model=model,
              provider=provider,
              api_url=api_url,
              images=[crop_path],
              npc=npc,
              temperature=0.1,
              timeout=120,
          )
          review = response.get("response", "")
          if review is None:
              review = ""
          if isinstance(review, dict):
              import json
              review = json.dumps(review)
          
          review_text = str(review).strip()
          context["review"] = review_text
          context["crop_path"] = crop_path
          
          if review_text.upper().startswith("PASS"):
              print("PASS: select control shows a dropdown arrow affordance")
              context["output"] = "PASS: select control shows a dropdown arrow affordance"
          else:
              print(review_text)
              context["output"] = review_text
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_table_auto_shrink_to_fit():
          import os
          import sys
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = os.path.join(repo, "tests", "test_table_cell_valign_middle.html")
          out_png = os.path.join("/tmp", "verify_table_auto_shrink_to_fit.png")
          dump_path = os.path.join("/tmp", "verify_table_auto_shrink_to_fit_boxes.txt")
          
          info = render_local_file(
              fixture,
              out_png,
              repo=repo,
              dump_boxes=dump_path,
              viewport_width=1024,
          )
          
          if not info.get("ok"):
              context['output'] = "FAIL: could not render table shrink-to-fit fixture\n" + info.get("stderr", "")[-500:]
              raise SystemExit(1)
          
          table = None
          first_cell = None
          second_cell = None
          text_box = None
          for node_id, tag, cls, x, y, w, h, img, text in info.get("flat_box_lines", []):
              if tag == "table" and cls == "":
                  table = (x, y, w, h)
              if tag == "td" and cls == "":
                  first_cell = (x, y, w, h)
              if tag == "td" and cls == "text":
                  second_cell = (x, y, w, h)
              if tag == "#text" and text == "Centered text":
                  text_box = (x, y, w, h)
          
          failures = []
          if table is None:
              failures.append("table not found")
          elif table[2] > 500:
              failures.append(f"auto table width {table[2]:.1f} should shrink to its columns, not fill the container")
          
          if first_cell is None:
              failures.append("first table cell not found")
          elif first_cell[2] > 100:
              failures.append(f"first column width {first_cell[2]:.1f} is unexpectedly large")
          
          if second_cell is None:
              failures.append("second table cell not found")
          elif second_cell[2] < 80 or second_cell[2] > 140:
              failures.append(f"second column width {second_cell[2]:.1f} should be close to the text plus padding")
          
          if text_box is None:
              failures.append("'Centered text' box not found")
          else:
              tx, ty, tw, th = text_box
              if th > 25:
                  failures.append(f"text height {th:.1f} indicates wrapping; it should be a single line")
              if second_cell is not None and (tx < second_cell[0] or tx > second_cell[0] + 15):
                  failures.append(f"text x {tx:.1f} is not inside the padded second cell")
              if table is not None and ty < table[1]:
                  failures.append(f"text y {ty:.1f} is above the table")
          
          if failures:
              context['output'] = "FAIL: " + "; ".join(failures)
              raise SystemExit(1)
          
          context['output'] = (
              f"PASS: auto table shrinks to {table[2]:.1f}px, second cell is {second_cell[2]:.1f}px, "
              f"and 'Centered text' fits on one line"
          )
          print(context['output'])
          return context.get("output", "")
      
      def verify_textarea_overflow_clip():
          import os
          import sys
          import tempfile
          from pathlib import Path
          
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          from npcpy.llm_funcs import get_llm_response
          
          test_dir = Path(tempfile.gettempdir()) / "incognidium_textarea_clip"
          test_dir.mkdir(parents=True, exist_ok=True)
          html_path = test_dir / "textarea_clip.html"
          png_path = test_dir / "textarea_clip.png"
          
          html_path.write_text(
              """<!DOCTYPE html>
              <html>
              <head>
                <meta charset="utf-8">
                <style>
                  body { margin: 20px; font-family: sans-serif; background: #fff; }
                  textarea {
                    width: 300px;
                    padding: 10px;
                    border: 2px solid #333;
                    font-size: 14px;
                    line-height: 1.5;
                  }
                </style>
              </head>
              <body>
                <textarea rows="3" cols="40">This fixed-size textarea contains more text than three rows can show. The extra lines must stay inside the box and not draw below the bottom border. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</textarea>
              </body>
              </html>
              """
          )
          
          info = render_local_file(str(html_path), str(png_path), repo=repo)
          if not info.get("ok"):
              context["output"] = "render failed"
              raise SystemExit(1)
          
          prompt = f"""Look at the attached screenshot of a simple HTML fixture.
          
              The fixture shows a single gray-bordered textarea set to rows="3".
              It contains several lines of text, more than three rows can display.
          
              Question: does all visible text stay inside the textarea border, with
              the overflowing content clipped at the bottom edge and no text drawn
              below the border?
          
              Answer with exactly one of these lines first:
              - PASS: the text is clipped inside the textarea and nothing spills below.
              - FAIL: text is drawn below the bottom border or outside the box.
          
              Then add one short sentence explaining your choice.
              """
          
          last_error = None
          response = None
          for attempt in range(3):
              try:
                  response = get_llm_response(
                      prompt,
                      model="glm-5.3-flash:cloud",
                      provider="ollama",
                      api_url="http://127.0.0.1:11434",
                      images=[str(png_path)],
                      npc=npc,
                      temperature=0.2,
                      timeout=120,
                  )
                  break
              except Exception as e:
                  last_error = e
                  print(f"LLM call attempt {attempt + 1} failed: {e}")
                  if attempt < 2:
                      import time
                      time.sleep(2)
          if response is None:
              context["output"] = f"FAIL: LLM review failed after 3 attempts: {last_error}"
              raise SystemExit(1)
          
          review = response.get("response", "")
          if isinstance(review, dict):
              import json
              review = json.dumps(review)
          
          context["output"] = review
          print(review)
          if "PASS" in review:
              print("PASS: textarea overflow is clipped inside the fixed-height control.")
          else:
              raise SystemExit(1)
          output = context.get("output", "no result")
          return context.get("output", "")
      
