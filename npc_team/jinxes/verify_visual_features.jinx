      def verify_media_queries_orientation():
          import os, sys, traceback
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_media_queries.html")
              out_png = os.path.join(repo, "tests", "test_media_queries_incog.png")
              # Use the render_to_png defaults: viewport width 1024, max height
              # 2000. A 1024×2000 viewport is portrait, so the portrait media rule
              # should apply and the landscape rule should not.
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              extracted = result.get("extracted_text", "")
          
              # With width 1024 < height 2000, the portrait rule must match.
              if "Portrait Mode Detected" not in extracted:
                  context["output"] = f"regression: portrait orientation rule did not apply\n{extracted}"
                  print(context["output"])
                  raise SystemExit(1)
          
              # The landscape rule must not match in a portrait viewport.
              if "Landscape Mode Detected" in extracted:
                  context["output"] = f"regression: landscape orientation rule matched a portrait viewport\n{extracted}"
                  print(context["output"])
                  raise SystemExit(1)
          
              # Width 1024 is above the 768px breakpoint, so the large-screen
              # green box text should be present.
              if "Green = Large screen" not in extracted:
                  context["output"] = f"regression: min-width breakpoint text missing\n{extracted}"
                  print(context["output"])
                  raise SystemExit(1)
          
              context["output"] = "PASS: orientation media query selects portrait for a 1024x2000 viewport"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_pseudo_after_display_none():
          import os
          import sys
          
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          sys.path.insert(0, os.path.join(os.getcwd(), "npc_team", "jinxes", "lib"))
          from npcpy.llm_funcs import get_llm_response
          
          fixture = "tests/test_pseudo_after_display_none.html"
          model = "glm-5.3-flash:cloud"
          provider = "ollama"
          api_url = "http://127.0.0.1:11434"
          
          repo = os.getcwd()
          fixture_path = fixture if os.path.isabs(fixture) else os.path.join(repo, fixture)
          out_png = "/tmp/verify_pseudo_after_display_none_incog.png"
          result = render_local_file(fixture_path, out_png, repo=repo)
          if not result["ok"]:
              print(f"FAIL: render_to_png failed for {fixture}")
              print(result.get("stderr", "")[-800:])
              context["output"] = "render failed"
              raise SystemExit(1)
          
          extracted = result["extracted_text"]
          expected = "Alpha • Beta • Gamma"
          if extracted == expected:
              print("PASS: display:none on the last ::after suppresses its content")
              context["output"] = "PASS"
              raise SystemExit(0)
          
          # If the deterministic text check fails, ask a vision model whether a
          # stray separator glyph appears after the last word.
          prompt = """
              Look at the attached Incognidium screenshot. Three words are shown
              on a single centered line: Alpha, Beta, and Gamma. Each pair of words
              should be separated by a gray bullet (•), but there must NOT be a
              bullet after "Gamma". Answer with exactly one word: "clean" if no
              bullet follows Gamma, otherwise "extra".
          """
          response = get_llm_response(
              prompt,
              model=model,
              provider=provider,
              api_url=api_url,
              images=[out_png],
              temperature=0.1,
              timeout=120,
          )
          answer = str(response.get("response", "")).lower()
          if "clean" in answer:
              print("PASS: vision review confirms the hidden ::after stays hidden")
              context["output"] = "PASS"
          else:
              print(f"FAIL: expected '{expected}', got '{extracted}', vision said: {answer}")
              context["output"] = f"FAIL: {answer}"
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_pseudo_after_static():
          import os, sys
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = "test_pseudo_separator_after.html"
          html_path = os.path.join(repo, "tests", fixture)
          base = "test_pseudo_separator_after"
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          
          incog = render_local_file(
              html_path,
              incog_png,
              repo=repo,
              viewport_width="800",
              max_height="300",
          )
          if not incog.get("ok"):
              context['output'] = f"Incognidium render failed for {fixture}"
              raise SystemExit(1)
          
          labels = {}
          slashes = []
          for (x, y, w, h, text) in incog.get("text_lines", []):
              if text == "/":
                  slashes.append((x, y, w, h))
              else:
                  labels[text] = (x, y, w, h)
          
          if len(slashes) != 2:
              context['output'] = (
                  f"FAIL: expected 2 '/' separators, found {len(slashes)}.\n"
                  f"text_lines: {incog.get('text_lines')}"
              )
              raise SystemExit(1)
          
          if "Tech" not in labels or "Reviews" not in labels or "Science" not in labels:
              context['output'] = (
                  f"FAIL: expected labels missing.\n"
                  f"text_lines: {incog.get('text_lines')}"
              )
              raise SystemExit(1)
          
          tech = labels["Tech"]
          reviews = labels["Reviews"]
          science = labels["Science"]
          
          slash0_x = slashes[0][0]
          slash1_x = slashes[1][0]
          
          if not (slash0_x > tech[0] + tech[2] - 1.0 and slash0_x <= reviews[0] + 1.0):
              context['output'] = (
                  f"FAIL: first separator is not between Tech and Reviews.\n"
                  f"slash0_x={slash0_x} tech_right={tech[0]+tech[2]} reviews_x={reviews[0]}"
              )
              raise SystemExit(1)
          
          if not (slash1_x > reviews[0] + reviews[2] - 1.0 and slash1_x <= science[0] + 1.0):
              context['output'] = (
                  f"FAIL: second separator is not between Reviews and Science.\n"
                  f"slash1_x={slash1_x} reviews_right={reviews[0]+reviews[2]} science_x={science[0]}"
              )
              raise SystemExit(1)
          
          context['output'] = (
              "PASS: ::after pseudo-elements use static inline position between nav items"
          )
          print(context['output'])
          return context.get("output", "")

      def verify_pseudo_separator_relative():
          import os, sys, traceback

          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)

              fixture = "test_pseudo_separator_relative.html"
              html_path = os.path.join(repo, "tests", fixture)
              out_png = os.path.join(repo, "tests", "test_pseudo_separator_relative_incog.png")

              result = render_local_file(
                  html_path,
                  out_png,
                  repo=repo,
                  viewport_width=400,
                  max_height=200,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)

              labels = {}
              slashes = []
              for (x, y, w, h, text) in result.get("text_lines", []):
                  if text == "/":
                      slashes.append((x, y, w, h))
                  else:
                      labels[text] = (x, y, w, h)

              if len(slashes) != 2:
                  context["output"] = (
                      f"FAIL: expected 2 '/' separators, found {len(slashes)}.\n"
                      f"text_lines: {result.get('text_lines')}"
                  )
                  print(context["output"])
                  raise SystemExit(1)

              for label in ("Tech", "Reviews", "Science"):
                  if label not in labels:
                      context["output"] = (
                          f"FAIL: expected label {label!r} missing.\n"
                          f"text_lines: {result.get('text_lines')}"
                      )
                      print(context["output"])
                      raise SystemExit(1)

              tech = labels["Tech"]
              reviews = labels["Reviews"]
              science = labels["Science"]

              slash0_x = slashes[0][0]
              slash1_x = slashes[1][0]

              # With the fix for negative absolute offsets, the separators sit
              # between the breadcrumb items. Before the fix they were clamped
              # to right:0 and overlapped the item text.
              if not (slash0_x > tech[0] + tech[2] - 1.0 and slash0_x <= reviews[0] + 1.0):
                  context["output"] = (
                      f"FAIL: first separator is not between Tech and Reviews.\n"
                      f"slash0_x={slash0_x} tech_right={tech[0]+tech[2]} reviews_x={reviews[0]}"
                  )
                  print(context["output"])
                  raise SystemExit(1)

              if not (slash1_x > reviews[0] + reviews[2] - 1.0 and slash1_x <= science[0] + 1.0):
                  context["output"] = (
                      f"FAIL: second separator is not between Reviews and Science.\n"
                      f"slash1_x={slash1_x} reviews_right={reviews[0]+reviews[2]} science_x={science[0]}"
                  )
                  print(context["output"])
                  raise SystemExit(1)

              context["output"] = (
                  "PASS: relative pseudo-element separators stay between items with negative absolute offsets"
              )
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")

      def verify_repeating_gradient():
