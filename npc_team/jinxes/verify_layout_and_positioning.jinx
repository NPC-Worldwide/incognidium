      def verify_flex_chip_wrap():
          import os, sys, traceback
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_flex_chip_wrap.html")
              out_png = os.path.join(repo, "tests", "test_flex_chip_wrap_incog.png")
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
                  viewport_width=400,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              text = result.get("extracted_text", "")
              # The renderer concatenates chip text on the same visual line; the
              # important fact is that "CULVER CITY" is not split across lines.
              if "CULVER\nCITY" in text or "CULVER\r\nCITY" in text:
                  context["output"] = f"two-word chip wrapped internally:\n{text}"
                  print(context["output"])
                  raise SystemExit(1)
          
              chips = ["LAX", "HOLLYWOOD", "CULVER CITY", "INGLEWOOD", "MALIBU"]
              missing = [c for c in chips if c not in text]
              if missing:
                  context["output"] = f"missing chip text: {missing}\nrendered text:\n{text}"
                  print(context["output"])
                  raise SystemExit(1)
          
              # Also verify the two-word chip box is roughly as wide as its
              # single-word neighbors, not collapsed to the longest word.
              flat = result.get("flat_box_lines", [])
              chip_boxes = [
                  (w, h, t)
                  for (_, _, _, _, _, w, h, _, t) in flat
                  if t in chips
              ]
              culver = next((w for w, h, t in chip_boxes if t == "CULVER CITY"), 0.0)
              hollywood = next((w for w, h, t in chip_boxes if t == "HOLLYWOOD"), 0.0)
              if culver < hollywood * 0.9:
                  context["output"] = f"CULVER CITY chip too narrow: {culver}px vs HOLLYWOOD {hollywood}px"
                  print(context["output"])
                  raise SystemExit(1)
          
              context["output"] = "PASS: flex chip row keeps each chip on one line"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_flex_grid_1fr_overflow():
          import os, sys, traceback
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_flex_grid_1fr_overflow.html")
              out_png = os.path.join(repo, "tests", "test_flex_grid_1fr_overflow_incog.png")
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
                  viewport_width=1200,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              flat = result.get("flat_box_lines", [])
              # Find the two card border boxes by their dashed container.
              cards = [
                  (x, y, w, h, t)
                  for (x, y, _, _, _, w, h, _, t) in flat
                  if "Left" in t or "Right" in t
              ]
              # The first text box per card is the image placeholder label;
              # the second is the caption. We want the card itself, which is the
              # parent box around both. Use the text boxes as proxies for card
              # bounds because the image labels sit at the top-left of each card.
              left_label = next(
                  (x, y, w, h, t) for (x, y, w, h, t) in cards if t == "Left"
              )
              right_label = next(
                  (x, y, w, h, t) for (x, y, w, h, t) in cards if t == "Right"
              )
              left_x, left_w = left_label[0], left_label[2]
              right_x, right_w = right_label[0], right_label[2]
              container_right = 1011  # 800px max-width + 20px body padding + 2px border, ~1011 absolute
              if right_x + right_w > container_right + 5:
                  context["output"] = f"right card overflows container: x={right_x} w={right_w}"
                  print(context["output"])
                  raise SystemExit(1)
          
              # Both cards should be roughly the same width (within 10%).
              ratio = min(left_w, right_w) / max(left_w, right_w)
              if ratio < 0.9:
                  context["output"] = f"cards have very different widths: left={left_w}px right={right_w}px"
                  print(context["output"])
                  raise SystemExit(1)
          
              context["output"] = "PASS: flex row cards share width and large image stays inside"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
