          from PIL import Image, ImageDraw, ImageFont
          
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          from npcpy.llm_funcs import get_llm_response
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture1 = "test_float_wrap.html"
          fixture2 = "test_float_text_continues_below.html"
          fixture3 = "test_float_text_blockify.html"
          
          cases = [
              (fixture1, "Squeezed text between floats", "verify_float_wrap"),
              (fixture2, "Text continues below float", "verify_float_continues_below"),
              (fixture3, "Inline badge float blockifies text", "verify_float_blockify"),
          ]
          
          pairs = []
          for fixture, label, short in cases:
              html_path = os.path.join(repo, "tests", fixture)
              incog_png = os.path.join(repo, "tests", short + "_incog.png")
              firefox_png = os.path.join(repo, "tests", short + "_firefox.png")
              side_png = os.path.join(repo, "tests", short + "_side.png")
          
              result = render_local_file(html_path, incog_png, repo=repo)
              if not result.get("ok"):
                  context["output"] = f"FAIL: Incognidium render failed for {fixture}"
                  raise SystemExit(1)
          
              if not firefox_screenshot(html_path, firefox_png):
                  context["output"] = f"FAIL: Firefox screenshot failed for {fixture}"
                  raise SystemExit(1)
          
              side_by_side_image(incog_png, firefox_png, side_png)
              pairs.append((side_png, label, fixture))
          
          label_height = 28
          pad = 10
          w = max(Image.open(png).width for png, _, _ in pairs)
          total_h = sum(Image.open(png).height for png, _, _ in pairs) + label_height * len(pairs) + pad * (len(pairs) + 1)
          combined = Image.new("RGB", (w + pad * 2, total_h), (255, 255, 255))
          draw = ImageDraw.Draw(combined)
          try:
              font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 16)
          except Exception:
              font = ImageFont.load_default()
          
          y = pad
          for side_png, label, fixture in pairs:
              draw.text((pad, y), f"{label} ({fixture}) -- Incognidium left, Firefox right", fill=(0, 0, 0), font=font)
              y += label_height
              img = Image.open(side_png)
              combined.paste(img, (pad, y))
              y += img.height + pad
          
          combined_path = os.path.join(repo, "tests", "verify_float_wrap_combined.png")
          combined.save(combined_path)
          
          model = "glm-5.3-flash:cloud"
          provider = "ollama"
          api_url = "http://127.0.0.1:11434"
          
          prompt = f"""
            The attached image shows three local HTML test fixtures rendered side-by-side.
            For each fixture, the left half is Incognidium and the right half is Firefox.
            Firefox is provided only as a reference for the intended behavior. Do not
            fail Incognidium for minor line-break differences; only fail if Incognidium
            has a real usability problem that the reference does not.
          
            1. Squeezed text between floats (test_float_wrap.html):
               Text should flow between the two top floats, then continue at the full page width once below the floats. The 400px-wide body is naturally narrow; do not count that as a defect unless text overlaps a float or is clipped.
          
            2. Text continues below float (test_float_text_continues_below.html):
               Text should wrap beside the gray float and then continue at the full page width once it is below the float, without dropping the last word onto a lonely line.
          
            3. Inline badge float blockifies text (test_float_text_blockify.html):
               A small left badge should have multi-word text beside it; no stray orphan word should appear far below or misaligned.
          
            Return one line per fixture like "fixture_name: PASS" or "fixture_name: FAIL",
            explaining briefly only for FAIL. Then end with exactly one of:
            OVERALL: PASS
            OVERALL: FAIL
            OVERALL: PASS means Incognidium has no usability problem compared to the reference.
          """
          
          reviews = []
          last_error = None
          for vote in range(3):
              response = None
              for attempt in range(3):
                  try:
                      response = get_llm_response(
                          prompt,
                          model=model,
                          provider=provider,
                          api_url=api_url,
                          images=[combined_path],
                          npc=npc,
                          temperature=0.2,
                          timeout=300,
                      )
                      break
                  except Exception as e:
                      last_error = e
                      print(f"LLM call vote {vote + 1} attempt {attempt + 1} failed: {e}")
                      if attempt < 2:
                          import time
                          time.sleep(2)
              if response is None:
                  reviews.append(f"LLM_ERROR: {last_error}")
                  continue
              review = response.get("response", "")
              if review is None:
                  review = ""
              if isinstance(review, dict):
                  import json
                  review = json.dumps(review)
              review_text = str(review).strip()
              reviews.append(review_text)
              if "OVERALL: PASS" in review_text.upper():
                  break
          
          context["comparison_review"] = "\n---\n".join(
              f"Vote {i + 1}:\n{r}" for i, r in enumerate(reviews)
          )
          context["combined_png"] = combined_path
          
          passing_review = next(
              (r for r in reviews if "OVERALL: PASS" in r.upper()),
              reviews[0] if reviews else "",
          )
          if any("OVERALL: PASS" in r.upper() for r in reviews):
              print(passing_review)
              print("PASS: float-wrap fixtures match Firefox.")
              context["output"] = "PASS: float-wrap fixtures match Firefox."
          elif reviews:
              print(reviews[-1])
              print("FAIL: at least one float-wrap fixture differs from Firefox.")
              context["output"] = "FAIL: at least one float-wrap fixture differs from Firefox."
              raise SystemExit(1)
          else:
              context["output"] = f"FAIL: vision review failed after 3 attempts: {last_error}"
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_float_zero_inline_space():
          import os, sys, traceback
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_float_zero_inline_space.html")
              out_png = os.path.join(repo, "tests", "test_float_zero_inline_space_incog.png")
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
                  viewport_width=800,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              text = result.get("extracted_text", "")
              lines = [line for line in text.splitlines() if line.strip()]
              if len(lines) < 2:
                  context["output"] = f"expected wrapped text, got:\n{text}"
                  print(context["output"])
                  raise SystemExit(1)
          
              first = lines[0]
              second = lines[1]
              if not first.startswith("This long headline must not"):
                  context["output"] = f"unexpected first line: {first!r}"
                  print(context["output"])
                  raise SystemExit(1)
              if not second.startswith("overlap"):
                  context["output"] = f"expected second line to start with 'overlap', got: {second!r}"
                  print(context["output"])
                  raise SystemExit(1)
          
              context["output"] = "PASS: inline link text wraps when a float leaves no inline space"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_grid_fr_tracks():
          import os
          import sys
          
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          from npcpy.llm_funcs import get_llm_response
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = "test_grid_space_between_fr_tracks.html"
          html_path = os.path.join(repo, "tests", fixture)
          base = "test_grid_space_between_fr_tracks"
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          
          incog = render_local_file(html_path, incog_png, repo=repo)
          if not incog.get("ok"):
              context["output"] = f"FAIL: Incognidium render failed for {fixture}"
              raise SystemExit(1)
          
          extracted = incog.get("extracted_text", "")
          for expected in ["Top box", "Bottom box"]:
              if expected not in extracted:
                  context["output"] = f"FAIL: missing extracted text '{expected}'"
                  raise SystemExit(1)
          
          prompt = f"""
            Look at the attached screenshot of a local HTML page.
          
            The page shows a single 400x400 light gray grid container with two dark
            boxes inside it: "Top box" and "Bottom box". The grid rows are both
            `1fr` and the grid uses `align-content: space-between`.
          
            Does the layout show the two dark boxes stacked one above the other with
            only a small gap between them, filling the container vertically? Or is
            there a huge empty gray gap between the boxes, leaving most of the
            container unused?
          
            Answer with exactly one of these phrases:
            - "boxes fill container" if the two boxes occupy the top and bottom of the container with no large gap
            - "large gap" if there is a huge empty gray space between the boxes
            - "unclear" if you cannot tell
          
            Then add one short sentence describing what you see.
          """
          
          response = get_llm_response(
              prompt,
              model="glm-5.3-flash:cloud",
              provider="ollama",
              api_url="http://127.0.0.1:11434",
              images=[incog_png],
              npc=npc,
              temperature=0.2,
              timeout=300,
          )
          review = response.get("response", "")
          if review is None:
              review = ""
          if isinstance(review, dict):
              import json
              review = json.dumps(review)
          review_text = str(review).strip()
          
          context["incog_png"] = incog_png
          context["extracted_text"] = extracted
          context["vision_review"] = review_text
          
          if "large gap" in review_text.lower() or "unclear" in review_text.lower():
              context["output"] = f"FAIL: {review_text}"
              raise SystemExit(1)
          
          print(review_text)
          print("PASS: 1fr grid rows fill the definite-height container.")
          context["output"] = "PASS: 1fr grid rows fill the definite-height container."
          return context.get("output", "")
      
      def verify_grid_span_flexible_row():
          import os, sys, traceback
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_grid_span_flexible_row.html")
              out_png = os.path.join(repo, "tests", "test_grid_span_flexible_row_incog.png")
              dump_path = os.path.join(repo, "tests", "test_grid_span_flexible_row_boxes.txt")
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
                  dump_boxes=dump_path,
                  viewport_width=800,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              head_y = body_y = side_y = side_h = None
              for node_id, tag, cls, x, y, w, h, img, text in result.get("flat_box_lines", []):
                  if cls == "head":
                      head_y = y
                  elif cls == "body":
                      body_y = y
                  elif cls == "side":
                      side_y = y
                      side_h = h
          
              if head_y is None or body_y is None or side_h is None:
                  context["output"] = "FAIL: could not locate header, body, or sidebar box"
                  print(context["output"])
                  raise SystemExit(1)
          
              # The bug manifests as the body starting roughly halfway down the
              # sidebar because the spanned height is split evenly across rows.
              # A correct grid puts the extra height into the flexible body row,
              # keeping the body near the top of the grid.
              if body_y - head_y > side_h / 4.0:
                  context["output"] = (
                      f"FAIL: grid body is too far down (offset {body_y - head_y:.1f}px) "
                      f"for a {side_h:.1f}px spanned sidebar; "
                      f"the rows were split instead of filling the flexible row"
                  )
                  print(context["output"])
                  raise SystemExit(1)
          
              context["output"] = (
                  "PASS: a grid item spanning a min-content row and a flexible row "
                  "keeps the body directly below the header"
              )
              print(context["output"])
          except SystemExit:
              raise
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_pseudo_flex_triangle2():
          import os
          import sys
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = os.path.join(repo, "tests", "test_pseudo_flex_triangle2.html")
          out_png = os.path.join("/tmp", "verify_pseudo_flex_triangle2.png")
          dump_path = os.path.join("/tmp", "verify_pseudo_flex_triangle2_boxes.txt")
          
          info = render_local_file(
              fixture,
              out_png,
              repo=repo,
              max_height="400",
              dump_boxes=dump_path,
          )
          
          if not info.get("ok"):
              context['output'] = "FAIL: could not render pseudo-flex-triangle2 fixture\n" + info.get("stderr", "")[-500:]
              raise SystemExit(1)
          
          container = None
          triangle = None
          number = None
          for node_id, tag, cls, x, y, w, h, img, text in info.get("flat_box_lines", []):
              if cls == "vote" and tag == "a":
                  container = (x, y, w, h)
              if text and "△" in text:
                  triangle = (x, y, w, h)
              if text == "76":
                  number = (x, y, w, h)
          
          failures = []
          if container is None:
              failures.append("flex container .vote not found")
          elif container[2] < 800:
              failures.append(f"container width {container[2]} is unexpectedly small")
          
          if triangle is None:
              failures.append("::before triangle text box not found")
          else:
              tx, ty, tw, th = triangle
              if tw > 100:
                  failures.append(f"triangle box width {tw} should be intrinsic, not full container")
              if container is not None:
                  center = container[0] + container[2] / 2.0
                  if abs(tx + tw / 2.0 - center) > 30.0:
                      failures.append(f"triangle center {tx + tw/2.0} far from container center {center}")
          
          if number is None:
              failures.append("text node '76' not found")
          else:
              nx, ny, nw, nh = number
              if container is not None:
                  center = container[0] + container[2] / 2.0
                  if abs(nx + nw / 2.0 - center) > 30.0:
                      failures.append(f"'76' center {nx + nw/2.0} far from container center {center}")
          
          if triangle is not None and number is not None:
              if abs((triangle[0] + triangle[2] / 2.0) - (number[0] + number[2] / 2.0)) > 30.0:
                  failures.append("triangle and '76' are not centered on the same axis")
              if (number[1] + number[3] / 2.0) <= (triangle[1] + triangle[3] / 2.0):
                  failures.append("'76' should sit visually below the triangle")
          
          if failures:
              context['output'] = "FAIL: " + "; ".join(failures)
              raise SystemExit(1)
          
          context['output'] = (
              f"PASS: pseudo-element ({triangle[2]:.1f}px wide) and '76' are centered "
              f"inside the {container[2]:.1f}px flex container"
          )
          return context.get("output", "")
      
      def verify_resize_handle_placement():
          import os
          import sys
          import time
          
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          from npcpy.llm_funcs import get_llm_response
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = "test_resize.html"
          html_path = os.path.join(repo, "tests", fixture)
          base = "test_resize"
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          
          incog = render_local_file(html_path, incog_png, repo=repo)
          if not incog.get("ok"):
              print("FAIL: Incognidium render failed")
              context["output"] = "FAIL: Incognidium render failed"
              raise SystemExit(1)
          
          model = "glm-5.3-flash:cloud"
          provider = "ollama"
          api_url = "http://127.0.0.1:11434"
          
          prompt = """
            Look at the attached screenshot of a local HTML page.
          
            The page shows four colored boxes under headings:
            - "resize: both" (purple gradient)
            - "resize: horizontal" (green gradient)
            - "resize: vertical" (orange gradient)
            - "resize: none" (gray)
          
            Each resizable box contains text like "Resize me in any direction!",
            "Resize me sideways!", or "Resize me up and down!". A correct
            rendering places the resize grip only as a small diagonal-line corner
            indicator at the bottom-right corner of the three resizable boxes.
          
            A resize grip here is specifically the small diagonal-line corner
            indicator at the bottom-right of a resizable box. Gradients,
            background colors, or soft highlights behind the text do NOT count as
            extra grips.
          
            Are there any extra diagonal-line resize grips drawn inside the text
            area, at the end of the label text, or anywhere other than the
            bottom-right corner of the three resizable boxes?
          
            Answer with exactly one of these phrases:
            - "PASS" if the only diagonal-line grips are at the bottom-right corners
            - "FAIL" if there is an extra diagonal-line grip drawn inline with or inside the text
            - "unclear" if you cannot tell
          
            Then add one short sentence describing what you see.
          """
          
          response = None
          last_error = None
          for attempt in range(3):
              try:
                  response = get_llm_response(
                      prompt,
                      model=model,
                      provider=provider,
                      api_url=api_url,
                      images=[incog_png],
                      npc=npc,
                      temperature=0.2,
                      timeout=300,
                  )
                  break
              except Exception as e:
                  last_error = e
                  print(f"LLM call attempt {attempt + 1} failed: {e}")
                  if attempt < 2:
                      time.sleep(2)
          
          if response is None:
              print(f"FAIL: Visual review failed after 3 attempts: {last_error}")
              context["output"] = f"FAIL: Visual review failed after 3 attempts: {last_error}"
              raise SystemExit(1)
          
          review = response.get("response", "")
          if review is None:
              review = ""
          if isinstance(review, dict):
              import json
              review = json.dumps(review)
          review_text = str(review).strip()
          print(review_text)
          
          # Extract the verdict word from possible markdown bold markers.
          verdict_match = review_text.upper().split()
          verdict = ""
          for token in verdict_match:
              clean = token.strip("*_: ")
              if clean in ("PASS", "FAIL", "UNCLEAR"):
                  verdict = clean
                  break
          
          if verdict == "PASS":
              print("PASS: resize handles stay at the bottom-right corner")
              context["output"] = "PASS: resize handles stay at the bottom-right corner"
          elif verdict == "FAIL":
              print("FAIL: resize handle placement is wrong")
              context["output"] = "FAIL: resize handle placement is wrong"
              raise SystemExit(1)
          else:
              print(f"FAIL: unclear verdict ({verdict!r})")
              context["output"] = f"FAIL: unclear verdict ({verdict!r})"
              raise SystemExit(1)
          return context.get("output", "")
      
