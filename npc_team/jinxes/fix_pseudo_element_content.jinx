#!/usr/bin/env npc
jinx_name: fix_pseudo_element_content
description: |
  Make content-only ::before/::after pseudo-elements create a real visual box.
  Previously a pseudo-element whose only declaration was generated content (e.g.
  an icon via `content: "\25b3"`) produced an anonymous text child that ignored
  the pseudo-element's own font-size and font-family. Now it is treated as
  visual so a styled pseudo box is generated, matching CSS behavior.
inputs:
  - repro_path: "tests/test_pseudo_flex_triangle.html"
  - output_name: "pseudo_flex_triangle_npc"

steps:
  - name: patch_style_pseudo_visual
    engine: python
    code: |
      import os

      repo = os.getcwd()
      path = os.path.join(repo, "crates/incognidium-style/src/lib.rs")
      with open(path) as f:
          src = f.read()

      helper_old = [
          "}",
          "",
          "/// Compute style for an element by matching CSS rules + inline styles.",
          "fn compute_style_for_element(",
      ]
      helper_new = [
          "}",
          "",
          "/// True when a ::before/::after pseudo-element has generated content that",
          "/// should produce a box, even if it has no background, border, or dimensions.",
          "fn has_generated_content(content: &Content) -> bool {",
          "    match content {",
          "        Content::Normal | Content::None => false,",
          "        Content::Text(s) => !s.is_empty(),",
          "        Content::Parts(parts) => parts.iter().any(|p| has_generated_content(p)),",
          "        _ => true,",
          "    }",
          "}",
          "",
          "/// Compute style for an element by matching CSS rules + inline styles.",
          "fn compute_style_for_element(",
      ]

      after_old = [
          "        let has_visual = after_style.background_color.a > 0",
          "            || !after_style.background_image.is_empty()",
          "            || after_style.border_top_width > 0.0",
          "            || after_style.border_bottom_width > 0.0",
          "            || after_style.border_left_width > 0.0",
          "            || after_style.border_right_width > 0.0",
          "            || !matches!(after_style.width, SizeValue::Auto | SizeValue::None)",
          "            || !matches!(after_style.height, SizeValue::Auto | SizeValue::None)",
          "            || !matches!(after_style.position, Position::Static)",
          "            || after_style.padding_top > 0.0",
          "            || after_style.padding_bottom > 0.0",
          "            || after_style.padding_left > 0.0",
          "            || after_style.padding_right > 0.0",
          "            || after_style.margin_top > 0.0",
          "            || after_style.margin_bottom > 0.0",
          "            || after_style.margin_left > 0.0",
          "            || after_style.margin_right > 0.0",
          "            || !matches!(after_style.display, Display::Inline | Display::None);",
      ]
      after_new = [
          "        let has_visual = after_style.background_color.a > 0",
          "            || !after_style.background_image.is_empty()",
          "            || after_style.border_top_width > 0.0",
          "            || after_style.border_bottom_width > 0.0",
          "            || after_style.border_left_width > 0.0",
          "            || after_style.border_right_width > 0.0",
          "            || !matches!(after_style.width, SizeValue::Auto | SizeValue::None)",
          "            || !matches!(after_style.height, SizeValue::Auto | SizeValue::None)",
          "            || !matches!(after_style.position, Position::Static)",
          "            || after_style.padding_top > 0.0",
          "            || after_style.padding_bottom > 0.0",
          "            || after_style.padding_left > 0.0",
          "            || after_style.padding_right > 0.0",
          "            || after_style.margin_top > 0.0",
          "            || after_style.margin_bottom > 0.0",
          "            || after_style.margin_left > 0.0",
          "            || after_style.margin_right > 0.0",
          "            || !matches!(after_style.display, Display::Inline | Display::None)",
          "            || has_generated_content(&style.after_content);",
      ]

      before_old = [
          "        let has_visual = before_style.background_color.a > 0",
          "            || !before_style.background_image.is_empty()",
          "            || before_style.border_top_width > 0.0",
          "            || before_style.border_bottom_width > 0.0",
          "            || before_style.border_left_width > 0.0",
          "            || before_style.border_right_width > 0.0",
          "            || !matches!(before_style.width, SizeValue::Auto | SizeValue::None)",
          "            || !matches!(before_style.height, SizeValue::Auto | SizeValue::None)",
          "            || !matches!(before_style.position, Position::Static)",
          "            || before_style.padding_top > 0.0",
          "            || before_style.padding_bottom > 0.0",
          "            || before_style.padding_left > 0.0",
          "            || before_style.padding_right > 0.0",
          "            || before_style.margin_top > 0.0",
          "            || before_style.margin_bottom > 0.0",
          "            || before_style.margin_left > 0.0",
          "            || before_style.margin_right > 0.0",
          "            || !matches!(before_style.display, Display::Inline | Display::None);",
      ]
      before_new = [
          "        let has_visual = before_style.background_color.a > 0",
          "            || !before_style.background_image.is_empty()",
          "            || before_style.border_top_width > 0.0",
          "            || before_style.border_bottom_width > 0.0",
          "            || before_style.border_left_width > 0.0",
          "            || before_style.border_right_width > 0.0",
          "            || !matches!(before_style.width, SizeValue::Auto | SizeValue::None)",
          "            || !matches!(before_style.height, SizeValue::Auto | SizeValue::None)",
          "            || !matches!(before_style.position, Position::Static)",
          "            || before_style.padding_top > 0.0",
          "            || before_style.padding_bottom > 0.0",
          "            || before_style.padding_left > 0.0",
          "            || before_style.padding_right > 0.0",
          "            || before_style.margin_top > 0.0",
          "            || before_style.margin_bottom > 0.0",
          "            || before_style.margin_left > 0.0",
          "            || before_style.margin_right > 0.0",
          "            || !matches!(before_style.display, Display::Inline | Display::None)",
          "            || has_generated_content(&style.before_content);",
      ]

      log_file = "/tmp/fix_pseudo_element_content.log"
      log = []
      patched = True

      old_helper = "\n".join(helper_old)
      new_helper = "\n".join(helper_new)
      if old_helper not in src:
          if "fn has_generated_content" in src:
              log.append("helper already present")
          else:
              log.append("ERROR: helper insertion point not found")
              patched = False
      else:
          src = src.replace(old_helper, new_helper, 1)
          log.append("Patched helper into " + path)

      old_after = "\n".join(after_old)
      new_after = "\n".join(after_new)
      if old_after not in src:
          if "has_generated_content(&style.after_content)" in src:
              log.append("after block already patched")
          else:
              log.append("ERROR: after has_visual block not found")
              patched = False
      else:
          src = src.replace(old_after, new_after, 1)
          log.append("Patched after has_visual")

      old_before = "\n".join(before_old)
      new_before = "\n".join(before_new)
      if old_before not in src:
          if "has_generated_content(&style.before_content)" in src:
              log.append("before block already patched")
          else:
              log.append("ERROR: before has_visual block not found")
              patched = False
      else:
          src = src.replace(old_before, new_before, 1)
          log.append("Patched before has_visual")

      if patched:
          with open(path, "w") as f:
              f.write(src)

      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("\n".join(log) + "\n")
      context["patched"] = patched
      context["log_file"] = log_file
      context["output"] = "\n".join(log)

  - name: patch_layout_test
    engine: python
    code: |
      import os

      repo = os.getcwd()
      log_file = context.get("log_file", "/tmp/fix_pseudo_element_content.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched = raw[0] == "PATCHED=1" if raw else False
      log = [line for line in raw if not line.startswith("PATCHED=")]

      path = os.path.join(repo, "crates/incognidium-layout/src/lib.rs")
      with open(path) as f:
          src = f.read()

      test_old = [
          "    fn test_pseudo_element_attr_content() {",
          "        // ::before/::after content can use attr() to pull text from the originating",
          "        // element. This is a common, standards-compliant pattern used for labels,",
          "        // link annotations, and generated prefixes.",
      ]
      test_new = [
          "    fn test_pseudo_element_content_creates_visual_box() {",
          "        // A ::before pseudo-element whose only visual declaration is generated content",
          "        // must still create a real pseudo box. Otherwise its own font-size, font-family,",
          "        // and other inline styles are ignored and the text is laid out as an anonymous",
          "        // child of the originating element.",
          "        let mut doc = Document::new();",
          "        let html = doc.add_node(0, NodeData::Element(ElementData::new(\"html\")));",
          "        let body = doc.add_node(html, NodeData::Element(ElementData::new(\"body\")));",
          "        let div = doc.add_node(body, NodeData::Element(ElementData::new(\"div\")));",
          "",
          "        let stylesheet = incognidium_css::parse_css(",
          "            \"div::before { content: \\\"x\\\"; font-size: 24px; font-family: monospace; }\"",
          "        );",
          "        let styles = incognidium_style::resolve_styles(&doc, &stylesheet, 1024.0, 768.0);",
          "        let style = styles.get(&div).expect(\"div style\");",
          "        assert!(",
          "            style.before_node_id.is_some(),",
          "            \"content-only ::before should create a visual pseudo-element\"",
          "        );",
          "",
          "        let root = layout(&doc, &styles, 1024.0, 768.0);",
          "        fn collect_text(boxes: &[LayoutBox]) -> Vec<String> {",
          "            let mut out = Vec::new();",
          "            for b in boxes {",
          "                if let Some(ref t) = b.text {",
          "                    out.push(t.clone());",
          "                }",
          "                out.extend(collect_text(&b.children));",
          "            }",
          "            out",
          "        }",
          "        let texts = collect_text(&root.children);",
          "        assert!(",
          "            texts.iter().any(|t| t == \"x\"),",
          "            \"pseudo text should appear: {:?}\",",
          "            texts",
          "        );",
          "    }",
          "",
          "    #[test]",
          "    fn test_pseudo_element_attr_content() {",
          "        // ::before/::after content can use attr() to pull text from the originating",
          "        // element. This is a common, standards-compliant pattern used for labels,",
          "        // link annotations, and generated prefixes.",
      ]

      if not patched:
          log.append("Skipping layout test patch because style patch did not apply.")
      elif "fn test_pseudo_element_content_creates_visual_box" in src:
          log.append("layout test already present")
      else:
          old = "\n".join(test_old)
          new = "\n".join(test_new)
          if old not in src:
              log.append("ERROR: could not find insertion point for layout test")
              patched = False
          else:
              src = src.replace(old, new, 1)
              with open(path, "w") as f:
                  f.write(src)
              log.append("Added layout test")

      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("\n".join(log) + "\n")
      context["patched"] = patched
      context["output"] = "\n".join(log)

  - name: fmt_and_check
    engine: python
    code: |
      import subprocess, os

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      log_file = context.get("log_file", "/tmp/fix_pseudo_element_content.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched = raw[0] == "PATCHED=1" if raw else False
      log = [line for line in raw if not line.startswith("PATCHED=")]

      if not patched:
          msg = "Skipping fmt/check because patch did not apply."
      else:
          r = subprocess.run([cargo, "fmt", "--all"], cwd=repo, capture_output=True, text=True, timeout=120)
          if r.returncode != 0:
              msg = "cargo fmt FAILED:\n" + r.stderr[-500:]
          else:
              r = subprocess.run([cargo, "check", "--all"], cwd=repo, capture_output=True, text=True, timeout=300)
              if r.returncode == 0:
                  msg = "cargo fmt --all OK; cargo check --all OK"
              else:
                  msg = "cargo check --all FAILED:\n" + r.stderr[-500:]
      log.append(msg)
      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("\n".join(log) + "\n")
      context["output"] = "\n".join(log)

  - name: tests
    engine: python
    code: |
      import subprocess, os

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      log_file = context.get("log_file", "/tmp/fix_pseudo_element_content.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched = raw[0] == "PATCHED=1" if raw else False
      log = [line for line in raw if not line.startswith("PATCHED=")]

      if not patched:
          msg = "Skipping tests because patch did not apply."
      else:
          r = subprocess.run(
              [cargo, "test", "--workspace", "--lib", "pseudo_element"],
              cwd=repo, capture_output=True, text=True, timeout=600
          )
          if r.returncode == 0:
              msg = "cargo test --workspace --lib pseudo_element OK"
          else:
              msg = "cargo test --workspace --lib pseudo_element FAILED:\n" + r.stderr[-1000:]
      log.append(msg)
      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("\n".join(log) + "\n")
      context["output"] = "\n".join(log)

  - name: build_and_render
    engine: python
    code: |
      import subprocess, os

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      repro_path = {{ repro_path | tojson }}
      output_name = {{ output_name | tojson }}
      out_png = "/tmp/incognidium_tests/" + output_name + ".png"
      log_file = context.get("log_file", "/tmp/fix_pseudo_element_content.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched = raw[0] == "PATCHED=1" if raw else False
      log = [line for line in raw if not line.startswith("PATCHED=")]

      if not patched:
          msg = "Skipping build/render because patch did not apply."
          render_png = ""
      else:
          r = subprocess.run([cargo, "build", "--release", "--bin", "render_to_png"], cwd=repo, capture_output=True, text=True, timeout=600)
          if r.returncode != 0:
              msg = "Build failed (exit " + str(r.returncode) + "):\n" + r.stderr[-800:]
              render_png = ""
          else:
              binary = os.path.join(repo, "target/release/render_to_png")
              rr = subprocess.run([binary, repro_path, out_png, "--no-js"], cwd=repo, capture_output=True, text=True, timeout=120)
              if rr.returncode != 0:
                  msg = "Render failed (exit " + str(rr.returncode) + "):\n" + rr.stderr[-800:]
                  render_png = ""
              else:
                  msg = "Rendered " + out_png
                  render_png = out_png
      log.append(msg)
      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("\n".join(log) + "\n")
      context["render_png"] = render_png
      context["output"] = "\n".join(log)

  - name: summary
    engine: python
    code: |
      log_file = context.get("log_file", "/tmp/fix_pseudo_element_content.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched = raw[0] == "PATCHED=1" if raw else False
      log = [line for line in raw if not line.startswith("PATCHED=")]
      lines = [
          "=== Steps ===",
      ] + log + [
          "",
          "Fix: content-only ::before/::after pseudo-elements now create a real styled box so generated content respects the pseudo-element's own font-size, font-family, and other inline properties.",
          "Draft commit message: Generate a real visual box for content-only ::before and ::after pseudo-elements so their font-size and font-family declarations apply to generated icons and text.",
          "Render output: " + (context.get("render_png", "") if context.get("render_png", "") else "(not rendered)"),
      ]
      context["output"] = "\n".join(lines)
