#!/usr/bin/env npc
jinx_name: verify_inline_block_wrap
description: |
  Render a generic inline-block fixture and confirm that a smaller-font
  inline-block tag is wrapped to a fresh line below the preceding text, not
  squeezed onto the same line. This checks whitespace gap measurement in the
  inline formatting context, not any site-specific layout.
inputs:
  - fixture: "tests/test_inline_block_smaller_font_wrap.html"

steps:
  - name: render_and_verify
    engine: python
    code: |
      import os
      import sys
      sys.path.insert(0, os.path.join(os.getcwd(), "npc_team", "jinxes", "lib"))
      from render_local import render_local_file

      fixture = {{ fixture | default("tests/test_inline_block_smaller_font_wrap.html") | tojson }}

      repo = os.getcwd()
      fixture_path = fixture if os.path.isabs(fixture) else os.path.join(repo, fixture)
      out_png = "/tmp/verify_inline_block_wrap_incog.png"
      result = render_local_file(fixture_path, out_png, repo=repo)
      if not result["ok"]:
          print(f"FAIL: render_to_png failed for {fixture}")
          print(result.get("stderr", "")[-800:])
          context["output"] = "render failed"
          raise SystemExit(1)

      extracted = " ".join(result["extracted_text"].splitlines())
      for expected in ["Implementation: Refactoring", "tag-one", "domain.here"]:
          if expected not in extracted:
              print(f"FAIL: expected text '{expected}' not found in extracted text")
              context["output"] = f"missing extracted text: {expected}"
              raise SystemExit(1)

      headline_line = next(
          (l for l in result["text_lines"] if "Implementation: Refactoring" in l[4]), None
      )
      tag_line = next(
          (l for l in result["text_lines"] if "tag-one" in l[4]), None
      )
      if not headline_line or not tag_line:
          print("FAIL: expected text lines missing from flat box dump")
          context["output"] = "missing text lines"
          raise SystemExit(1)

      headline_bottom = headline_line[1] + headline_line[3]
      if tag_line[1] > headline_bottom:
          print("PASS: smaller-font inline-block tag rendered on a new line below the headline")
          context["output"] = "PASS: tag-one below headline"
      else:
          print(f"FAIL: tag-one y={tag_line[1]:.1f} overlaps headline bottom={headline_bottom:.1f}")
          context["output"] = "FAIL: tag-one is not below the headline"
          raise SystemExit(1)
