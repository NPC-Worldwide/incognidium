#!/usr/bin/env npc
jinx_name: verify_tiny_svg_thin_x_icon
description: |
  Regression check for tiny external SVG icons rendered through `<img src>`.
  A 32x32 icon with a thin white X on a red background must keep the X
  visible when the raster is downscaled to its displayed size, instead of
  turning into a solid colored square.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_tiny_svg_thin_x.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_tiny_svg_thin_x"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=400)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached screenshot of a small test page. On the left
            side there is a red square icon, followed by text describing it.

            The icon should be a red square with a clearly visible white "X"
            drawn inside it. The X should be made of two thin white diagonal
            lines. A solid red square with no X, or an X so faint that it is
            hard to see, is a failure.

            Is the white X clearly visible inside the red icon? Reply exactly
            "PASS" if yes. If the icon looks like a solid red square or the X
            is too faint, reply exactly "FAIL" and add one short sentence
            describing what you see.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: tiny external SVG icon keeps its thin white X visible")
            context["output"] = "PASS: tiny external SVG icon keeps its thin white X visible"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
