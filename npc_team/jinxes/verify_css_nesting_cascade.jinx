jinx_name: verify_css_nesting_cascade
inputs:
  - api_url: "http://127.0.0.1:11434"

description: |
  Deterministic regression jinx for CSS Nesting: confirm the flattened
  `.nesting-demo .nested` selector actually reaches the style cascade and
  applies `background: #ccffff` to the nested child element.

steps:
  - name: run_unit_tests
    engine: python
    code: |
        import os
        import subprocess
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        repo = os.getcwd()

        cmd = [
            "cargo", "test", "-p", "incognidium-style",
            "test_css_nesting_background_applied_to_descendant",
            "--", "--nocapture",
        ]
        result = subprocess.run(cmd, cwd=repo, capture_output=True, text=True, timeout=300)

        if result.returncode != 0:
            context['output'] = f"FAIL: CSS nesting cascade unit test failed\n{result.stdout}\n{result.stderr}"
            print(context['output'])
            sys.exit(1)

        context['output'] = "PASS: CSS nesting cascade applies #ccffff background to .nesting-demo .nested"
        print(context['output'])
