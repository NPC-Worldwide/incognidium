#!/usr/bin/env npc
jinx_name: verify_marker_spacing
/description: |
  Regression check that outside list item markers keep the generated trailing
  space, so ordered numbers/letters and bullets do not fuse with the following
  list item text.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import re
        import sys

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_marker_spacing.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_marker_spacing"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=800)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        text = incog.get("extracted_text", "")
        lines = [ln for ln in text.splitlines() if ln.strip()]

        # Ordered markers (decimal/alpha/roman) and the circle bullet used in the
        # fixture should be followed by whitespace, not immediately by content.
        marker_patterns = [
            re.compile(r"^(\d+\.)\S"),
            re.compile(r"^([A-Za-z]+\.)\S"),
            re.compile(r"^(◦)\S"),
        ]

        failures = []
        for ln in lines:
            for pat in marker_patterns:
                m = pat.match(ln)
                if m:
                    failures.append(f"fused marker: {ln!r}")
                    break

        if failures:
            msg = "FAIL: " + "; ".join(failures)
            print(msg)
            context["output"] = msg
            raise SystemExit(1)

        print("PASS: list markers keep a visual gap before item text")
        context["output"] = "PASS: list markers keep a visual gap before item text"
