jinx_name: verify_accent_color_inherited
inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

description: |
  Render a local fixture with accent-color set on a parent <label> and verify
  that Incognidium inherits the orange accent onto the nested checkbox.

steps:
  - name: render_and_review
    engine: python
    code: |
        import os
        import shutil
        import subprocess
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"

        from PIL import Image
        from npcpy.llm_funcs import get_llm_response
        from npcpy.npc_compiler import NPC

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        npc = NPC(
            name="verify_accent_color_inherited",
            primary_directive="Compare browser screenshots and judge accent-color inheritance.",
            model=model,
            provider=provider,
        )

        repo = os.getcwd()
        html_path = os.path.join(repo, "tests", "test_accent_color_inherited.html")
        base = "test_accent_color_inherited"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")
        firefox_png = os.path.join(repo, "tests", base + "_firefox.png")
        side_by_side = os.path.join(repo, "tests", base + "_side_by_side.png")

        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        incog = render_local_file(html_path, incog_png, repo=repo)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        profile = f"/tmp/ff_profile_{os.getpid()}"
        shutil.rmtree(profile, ignore_errors=True)
        os.makedirs(profile, exist_ok=True)
        env = os.environ.copy()
        env["MOZ_HEADLESS"] = "1"
        env["MOZ_ENABLE_WAYLAND"] = "0"
        env["WAYLAND_DISPLAY"] = ""
        env["DISPLAY"] = ":0"
        url = "file://" + html_path
        cmd = [
            "timeout", "90", "firefox", "--headless", "--screenshot", firefox_png,
            "--window-size=1024,2000", "--profile", profile, "--no-remote", url,
        ]
        ff = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=120, start_new_session=True)
        if not os.path.exists(firefox_png):
            print("FAIL: Firefox screenshot missing")
            context["output"] = "FAIL: Firefox screenshot missing"
            raise SystemExit(1)

        inc = Image.open(incog_png)
        ff = Image.open(firefox_png)
        h = max(inc.height, ff.height)
        combined = Image.new("RGB", (inc.width + ff.width, h), (255, 255, 255))
        combined.paste(inc, (0, 0))
        combined.paste(ff, (inc.width, 0))
        combined.save(side_by_side)

        prompt = f"""
            This image is split vertically. LEFT is Incognidium, RIGHT is Firefox.
            Both show the same page with two checked checkboxes:
            1. "Inherited orange accent" — the accent-color is set on the parent
               <label>, not on the <input> itself.
            2. "Default accent" — no accent-color is set.

            On the LEFT side, does the first checkbox show an orange fill (or
            orange-tinted checked state), matching the RIGHT side? On both sides,
            the second checkbox should use the browser default (usually blue or
            gray). Only report a failure if the LEFT-side first checkbox is clearly
            using the default blue/gray accent instead of orange.

            Answer with exactly one of these two lines first, then add one short
            sentence explaining your choice:
            - PASS: the LEFT-side inherited-orange checkbox matches the RIGHT.
            - FAIL: the LEFT-side inherited-orange checkbox uses the default accent.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[side_by_side],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["side_by_side"] = side_by_side
        context["incog_png"] = incog_png
        context["firefox_png"] = firefox_png

        if review_text.upper().startswith("PASS"):
            print("PASS: accent-color inherits from a parent label to a checkbox")
            context["output"] = "PASS: accent-color inherits from a parent label to a checkbox"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
