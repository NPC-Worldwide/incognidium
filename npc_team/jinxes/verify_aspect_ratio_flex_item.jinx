#!/usr/bin/env npc
jinx_name: verify_aspect_ratio_flex_item
inputs: []

description: |
  Deterministic regression check that flex items with `aspect-ratio` and a
  definite width get the correct height from their ratio, and that centered
  labels are rendered.

steps:
  - name: render_and_check
    engine: python
    code: |
        import os
        import sys
        import tempfile
        from pathlib import Path

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        test_dir = Path(tempfile.gettempdir()) / "incognidium_aspect_ratio"
        test_dir.mkdir(parents=True, exist_ok=True)
        html_path = test_dir / "aspect_ratio.html"
        png_path = test_dir / "aspect_ratio.png"

        html_path.write_text(
            """<!DOCTYPE html>
            <html>
            <head>
              <meta charset="utf-8">
              <style>
                body { margin: 20px; font-family: sans-serif; background: #f8f9fa; }
                .demo { display: flex; gap: 16px; align-items: flex-start; }
                .box {
                  width: 120px;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  color: #fff;
                  font-weight: bold;
                  border-radius: 6px;
                }
                .wide { aspect-ratio: 16 / 9; background: #667eea; }
                .square { aspect-ratio: 1 / 1; background: #11998e; }
                .ultrawide { aspect-ratio: 21 / 9; background: #fc4a1a; }
              </style>
            </head>
            <body>
              <div class="demo">
                <div class="box wide">16:9</div>
                <div class="box square">1:1</div>
                <div class="box ultrawide">21:9</div>
              </div>
            </body>
            </html>
            """
        )

        info = render_local_file(str(html_path), str(png_path), repo=repo)
        if not info.get("ok"):
            context["output"] = "FAIL: render failed"
            raise SystemExit(1)

        extracted = info.get("extracted_text", "")
        for expected in ["16:9", "1:1", "21:9"]:
            if expected not in extracted:
                context["output"] = f"FAIL: missing label '{expected}'"
                raise SystemExit(1)

        boxes = []
        for node_id, tag, cls, x, y, w, h, img, text in info.get("flat_box_lines", []):
            if tag == "div" and "box" in cls.split():
                boxes.append((cls, w, h))

        if len(boxes) != 3:
            context["output"] = f"FAIL: expected 3 aspect-ratio boxes, found {len(boxes)}"
            raise SystemExit(1)

        by_class = {cls.split()[-1]: (w, h) for cls, w, h in boxes}
        for cls in ("wide", "square", "ultrawide"):
            if cls not in by_class:
                context["output"] = f"FAIL: missing box class '{cls}'"
                raise SystemExit(1)

        wide_w, wide_h = by_class["wide"]
        square_w, square_h = by_class["square"]
        ultra_w, ultra_h = by_class["ultrawide"]

        # All boxes share the same 120px width.
        for cls, (w, h) in (("wide", (wide_w, wide_h)),
                            ("square", (square_w, square_h)),
                            ("ultrawide", (ultra_w, ultra_h))):
            if abs(w - 120.0) > 1.0:
                context["output"] = f"FAIL: {cls} box width {w} is not 120px"
                raise SystemExit(1)

        # Heights must follow the declared ratios.
        if abs(wide_h - 67.5) > 2.0:
            context["output"] = f"FAIL: wide box height {wide_h} is not ~67.5px (16:9)"
            raise SystemExit(1)
        if abs(square_h - 120.0) > 2.0:
            context["output"] = f"FAIL: square box height {square_h} is not ~120px (1:1)"
            raise SystemExit(1)
        if abs(ultra_h - 51.4) > 2.0:
            context["output"] = f"FAIL: ultrawide box height {ultra_h} is not ~51.4px (21:9)"
            raise SystemExit(1)

        # The square box must be the tallest of the three.
        if not (square_h > wide_h and square_h > ultra_h):
            context["output"] = f"FAIL: square box {square_h} is not tallest (wide={wide_h}, ultra={ultra_h})"
            raise SystemExit(1)

        print("PASS: aspect-ratio flex items render with correct proportions and centered labels.")
        print("VERDICT: PASS")
        context["output"] = "PASS: aspect-ratio flex items render with correct proportions and centered labels. VERDICT: PASS"
