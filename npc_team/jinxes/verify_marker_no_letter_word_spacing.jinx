#!/usr/bin/env npc
jinx_name: verify_marker_no_letter_word_spacing
inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

description: |
  CSS ::marker does not support letter-spacing or word-spacing. Render the
  marker-spacing fixture twice — once with the spacing declarations and once
  with them removed — and assert that every marker text box has the same width
  in both renderings.

steps:
  - name: render_and_compare
    engine: python
    code: |
        import os
        import re
        import sys
        import tempfile

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_marker_spacing.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_marker_no_letter_word_spacing"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        html = open(html_path).read()
        # Strip the letter-spacing and word-spacing declarations from ::marker
        # rules so we can compare marker widths with and without them.
        no_spacing_html = re.sub(r"\s*(letter-spacing|word-spacing):\s*[^;]+;", "", html)
        tmp_fd, tmp_html_path = tempfile.mkstemp(suffix=".html", prefix="marker_no_spacing_")
        try:
            with os.fdopen(tmp_fd, "w") as f:
                f.write(no_spacing_html)

            incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=1024)
            if not incog.get("ok"):
                print("FAIL: Incognidium render failed")
                print(incog.get("stderr", ""))
                context["output"] = "FAIL: Incognidium render failed"
                raise SystemExit(1)

            ref_png = os.path.join(repo, "tests", base + "_ref.png")
            ref = render_local_file(tmp_html_path, ref_png, repo=repo, viewport_width=1024)
            if not ref.get("ok"):
                print("FAIL: reference render failed")
                print(ref.get("stderr", ""))
                context["output"] = "FAIL: reference render failed"
                raise SystemExit(1)

            def marker_boxes(render):
                boxes = []
                for node_id, tag, cls, x, y, w, h, img, text in render.get("flat_box_lines", []):
                    if tag == "li" and text:
                        boxes.append((y, text, w))
                boxes.sort(key=lambda b: b[0])
                return boxes

            spaced = marker_boxes(incog)
            plain = marker_boxes(ref)

            if len(spaced) != len(plain):
                print(f"FAIL: marker count mismatch ({len(spaced)} vs {len(plain)})")
                context["output"] = f"FAIL: marker count mismatch ({len(spaced)} vs {len(plain)})"
                raise SystemExit(1)

            tolerance = 1.0
            for (sy, stext, sw), (py, ptext, pw) in zip(spaced, plain):
                if abs(sw - pw) > tolerance:
                    print(f"FAIL: marker {stext!r} width differs with spacing ({sw:.1f}px vs {pw:.1f}px)")
                    context["output"] = f"FAIL: marker {stext!r} width differs with spacing ({sw:.1f}px vs {pw:.1f}px)"
                    raise SystemExit(1)

            print("PASS: ::marker ignores letter-spacing and word-spacing, matching the no-spacing reference")
            context["output"] = "PASS: ::marker ignores letter-spacing and word-spacing, matching the no-spacing reference"
        finally:
            try:
                os.unlink(tmp_html_path)
            except FileNotFoundError:
                pass
