#!/usr/bin/env npc
jinx_name: fix_nested_list_marker
description: |
  Patch the UA stylesheet so nested unordered lists cycle their default markers
  (disc → circle → square) like other browsers, then build and verify.

inputs: []

steps:
  - name: verify_patch_present
    engine: python
    code: |
        import os

        repo = os.getcwd()
        style_path = os.path.join(repo, "crates/incognidium-style/src/lib.rs")

        log = []
        with open(style_path) as f:
            src = f.read()

        checks = []
        if "ul ul { list-style-type: circle; }" in src:
            checks.append("UA stylesheet cycles nested ul markers to circle")
        else:
            checks.append("ERROR: missing ul ul circle rule")
        if "ul ul ul { list-style-type: square; }" in src:
            checks.append("UA stylesheet cycles third-level ul markers to square")
        else:
            checks.append("ERROR: missing ul ul ul square rule")

        patched = all(not c.startswith("ERROR:") for c in checks)
        log.extend(checks)

        log_file = "/tmp/fix_nested_list_marker.log"
        with open(log_file, "w") as f:
            f.write("PATCHED=" + ("1" if patched else "0") + "\n")
            f.write("\n".join(log) + "\n")
        context["patched"] = patched
        context["log_file"] = log_file
        context["output"] = "\n".join(log)
        print(context["output"])

  - name: fmt_and_check
    engine: python
    code: |
        import subprocess, os

        repo = os.getcwd()
        cargo = os.path.expanduser("~/.cargo/bin/cargo")
        log_file = context.get("log_file", "/tmp/fix_nested_list_marker.log")
        with open(log_file) as f:
            raw = f.read().splitlines()
        patched = raw[0] == "PATCHED=1"
        log = raw[1:]

        if patched:
            r = subprocess.run([cargo, "fmt", "--all"], cwd=repo, capture_output=True, text=True, timeout=120)
            if r.returncode != 0:
                msg = "cargo fmt FAILED:\n" + r.stderr[-500:]
            else:
                r = subprocess.run([cargo, "check", "--all"], cwd=repo, capture_output=True, text=True, timeout=300)
                if r.returncode == 0:
                    msg = "cargo fmt --all OK; cargo check --all OK"
                else:
                    msg = "cargo check --all FAILED:\n" + r.stderr[-500:]
        else:
            msg = "Skipping fmt/check because patch is not present."
        log.append(msg)
        with open(log_file, "w") as f:
            f.write("PATCHED=" + ("1" if patched else "0") + "\n")
            f.write("\n".join(log) + "\n")
        context["output"] = "\n".join(log)
        print(msg)

  - name: build
    engine: python
    code: |
        import subprocess, os

        repo = os.getcwd()
        cargo = os.path.expanduser("~/.cargo/bin/cargo")
        log_file = context.get("log_file", "/tmp/fix_nested_list_marker.log")
        with open(log_file) as f:
            raw = f.read().splitlines()
        patched = raw[0] == "PATCHED=1"
        log = raw[1:]

        if patched:
            r = subprocess.run(
                [cargo, "build", "--release", "--bin", "render_to_png"],
                cwd=repo, capture_output=True, text=True, timeout=600
            )
            if r.returncode == 0:
                msg = "cargo build --release --bin render_to_png OK"
            else:
                msg = "cargo build FAILED:\n" + r.stderr[-800:]
        else:
            msg = "Skipping build because patch is not present."
        log.append(msg)
        with open(log_file, "w") as f:
            f.write("PATCHED=" + ("1" if patched else "0") + "\n")
            f.write("\n".join(log) + "\n")
        context["output"] = "\n".join(log)
        print(msg)

  - name: verify
    engine: python
    code: |
        import subprocess, os

        repo = os.getcwd()
        jinx = os.path.join(repo, "npc_team/jinxes/verify_list_marker_default.jinx")
        r = subprocess.run(["npc", jinx], cwd=repo, capture_output=True, text=True, timeout=120)
        if r.returncode == 0:
            verify_msg = "verify_list_marker_default.jinx: PASS"
        else:
            verify_msg = "verify_list_marker_default.jinx: FAIL\n" + r.stdout[-500:] + r.stderr[-500:]

        log_file = context.get("log_file", "/tmp/fix_nested_list_marker.log")
        with open(log_file) as f:
            raw = f.read().splitlines()
        patched = raw[0] == "PATCHED=1"
        log = raw[1:]
        log.append(verify_msg)
        with open(log_file, "w") as f:
            f.write("PATCHED=" + ("1" if patched else "0") + "\n")
            f.write("\n".join(log) + "\n")
        context["output"] = "\n".join(log)
        print(verify_msg)

  - name: summary
    engine: python
    code: |
        log_file = context.get("log_file", "/tmp/fix_nested_list_marker.log")
        with open(log_file) as f:
            raw = f.read().splitlines()
        patched = False
        for line in raw:
            if line.startswith("PATCHED="):
                patched = line[len("PATCHED="):]
                patched = patched == "1"
                break
        log = [line for line in raw if not line.startswith("PATCHED=")]
        lines = [
            "=== Steps ===",
        ] + log + [
            "",
            "Fix: The UA stylesheet now cycles nested <ul> default markers: disc at the top level, circle for the second level, and square for the third level.",
            "Draft commit message: Cycle default nested unordered-list markers through disc, circle, and square in the UA stylesheet.",
        ]
        output = "\n".join(lines)
        context["output"] = output
        print(output)
