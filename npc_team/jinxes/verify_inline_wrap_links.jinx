jinx_name: verify_inline_wrap_links

description: |
  Deterministic regression check that wrapping inline text with inline link
  siblings keeps punctuation and link text in the right order. No pixel metrics
  are used; the assertion is on the text extracted by the renderer.

steps:
  - name: render_and_check
    engine: python
    code: |
        import os, sys, traceback

        try:
            repo = os.getcwd()
            if repo not in sys.path:
                sys.path.insert(0, repo)
            from npc_team.jinxes.lib.render_local import render_local_file

            fixture = os.path.join(repo, "tests", "test_inline_wrap_links.html")
            out_png = os.path.join(repo, "tests", "test_inline_wrap_links_incog.png")
            result = render_local_file(
                fixture,
                out_png,
                repo=repo,
                viewport_width=800,
            )
            if not result.get("ok"):
                context["output"] = f"render failed: {result.get('stderr', '')}"
                print(context["output"])
                raise SystemExit(1)

            text = result.get("extracted_text", "").replace("\n", " ")
            import re
            order_checks = [
                (r"presentation\s*\(\s*CSS\s*\)\s*or", "presentation (CSS) or"),
                (r"behavior\s*\(\s*JavaScript\s*\)", "behavior (JavaScript)"),
            ]
            missing = [label for pattern, label in order_checks if not re.search(pattern, text)]
            if missing:
                context["output"] = f"missing ordered fragments: {missing}\nrendered text:\n{text}"
                print(context["output"])
                raise SystemExit(1)

            context["output"] = "PASS: inline wrap links keep punctuation and link text in order"
            print(context["output"])
        except Exception as e:
            msg = f"ERROR: {e}\n{traceback.format_exc()}"
            context["output"] = msg
            print(msg)
            raise SystemExit(1)
