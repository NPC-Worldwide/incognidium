#!/usr/bin/env npc
jinx_name: verify_button_inline_svg
inputs: []

description: |
  Deterministically verify that flex buttons containing inline SVG icons still
  render their visible labels in the correct order.

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os, sys, tempfile

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_button_inline_svg.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_button_inline_svg"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        if not os.path.exists(html_path):
            tmp_dir = tempfile.mkdtemp(prefix="incognidium_verify_")
            html_path = os.path.join(tmp_dir, fixture)
            incog_png = os.path.join(tmp_dir, base + "_incog.png")
            html = "\n".join([
                "<!DOCTYPE html>",
                "<html>",
                "<head>",
                '<meta charset="UTF-8">',
                "<style>",
                "body { font-family: sans-serif; }",
                ".toolbar { display: flex; gap: 10px; }",
                "button { display: inline-flex; align-items: center; gap: 5px; font-size: 16px; }",
                "</style>",
                "</head>",
                "<body>",
                '<div class="toolbar">',
                "<button>",
                '<svg width="16" height="16" viewBox="0 0 16 16">',
                '<circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="2"/>',
                '<line x1="11" y1="11" x2="15" y2="15" stroke="currentColor" stroke-width="2"/>',
                "</svg>",
                "Search",
                "</button>",
                "<button>",
                '<svg width="16" height="16" viewBox="0 0 16 16">',
                '<circle cx="8" cy="8" r="7" fill="red"/>',
                "</svg>",
                "Watch Live",
                "</button>",
                "</div>",
                "</body>",
                "</html>",
            ])
            with open(html_path, "w") as f:
                f.write(html)

        incog = render_local_file(html_path, incog_png, repo=repo, max_height="300")
        if not incog.get("ok"):
            context['output'] = f"Incognidium render failed for {fixture}"
            raise SystemExit(1)

        lines = incog.get("extracted_text", "").splitlines()
        text = "\n".join(lines)

        if "Search" not in text or "Watch Live" not in text:
            context['output'] = (
                f"FAIL: expected button labels missing from {fixture}.\n"
                f"Extracted text:\n{text}"
            )
            raise SystemExit(1)

        search_idx = text.find("Search")
        live_idx = text.find("Watch Live")
        if not (search_idx < live_idx):
            context['output'] = (
                f"FAIL: button labels are out of order in {fixture}.\n"
                f"Extracted text:\n{text}"
            )
            raise SystemExit(1)

        context['output'] = (
            "PASS: flex buttons with inline SVG icons keep their labels in order"
        )
        print(context['output'])
