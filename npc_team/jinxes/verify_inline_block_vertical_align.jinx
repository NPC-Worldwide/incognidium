jinx_name: verify_inline_block_vertical_align
description: |
  Deterministic regression check that a tall inline-block with
  vertical-align: middle expands the line box to its full height and is
  allowed to extend above the nominal line top (strut-based alignment).
inputs: []
steps:
  - name: run_test
    engine: python
    code: |
      import os
      import subprocess

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")

      result = subprocess.run(
          [
              cargo,
              "test",
              "-p",
              "incognidium-layout",
              "--lib",
              "test_inline_block_vertical_align_middle_grows_line_box",
          ],
          cwd=repo,
          capture_output=True,
          text=True,
          timeout=300,
      )

      if result.returncode == 0:
          output = "PASS: inline-block vertical-align middle keeps line box tall"
          print(output)
      else:
          stderr = result.stderr.strip() if result.stderr else ""
          output = "FAIL: inline-block vertical-align regression test failed\n"
          output += "\n".join(stderr.split("\n")[-40:])
          context["output"] = output
          raise SystemExit(1)

  - name: summary
    engine: python
    code: |
      output = context.get("output", "no result")
