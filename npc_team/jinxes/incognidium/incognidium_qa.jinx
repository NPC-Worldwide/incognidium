#!/usr/bin/env npc
jinx_name: incognidium_qa
inputs:
  - sites_file: "sites.txt"
  - category: ""
  - render_timeout: "120"
  - max_sites: "0"

description: |
  Single-site or batch QA driver. Render each site in Incognidium and Firefox,
  capture dimensions, text extraction, and renderer stderr, and save a structured
  report. Runs serially to avoid overloading the machine. No pixel metrics or
  git commands are used.

steps:
  - name: build
    engine: python
    code: |
      import hashlib, os, subprocess

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      build_commit = hashlib.md5(repo.encode()).hexdigest()[:7]

      build = subprocess.run(
          [cargo, "build", "--release", "--bin", "render_to_png"],
          cwd=repo, capture_output=True, text=True, timeout=600
      )

      if build.returncode != 0:
          err = build.stderr[-2000:] if build.stderr else "unknown error"
          context["build_errors"] = err
          print(f"BUILD FAILED at {build_commit}\n{err}")
          context["output"] = "build failed"
          raise SystemExit(1)

      context["build_commit"] = build_commit
      print(f"Build OK at {build_commit}")

  - name: compare
    engine: python
    code: |
      import os, re, subprocess, json
      from datetime import datetime
      from urllib.parse import urlparse

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      sites_file = {{ sites_file | default("sites.txt") | tojson }}
      category_filter = {{ category | default("") | tojson }}
      render_timeout = int({{ render_timeout | default("120") | tojson }})
      max_sites = int({{ max_sites | default("0") | tojson }})

      sites_path = sites_file if os.path.isabs(sites_file) else os.path.join(repo, sites_file)
      sites = []
      with open(sites_path) as f:
          for line in f:
              line = line.strip()
              if not line or line.startswith("#"):
                  continue
              parts = line.split("|")
              if len(parts) >= 3:
                  sites.append({
                      "name": parts[0].strip(),
                      "url": parts[1].strip(),
                      "category": parts[2].strip()
                  })
      if category_filter:
          sites = [s for s in sites if s["category"] == category_filter]
      if max_sites:
          sites = sites[:max_sites]

      now = datetime.now()
      run_ts = now.strftime("%Y-%m-%d_%H%M%S")
      qa_dir = f"/tmp/incognidium_qa/{run_ts}"
      os.makedirs(f"{qa_dir}/incognidium", exist_ok=True)
      os.makedirs(f"{qa_dir}/firefox", exist_ok=True)

      def run(cmd, **kw):
          try:
              return subprocess.run(cmd, **kw)
          except subprocess.TimeoutExpired:
              return type("R", (), {"returncode": 1, "stderr": "TIMEOUT", "stdout": ""})()
          except Exception as e:
              return type("R", (), {"returncode": 1, "stderr": str(e), "stdout": ""})()

      def extract_links(html):
          hrefs = re.findall(r'href=["\']([^"\']+)["\']', html or "")
          urls = re.findall(r'https?://[^\s<>"\']+', html or "")
          return list(dict.fromkeys(hrefs + urls))

      def extract_imgs(html):
          return re.findall(r'<img[^>]+src=["\']([^"\']+)["\']', html or "", re.IGNORECASE)

      def domain(url):
          return urlparse(url).netloc or url

      report_sites = []

      for i, site in enumerate(sites):
          name, url, cat = site["name"], site["url"], site["category"]
          inc_png = f"{qa_dir}/incognidium/{name}.png"
          ff_png = f"{qa_dir}/firefox/{name}.png"

          inc = run(
              [cargo, "run", "--release", "--bin", "render_to_png", url, inc_png],
              cwd=repo, capture_output=True, text=True, timeout=render_timeout
          )
          inc_ok = inc.returncode == 0 and os.path.exists(inc_png) and os.path.getsize(inc_png) > 500
          inc_stderr = getattr(inc, "stderr", "") or ""
          extracted_text = (getattr(inc, "stdout", "") or "").strip()

          text_boxes = flat_boxes = img_w = img_h = html_bytes = 0
          for line in inc_stderr.split("\n"):
              if "text boxes" in line:
                  try:
                      text_boxes = int(line.split()[0])
                  except Exception:
                      pass
              if "flat boxes" in line:
                  try:
                      flat_boxes = int(line.split()[0])
                  except Exception:
                      pass
              m = re.search(r'Saved to .* \((\d+)x(\d+)\)', line)
              if m:
                  img_w, img_h = int(m.group(1)), int(m.group(2))
              if "bytes of HTML" in line:
                  try:
                      html_bytes = int(line.split()[1])
                  except Exception:
                      pass

          raw_html = ""
          hc = f"{qa_dir}/incognidium/{name}.html"
          if not os.path.exists(hc):
              run(["curl", "-sL", "--max-time", "10", "-o", hc, url], capture_output=True, text=True, timeout=15)
          if os.path.exists(hc):
              try:
                  with open(hc, errors="replace") as f:
                      raw_html = f.read()
              except Exception:
                  pass

          links = extract_links(raw_html or extracted_text)
          imgs = extract_imgs(raw_html)

          ff_ok = False
          tmpdir = run(["mktemp", "-d"], capture_output=True, text=True, timeout=5)
          profile = tmpdir.stdout.strip() if tmpdir.returncode == 0 else ""
          try:
              ff = run(
                  ["firefox", "--headless", "--profile", profile, "--screenshot", ff_png,
                   "--window-size=1024,2000", "--no-remote", url],
                  capture_output=True, text=True, timeout=90
              )
              ff_ok = ff.returncode == 0 and os.path.exists(ff_png) and os.path.getsize(ff_png) > 500
          finally:
              if profile:
                  run(["rm", "-rf", profile], capture_output=True, text=True, timeout=5)

          report_sites.append({
              "name": name,
              "url": url,
              "domain": domain(url),
              "category": cat,
              "text": extracted_text,
              "text_length": len(extracted_text),
              "links": links,
              "link_count": len(links),
              "image_urls": imgs,
              "image_count": len(imgs),
              "html_bytes": html_bytes or len(raw_html),
              "text_boxes": text_boxes,
              "flat_boxes": flat_boxes,
              "render_width": img_w,
              "render_height": img_h,
              "render_ok": inc_ok,
              "firefox_ok": ff_ok
          })
          print(f"  [{i+1}/{len(sites)}] {name:20s} text_boxes={text_boxes:5d} height={img_h:6d} inc_ok={inc_ok} ff_ok={ff_ok}")

      report = {
          "timestamp": now.isoformat(),
          "qa_dir": qa_dir,
          "sites": report_sites
      }
      report_path = f"{qa_dir}/report.json"
      with open(report_path, "w") as f:
          json.dump(report, f, indent=2)

      context["qa_dir"] = qa_dir
      context["report_path"] = report_path
      context["sites_count"] = len(report_sites)
      context["ok_count"] = sum(1 for s in report_sites if s["render_ok"])
      print(f"Report: {report_path}")

  - name: summary
    engine: python
    code: |
      output = f"""QA run at {context.get('build_commit', '?')}
      Sites: {context.get('sites_count', 0)}  OK: {context.get('ok_count', 0)}
      Report: {context.get('report_path', 'N/A')}"""
      print(output)
      context["output"] = output
