#!/usr/bin/env npc
jinx_name: verify_repeating_gradient
description: |
  Regression check that repeating-linear-gradient with pixel color stops is
  rendered as a repeating tile rather than stretched across the whole box.
  Before the fix the 1px guide lines became huge gradient bands that obscured
  text.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_line_height_step.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_line_height_step"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=800)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached Incognidium screenshot of a test page about
            CSS line-height-step. The page has several bordered sections with
            colored horizontal guide lines behind the text.

            The guide lines should be thin, evenly spaced rules similar to a
            baseline grid. They must not be tall blurred gradient bands, and
            they must not overlap or cover the text.

            Reply exactly "PASS" if the guide lines are thin and the text is
            fully readable. Reply exactly "FAIL" if you see large solid or
            gradient bands that hide the text, and add one short sentence
            describing the problem.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: repeating-linear-gradient renders as thin guide lines")
            context["output"] = "PASS: repeating-linear-gradient renders as thin guide lines"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
