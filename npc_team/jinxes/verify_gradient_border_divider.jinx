#!/usr/bin/env npc
jinx_name: verify_gradient_border_divider

description: |
  Regression check for CSS border-image gradients. Renders a generic fixture
  that creates the same striped divider twice: once with
  `border-image: linear-gradient(...)` and once with
  `background: linear-gradient(...)`. A vision model confirms the
  border-image divider is present and visually matches the background
  reference.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_gradient_border_divider.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_gradient_border_divider"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=800)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached screenshot of a small test page with two
            horizontal dividers. The top divider is produced by
            `border-image: linear-gradient(...)`. The bottom divider is
            produced by `background: linear-gradient(...)`. Both dividers
            are expected to look the same: three colored bands of roughly
            equal width, red on the left, black in the middle, and blue on
            the right, with hard edges between the bands (not a smooth
            blend).

            Is the top border-image divider present and visually equivalent
            to the bottom background divider? Reply exactly "PASS" if both
            dividers show the same red-black-blue band pattern. If the top
            divider is missing, blank, the wrong colors, or a different
            pattern, reply exactly "FAIL" and add one short sentence
            describing what you see.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: border-image linear-gradient divider renders and matches the background reference")
            context["output"] = "PASS: border-image linear-gradient divider renders and matches the background reference"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
