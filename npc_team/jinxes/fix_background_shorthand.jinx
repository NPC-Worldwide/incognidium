#!/usr/bin/env npc
jinx_name: fix_background_shorthand
description: |
  Make the CSS `background` shorthand parser consume repeat, position,
  attachment, origin/clip, and size tokens instead of only extracting color
  and image. This fixes cases like `background: color url(...) no-repeat center`
  where `no-repeat` and `center` were silently dropped, leaving the image
  tiled at the default position.
inputs:
  - fixture: "tests/test_svg_bg_path.html"

steps:
  - name: patch_style_background_shorthand
    engine: python
    code: |
      import os

      repo = os.getcwd()
      path = os.path.join(repo, "crates", "incognidium-style", "src", "lib.rs")
      with open(path) as f:
          src = f.read()

      log_file = "/tmp/fix_background_shorthand.log"
      log = []
      patched = True

      bg_start = src.find('"background" => {')
      if bg_start == -1:
          log.append('ERROR: "background" match arm not found')
          patched = False
      else:
          # Look for the next property arm so we only touch the background branch.
          bg_end = src.find('\n        "background-image" => {', bg_start)
          if bg_end == -1:
              bg_end = len(src)
          bg_region = src[bg_start:bg_end]

          list_marker = 'CssValue::List(vals) => {'
          block_start_local = bg_region.find(list_marker)
          if block_start_local == -1:
              if "position_parts: Vec<&CssValue>" in bg_region:
                  log.append("background shorthand block already patched")
              else:
                  log.append("ERROR: background shorthand List block not found")
                  patched = False
          else:
              block_start = bg_start + block_start_local
              # Find the matching closing brace for the `CssValue::List(vals) => {` block.
              brace = src.find('{', block_start)
              depth = 1
              i = brace + 1
              while i < len(src) and depth > 0:
                  if src[i] == '{':
                      depth += 1
                  elif src[i] == '}':
                      depth -= 1
                  i += 1
              old_block = src[block_start:i]
              indent = old_block[:len(old_block) - len(old_block.lstrip())]

              body_lines = [
                  "CssValue::List(vals) => {",
                  "    // Classify each token in the `background` shorthand by type.",
                  "    // The syntax can interleave image, repeat, attachment, position,",
                  "    // size (after a `/`), and color tokens, so we route tokens by",
                  "    // their kind rather than by their position in the list.",
                  "    let mut position_parts: Vec<&CssValue> = Vec::new();",
                  "    let mut size_parts: Vec<&CssValue> = Vec::new();",
                  "    let mut after_slash = false;",
                  "    for v in vals {",
                  "        if let CssValue::Keyword(kw) = v {",
                  "            if kw.eq_ignore_ascii_case(\"/\") {",
                  "                after_slash = true;",
                  "                continue;",
                  "            }",
                  "        }",
                  "        if let Some(c) = try_parse_color(v) {",
                  "            style.background_color = c;",
                  "            continue;",
                  "        }",
                  "        if let Some(img) = parse_single_background_image(",
                  "            v,",
                  "            parent_font_size,",
                  "            viewport_width,",
                  "            viewport_height,",
                  "        ) {",
                  "            style.background_image.push(img);",
                  "            continue;",
                  "        }",
                  "        if let CssValue::Keyword(kw) = v {",
                  "            let lower = kw.to_lowercase();",
                  "            match lower.as_str() {",
                  "                \"repeat\" => {",
                  "                    style.background_repeat = BackgroundRepeat::Repeat;",
                  "                    continue;",
                  "                }",
                  "                \"no-repeat\" => {",
                  "                    style.background_repeat = BackgroundRepeat::NoRepeat;",
                  "                    continue;",
                  "                }",
                  "                \"repeat-x\" => {",
                  "                    style.background_repeat = BackgroundRepeat::RepeatX;",
                  "                    continue;",
                  "                }",
                  "                \"repeat-y\" => {",
                  "                    style.background_repeat = BackgroundRepeat::RepeatY;",
                  "                    continue;",
                  "                }",
                  "                \"space\" => {",
                  "                    style.background_repeat = BackgroundRepeat::Space;",
                  "                    continue;",
                  "                }",
                  "                \"round\" => {",
                  "                    style.background_repeat = BackgroundRepeat::Round;",
                  "                    continue;",
                  "                }",
                  "                \"scroll\" => {",
                  "                    style.background_attachment = BackgroundAttachment::Scroll;",
                  "                    continue;",
                  "                }",
                  "                \"fixed\" => {",
                  "                    style.background_attachment = BackgroundAttachment::Fixed;",
                  "                    continue;",
                  "                }",
                  "                \"local\" => {",
                  "                    style.background_attachment = BackgroundAttachment::Local;",
                  "                    continue;",
                  "                }",
                  "                \"border-box\" => {",
                  "                    style.background_origin = BackgroundOrigin::BorderBox;",
                  "                    continue;",
                  "                }",
                  "                \"padding-box\" => {",
                  "                    style.background_origin = BackgroundOrigin::PaddingBox;",
                  "                    continue;",
                  "                }",
                  "                \"content-box\" => {",
                  "                    style.background_origin = BackgroundOrigin::ContentBox;",
                  "                    continue;",
                  "                }",
                  "                \"text\" => {",
                  "                    style.background_clip = BackgroundClip::Text;",
                  "                    continue;",
                  "                }",
                  "                _ => {}",
                  "            }",
                  "        }",
                  "        if after_slash {",
                  "            size_parts.push(v);",
                  "        } else {",
                  "            position_parts.push(v);",
                  "        }",
                  "    }",
                  "    if !position_parts.is_empty() {",
                  "        if position_parts.len() >= 2 {",
                  "            style.background_position = (",
                  "                parse_position_value(position_parts.get(0).copied(), 0.5),",
                  "                parse_position_value(position_parts.get(1).copied(), 0.5),",
                  "            );",
                  "        } else if let CssValue::Keyword(kw) = position_parts[0] {",
                  "            let (x, y) = match kw.as_str() {",
                  "                \"top\" => (0.5, 0.0),",
                  "                \"right\" => (1.0, 0.5),",
                  "                \"bottom\" => (0.5, 1.0),",
                  "                \"left\" => (0.0, 0.5),",
                  "                \"center\" => (0.5, 0.5),",
                  "                \"top left\" | \"left top\" => (0.0, 0.0),",
                  "                \"top right\" | \"right top\" => (1.0, 0.0),",
                  "                \"bottom left\" | \"left bottom\" => (0.0, 1.0),",
                  "                \"bottom right\" | \"right bottom\" => (1.0, 1.0),",
                  "                _ => (0.5, 0.5),",
                  "            };",
                  "            style.background_position = (x, y);",
                  "        } else {",
                  "            style.background_position = (",
                  "                parse_position_value(Some(position_parts[0]), 0.5),",
                  "                0.5,",
                  "            );",
                  "        }",
                  "    }",
                  "    if !size_parts.is_empty() {",
                  "        if size_parts.len() == 1 {",
                  "            if let Some(w) = background_size_to_px(",
                  "                size_parts[0],",
                  "                parent_font_size,",
                  "                viewport_width,",
                  "                container_width,",
                  "            ) {",
                  "                style.background_size = BackgroundSize::Length(w, 0.0);",
                  "            }",
                  "        } else {",
                  "            let w = background_size_to_px(",
                  "                size_parts[0],",
                  "                parent_font_size,",
                  "                viewport_width,",
                  "                container_width,",
                  "            )",
                  "            .unwrap_or(0.0);",
                  "            let h = background_size_to_px(",
                  "                size_parts[1],",
                  "                parent_font_size,",
                  "                viewport_width,",
                  "                container_height,",
                  "            )",
                  "            .unwrap_or(0.0);",
                  "            style.background_size = BackgroundSize::Length(w, h);",
                  "        }",
                  "    }",
                  "}",
              ]
              body = "\n".join(body_lines)
              new_block = indent + body.replace("\n", "\n" + indent)
              src = src[:block_start] + new_block + src[i:]
              log.append("Patched background shorthand parser in " + path)

      if patched:
          with open(path, "w") as f:
              f.write(src)

      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("\n".join(log) + "\n")
      context["patched"] = patched
      context["log_file"] = log_file
      context["output"] = "\n".join(log)

  - name: fmt_and_check
    engine: python
    code: |
      import subprocess, os

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      log_file = context.get("log_file", "/tmp/fix_background_shorthand.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched = raw[0] == "PATCHED=1" if raw else False
      log = [line for line in raw if not line.startswith("PATCHED=")]

      if not patched:
          msg = "Skipping fmt/check because patch did not apply."
      else:
          r = subprocess.run([cargo, "fmt", "--all"], cwd=repo, capture_output=True, text=True, timeout=120)
          if r.returncode != 0:
              msg = "cargo fmt FAILED:\n" + r.stderr[-500:]
          else:
              r = subprocess.run([cargo, "check", "--all"], cwd=repo, capture_output=True, text=True, timeout=300)
              if r.returncode == 0:
                  msg = "cargo fmt --all OK; cargo check --all OK"
              else:
                  msg = "cargo check --all FAILED:\n" + r.stderr[-500:]
      log.append(msg)
      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("\n".join(log) + "\n")
      context["output"] = "\n".join(log)

  - name: build_release
    engine: python
    code: |
      import subprocess, os

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      log_file = context.get("log_file", "/tmp/fix_background_shorthand.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched = raw[0] == "PATCHED=1" if raw else False
      log = [line for line in raw if not line.startswith("PATCHED=")]

      if not patched:
          msg = "Skipping build because patch did not apply."
      else:
          r = subprocess.run([cargo, "build", "--release"], cwd=repo, capture_output=True, text=True, timeout=600)
          if r.returncode == 0:
              msg = "cargo build --release OK"
          else:
              msg = "cargo build --release FAILED:\n" + r.stderr[-800:]
      log.append(msg)
      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("\n".join(log) + "\n")
      context["output"] = "\n".join(log)

  - name: summary
    engine: python
    code: |
      log_file = context.get("log_file", "/tmp/fix_background_shorthand.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched = raw[0] == "PATCHED=1" if raw else False
      log = [line for line in raw if not line.startswith("PATCHED=")]
      lines = [
          "=== Steps ===",
      ] + log + [
          "",
          "Fix: the CSS `background` shorthand parser now recognizes repeat, position, attachment, origin/clip, and slash-separated size tokens instead of only extracting color and image.",
          "Draft commit message: Parse repeat, position, attachment, origin, clip, and size tokens from the CSS background shorthand so values like no-repeat and center are honored.",
      ]
      context["output"] = "\n".join(lines)
