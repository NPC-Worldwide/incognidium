jinx_name: verify_abs_positioning
description: |
  Deterministic regression checks for two absolutely-positioned layout fixes:
  1) positioned subtrees are painted as contiguous units so their text children
     are not covered by the positioned background, and
  2) blockified absolutely-positioned inline boxes get a shrink-to-fit width so
  `overflow:hidden` does not clip wrapped text.
inputs: []
steps:
  - name: setup
    engine: python
    code: |
      import os

      test_dir = "/tmp/incognidium_abs_positioning"
      os.makedirs(test_dir, exist_ok=True)

      bubble_html = os.path.join(test_dir, "bubble.html")
      byline_html = os.path.join(test_dir, "byline.html")

      with open(bubble_html, "w") as f:
          f.write("""<!DOCTYPE html>
          <html>
          <head>
            <meta charset="utf-8">
            <style>
              body { margin: 0; padding: 20px; font-family: sans-serif; background: #fff; }
              .wrap { position: relative; width: 300px; height: 80px; background: #eee; }
              .static { width: 300px; height: 80px; background: #ccc; line-height: 80px; text-align: center; }
              .bubble { position: absolute; left: 0; top: 0; padding: 4px 10px; background: #222; color: #fff; border-radius: 4px; font-size: 14px; }
            </style>
          </head>
          <body>
            <div class="wrap">
              <div class="static">static cover</div>
              <div class="bubble">123 comments</div>
            </div>
          </body>
          </html>
          """)

      with open(byline_html, "w") as f:
          f.write("""<!DOCTYPE html>
          <html>
          <head>
            <meta charset="utf-8">
            <style>
              body { margin: 0; padding: 20px; font-family: sans-serif; background: #fff; }
              .card { position: relative; width: 400px; height: 60px; background: #f5f5f5; overflow: hidden; }
              .byline { position: absolute; left: 0; top: 10px; color: #000; font-size: 14px; overflow: hidden; white-space: normal; }
            </style>
          </head>
          <body>
            <div class="card">
              <span class="byline">This long byline text should remain visible</span>
            </div>
          </body>
          </html>
          """)

      output = f"Wrote repro fixtures in {test_dir}"

  - name: render_and_check
    engine: python
    code: |
      import os, sys

      repo = os.getcwd()
      if repo not in sys.path:
          sys.path.insert(0, repo)
      from npc_team.jinxes.lib.render_local import render_local_file

      test_dir = "/tmp/incognidium_abs_positioning"
      bubble_html = os.path.join(test_dir, "bubble.html")
      byline_html = os.path.join(test_dir, "byline.html")
      bubble_png = os.path.join(test_dir, "bubble.png")
      byline_png = os.path.join(test_dir, "byline.png")

      bubble = render_local_file(bubble_html, bubble_png, repo=repo)
      byline = render_local_file(byline_html, byline_png, repo=repo)

      failures = []

      if not bubble.get("ok"):
          failures.append("bubble render failed")
      else:
          texts = [line[4] for line in bubble.get("text_lines", [])]
          if "123 comments" not in texts:
              failures.append("bubble text '123 comments' missing from render")
          # The bubble text box should be visible above the static cover.
          # In the broken state the text box is painted first and then covered.
          bubble_line = next((l for l in bubble.get("text_lines", []) if l[4] == "123 comments"), None)
          if bubble_line and bubble_line[1] <= 0:
              failures.append("bubble text box has unexpected y position")

      if not byline.get("ok"):
          failures.append("byline render failed")
      else:
          texts = [line[4] for line in byline.get("text_lines", [])]
          full = " ".join(texts)
          if "This long byline text should remain visible" not in full:
              failures.append("byline text truncated or missing")
          # Without the shrink-to-fit fix the byline wraps to two lines (~33.6px).
          # With the fix it is a single line (~16.8px).
          byline_line = next((l for l in byline.get("text_lines", []) if "byline" in l[4]), None)
          if byline_line and byline_line[3] > 25.0:
              failures.append("byline text wrapped/clipped (height too large)")

      if failures:
          output = "FAIL\n" + "\n".join(failures)
          context['output'] = output
          raise SystemExit(1)
      else:
          output = "PASS: absolute positioned subtrees paint contiguously and inline boxes shrink-to-fit"
          context['output'] = output
