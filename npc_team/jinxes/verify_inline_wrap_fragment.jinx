jinx_name: verify_inline_wrap_fragment

description: |
  Deterministic regression check that a wrapping inline text node renders every
  word after an inline sibling. No pixel metrics are used; the assertion is on
  the text extracted by the renderer.

steps:
  - name: render_and_check
    engine: python
    code: |
        import os, sys, traceback

        try:
            repo = os.getcwd()
            if repo not in sys.path:
                sys.path.insert(0, repo)
            from npc_team.jinxes.lib.render_local import render_local_file

            fixture = os.path.join(repo, "tests", "test_inline_wrap_fragment.html")
            out_png = os.path.join(repo, "tests", "test_inline_wrap_fragment_incog.png")
            result = render_local_file(
                fixture,
                out_png,
                repo=repo,
                viewport_width=800,
            )
            if not result.get("ok"):
                context["output"] = f"render failed: {result.get('stderr', '')}"
                print(context["output"])
                raise SystemExit(1)

            text = result.get("extracted_text", "").replace("\n", " ")
            checks = [
                "Alpha (the first Greek letter) is the most basic building block of the sample.",
                "It defines the meaning and structure of sample content.",
                "Other features besides alpha are generally used to describe presentation (style) or functionality (scripts).",
            ]
            missing = [phrase for phrase in checks if phrase not in text]
            if missing:
                context["output"] = f"missing text fragments: {missing}\nrendered text:\n{text}"
                print(context["output"])
                raise SystemExit(1)

            context["output"] = "PASS: inline wrap fragment preserves every word"
            print(context["output"])
        except Exception as e:
            msg = f"ERROR: {e}\n{traceback.format_exc()}"
            context["output"] = msg
            print(msg)
            raise SystemExit(1)
