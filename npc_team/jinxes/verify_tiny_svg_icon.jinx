#!/usr/bin/env npc
jinx_name: verify_tiny_svg_icon
description: |
  Regression check for tiny SVG icon rasterization. A 18x18 SVG icon with a
  colored background and thin white strokes must keep its white content visible
  when rendered on a matching colored background, instead of washing the strokes
  out into the background color.

  The jinx asks a vision model whether the icon shows a distinct white symbol
  inside the colored square. This avoids relying on exact pixel values.
inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_tiny_svg_generic_y.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_tiny_svg_generic_y"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=400)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached screenshot of a small test page. There is an
            orange header bar at the top containing a small square icon on the
            left, followed by the text "Generic Site".

            The icon should be an orange square with a thin white border and a
            white "Y"-shaped mark inside it. The white Y should be clearly visible
            against the orange background, not washed out, faded, or invisible.

            Is the white Y clearly visible inside the orange icon? Reply exactly
            "PASS" if yes. If the icon looks like an empty white-bordered square,
            or the Y is so faint that it is hard to see, reply exactly "FAIL" and
            add one short sentence describing what you see.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: tiny SVG icon keeps its white strokes visible on a colored background")
            context["output"] = "PASS: tiny SVG icon keeps its white strokes visible on a colored background"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
