#!/usr/bin/env npc
jinx_name: incognidium_fix
description: Apply fixes based on the most recent local QA report
inputs: []

steps:
  - name: load_and_fix
    engine: python
    code: |
      import subprocess, json, os, glob
      from datetime import datetime

      repo = "/home/caug/incognidium"

      # Find today's QA run data
      today = datetime.now().strftime("%Y-%m-%d")
      qa_dir = f"/tmp/incognidium_qa/{today}"

      problems = []

      if not os.path.exists(qa_dir):
          output = f"No QA data found for {today}"
          context["fixed"] = []
          context["failed"] = []
      else:
          report_files = glob.glob(f"{qa_dir}/*/report.json")
          if not report_files:
              report_files = glob.glob(f"{qa_dir}/report.json")

          for rf in sorted(report_files, reverse=True):
              try:
                  with open(rf) as f:
                      report = json.load(f)
                  for site in report.get("sites", []):
                      if not site.get("render_ok"):
                          problems.append({
                              "site": site["name"],
                              "url": site["url"],
                              "category": site["category"],
                              "problem": "render_failed"
                          })
                      elif site.get("text_length", 0) == 0 and site.get("text_boxes", 0) < 3:
                          problems.append({
                              "site": site["name"],
                              "url": site["url"],
                              "category": site["category"],
                              "problem": "empty_or_missing_text"
                          })
                      elif not site.get("firefox_ok"):
                          problems.append({
                              "site": site["name"],
                              "url": site["url"],
                              "category": site["category"],
                              "problem": "firefox_reference_failed"
                          })
              except Exception as e:
                  continue

          if not problems:
              output = f"No fixable issues found in today's QA runs."
              context["fixed"] = []
              context["failed"] = []
          else:
              recent = subprocess.run(
                  ["git", "log", "--oneline", "-5"],
                  cwd=repo, capture_output=True, text=True
              ).stdout

              issues_str = json.dumps(problems[:10], indent=2)
              codebase = """
              crates/incognidium-layout: layout engine, box sizing, width calculations
              crates/incognidium-css: CSS parsing
              crates/incognidium-style: style resolution, computed styles
              crates/incognidium-paint: text rendering, colors
              crates/incognidium-shell: JS bindings, browser shell, render_to_png
              crates/incognidium-dom: DOM tree, node types
              crates/incognidium-html: HTML parser
              crates/incognidium-net: networking, URL resolution
              """
              prompt = f"""
              Fix incognidium browser engine issues. Repo at {repo}.

              Recent changes:
              {recent}

              Problems from latest QA run:
              {issues_str}

              Codebase structure:
              {codebase}

              Fix the rendering issues. Use edit_file to make changes.
              After each edit, run cargo_check to verify the build.
              Focus on the top 1-2 problems. Make small, safe Rust code changes.
              Return stop when done.
              """.strip()

              context["fix_prompt"] = prompt
              context["skip_fix"] = False
              output = f"Setup done. {len(problems[:10])} problems queued for the agent."

  - name: fix
    engine: agent
    query: "{{ fix_prompt }}"

  - name: fix_results
    engine: python
    code: |
      import subprocess

      repo = "/home/caug/incognidium"
      if context.get("skip_fix"):
          context["fixed"] = []
          context["failed"] = []
          output = "No issues to fix."
      else:
          status = subprocess.run(["git", "status", "--porcelain"], cwd=repo, capture_output=True, text=True)
          modified = [line[3:] for line in status.stdout.strip().split("\n") if line.startswith(" M ")]
          context["fixed"] = modified
          context["failed"] = []
          output = f"Agent done. Modified {len(modified)} files."

  - name: summary
    engine: python
    code: |
      output = f"""Fix Pipeline Run
      Load: {context.get('load_and_fix', 'N/A')}
      Fix: {context.get('fix', 'N/A')}
      Modified files: {context.get('fixed', [])}
      Failed: {context.get('failed', [])}"""
