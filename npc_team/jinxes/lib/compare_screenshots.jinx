jinx_name: compare_screenshots
description: Ask a vision-capable LLM to compare two screenshots and describe precise qualitative differences. No numeric pixel metrics.
inputs:
  - first_png
  - second_png
  - first_label
  - second_label
  - model: "qwen3.5:9b"
  - provider: "ollama"
steps:
  - name: compare
    engine: python
    code: |
      import os
      from PIL import Image
      from npcpy.llm_funcs import get_llm_response

      os.environ.setdefault("OLLAMA_HOST", "http://127.0.0.1:11434")

      first = {{ first_png | tojson }}
      second = {{ second_png | tojson }}
      first_label = {{ first_label | tojson }}
      second_label = {{ second_label | tojson }}
      model = {{ model | default("qwen3.5:9b") | tojson }}
      provider = {{ provider | default("ollama") | tojson }}

      def prepare_image(path, max_width=1024, max_height=1400):
          if not os.path.exists(path):
              return path
          img = Image.open(path)
          # Convert palette images to RGB so JPEG/PNG resizes work consistently.
          if img.mode in ("P", "LA", "L"):
              img = img.convert("RGB")
          w, h = img.size
          scale = min(max_width / max(w, 1), max_height / max(h, 1), 1.0)
          if scale < 1.0:
              new_size = (int(w * scale), int(h * scale))
              img = img.resize(new_size, Image.Resampling.LANCZOS)
          base, _ = os.path.splitext(path)
          out_path = f"{base}_compare.jpg"
          img = img.convert("RGB")
          img.save(out_path, "JPEG", quality=85)
          return out_path

      first_compare = prepare_image(first)
      second_compare = prepare_image(second)

      prompt = f"""
        Compare the two attached browser screenshots.

        The first image is {first_label}.
        The second image is {second_label}.

        Describe the visual differences precisely. Focus on:
        - Missing or wrong colors, backgrounds, or decorative elements
        - Layout misalignment, spacing, overflow, or overlapping text
        - Missing or different content
        - Font weight, size, or rasterization differences that affect usability

        Do not report pixel counts, percentages, RMSE, or any numeric image metrics.
        Keep the review concise (3-5 bullet points if possible).
        At the end, state either PASS or FAIL and one short sentence explaining why.
      """

      response = get_llm_response(
          prompt,
          model=model,
          provider=provider,
          api_url="http://127.0.0.1:11434",
          images=[first_compare, second_compare],
          npc=npc,
          temperature=0.3,
          timeout=300,
      )
      review = response.get("response", "")
      if review is None:
          review = ""
      if isinstance(review, dict):
          import json
          review = json.dumps(review)

      context["comparison_review"] = review
      context["output"] = review
      print(review)
