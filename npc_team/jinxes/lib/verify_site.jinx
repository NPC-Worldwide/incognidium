jinx_name: verify_site
description: Render a URL, review the screenshot with a vision LLM, and run cargo check. Reusable verification building block for the 2026-09 news-site suite.
inputs:
  - url
  - expected_site
  - out_png
  - max_height: "1200"
  - model: "kimi-k2.7-code:cloud"
  - provider: "ollama"
steps:
  - name: verify
    engine: python
    code: |
      from npc_team.jinxes.lib.verify_site import verify_site

      result = verify_site(
          url={{ url | tojson }},
          expected_site={{ expected_site | tojson }},
          out_png={{ out_png | tojson }},
          max_height={{ max_height | default("1200") | tojson }},
          model={{ model | default("kimi-k2.7-code:cloud") | tojson }},
          provider={{ provider | default("ollama") | tojson }},
      )
      print(result)
