#!/usr/bin/env npc
jinx_name: verify_flex_column_wrap_fit_content
description: |
  Regression check that a column flex container with `align-items: start` and
  auto width hugs its content in the cross axis, so the container background
  does not protrude past the flex item.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_review
    engine: python
    code: |
        import os
        import sys

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_flex_column_wrap_fit_content.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_flex_column_wrap_fit_content"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=412)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            print(incog.get("stderr", ""))
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        extracted = incog.get("extracted_text", "")
        # Wrap boundaries can split the expected phrase across lines; collapse
        # whitespace before checking for the substring.
        normalized = " ".join(extracted.split())
        expected_fragment = "because it is the first section."
        if expected_fragment not in normalized:
            print("FAIL: full text is not visible in extracted output")
            print("extracted:", repr(extracted))
            context["output"] = "FAIL: full text is not visible in extracted output"
            raise SystemExit(1)

        # Deterministic check: the lavender container should be no wider than the
        # pink box. If the box widths agree, we do not need a vision-LLM review.
        flat = incog.get("flat_box_lines", [])
        container_width = None
        box_width = None
        for node_id, tag, cls, x, y, w, h, img, text in flat:
            if cls == "container":
                container_width = w
            if cls == "box":
                box_width = w
        if container_width is None or box_width is None:
            print("FAIL: could not find container or box width")
            context["output"] = "FAIL: could not find container or box width"
            raise SystemExit(1)
        if container_width <= box_width + 1.0:
            print("PASS: column flex container hugs its content in the cross axis")
            context["output"] = "PASS: column flex container hugs its content in the cross axis"
            raise SystemExit(0)

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = """
        Review the attached screenshot of a single-column flex container test.
        The container has a pale blue/lavender background (#eeeeff) and holds
        one pink summary box (#ffeeee). The desired behavior is that the
        lavender container background is no wider than the pink box; it should
        hug the content without a visible strip extending past the right edge
        of the pink box.

        Only report a FAIL if you can see a lavender strip protruding to the
        right of the pink box. If the container and the pink box share the
        same right edge, report PASS.

        End with exactly one line:
        VERDICT: PASS
        or
        VERDICT: FAIL

        Put the verdict line at the very end of your reply, alone on its own
        line, so it can be parsed unambiguously.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            temperature=0.2,
            timeout=300,
        )
        review = str(response.get("response", "")).strip()
        last_line = review.splitlines()[-1].upper() if review else ""
        if "VERDICT: PASS" in last_line:
            print("PASS: column flex container hugs its content in the cross axis")
            context["output"] = "PASS: column flex container hugs its content in the cross axis"
        else:
            print(f"FAIL: visual review reported an issue\n{review}")
            context["output"] = f"FAIL: visual review reported an issue\n{review}"
            raise SystemExit(1)
