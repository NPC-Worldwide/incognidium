#!/usr/bin/env npc
jinx_name: verify_float_clear_wrap

description: |
  Regression check for block content wrapping around an earlier float after a
  cleared float. A right float followed by a `clear: right` right float should
  not force the next block-level paragraph to start below the whole float stack;
  the paragraph must still wrap around the first (non-cleared) float.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_review
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_float_clear_wrap.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_float_clear_wrap"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=700)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached screenshot of a small test page.

            The page has a heading at the top, two gray boxes floated to the
            right, and a paragraph of text starting with "Lorem ipsum" on the
            left.

            The top gray box says "First right float". The lower gray box says
            "Second right float with clear:right". The cleared float is placed
            below the first float on the right side.

            The paragraph must wrap on the left side of the first float and
            continue upward than the lower cleared float. In other words, the
            first line of the paragraph should be vertically between the two gray
            boxes, not entirely below the lower gray box.

            Does the paragraph text start above the lower "clear:right" box
            while wrapping beside the top float? Reply exactly "PASS" if yes.
            Reply exactly "FAIL" if the paragraph is pushed completely below
            the lower gray box, and add one short sentence describing what you
            see.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: block content wraps around an earlier float after a cleared float")
            context["output"] = "PASS: block content wraps around an earlier float after a cleared float"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
