#!/usr/bin/env npc
jinx_name: verify_uppercase_byline_space

description: |
  Regression check that two adjacent uppercase inline text siblings render with
  a preserved visual space. The fixture uses default word-spacing; layout must
  keep the second text box after the first so the words do not visually merge.
  Assertions use the renderer's extracted text and flat box list, not pixel
  metrics or a specific log line.

inputs: []
steps:
  - name: render_fixture
    engine: python
    code: |
      import os, sys

      repo = os.getcwd()
      if repo not in sys.path:
          sys.path.insert(0, repo)
      from npc_team.jinxes.lib.render_local import render_local_file

      fixture = os.path.join(repo, "tests", "test_uppercase_byline2.html")
      png = "/tmp/verify_uppercase_byline_space.png"
      render = render_local_file(fixture, png, repo=repo, dump_boxes="flat")
      failures = []

      if not render.get("ok"):
          failures.append("fixture render failed")
      else:
          text = render.get("extracted_text", "")
          if "BY" not in text or "JANE" not in text or "DOE" not in text:
              failures.append("fixture did not render the uppercase byline text")
          if text.replace(" ", "") != "BYJANEDOE":
              failures.append(
                  "extracted text lost the visual space between adjacent uppercase inline spans"
              )

          texts = [
              (x, w, text)
              for _node_id, _tag, _class, x, _y, w, _h, _image_src, text in render.get("flat_box_lines", [])
              if text.strip()
          ]
          if len(texts) < 2:
              failures.append(f"expected two text boxes, got {len(texts)}")
          else:
              texts.sort(key=lambda t: t[0])
              first = texts[0]
              second = texts[1]
              if second[0] < first[0] + first[1] - 0.5:
                  failures.append(
                      f"uppercase byline text boxes overlap (first ends at {first[0]+first[1]:.1f}, "
                      f"second starts at {second[0]:.1f})"
                  )

      if failures:
          context['output'] = "FAIL\n" + "\n".join(failures)
          print(context['output'])
          raise SystemExit(1)
      else:
          context['output'] = "PASS: adjacent uppercase inline text boxes kept a visual space"
          print(context['output'])
