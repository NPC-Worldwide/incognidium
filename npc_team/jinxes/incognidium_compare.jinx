#!/usr/bin/env npc
jinx_name: incognidium_compare
description: Render sites with Incognidium and Firefox, extract text/links/images, and save a local comparison report.
inputs:
  - max_sites
  - categories

steps:
  - name: render_and_compare
    engine: python
    code: |
      import subprocess, os, json, hashlib, re
      from datetime import datetime

      max_sites = int({{ max_sites | default(50) | tojson }})
      filter_cats = {{ categories | default('') | tojson }}.strip()
      filter_cats = [c.strip() for c in filter_cats.split(",")] if filter_cats else []

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")

      now = datetime.now()
      date_str = now.strftime("%Y-%m-%d")
      qa_dir = f"/tmp/incognidium_qa/{date_str}"
      os.makedirs(f"{qa_dir}/incognidium", exist_ok=True)
      os.makedirs(f"{qa_dir}/firefox", exist_ok=True)

      # Parse sites.txt
      sites = []
      with open(f"{repo}/sites.txt") as f:
          for line in f:
              line = line.strip()
              if not line or line.startswith("#"):
                  continue
              parts = line.split("|")
              if len(parts) == 3:
                  name, url, cat = parts[0].strip(), parts[1].strip(), parts[2].strip()
                  if filter_cats and cat not in filter_cats:
                      continue
                  sites.append({"name": name, "url": url, "category": cat})

      sites = sites[:max_sites]
      issues = []

      col_timestamp = []
      col_date = []
      col_site_name = []
      col_url = []
      col_domain = []
      col_category = []
      col_extracted_text = []
      col_text_length = []
      col_content_hash = []
      col_links = []
      col_link_count = []
      col_image_urls = []
      col_image_count = []
      col_html_bytes = []
      col_css_bytes = []
      col_dom_nodes = []
      col_text_boxes = []
      col_flat_boxes = []
      col_render_width = []
      col_render_height = []
      col_render_ok = []
      col_firefox_ok = []
      col_inc_path = []
      col_ff_path = []

      def run_render(cmd, **kw):
          try:
              return subprocess.run(cmd, **kw)
          except subprocess.TimeoutExpired:
              return type("R", (), {"returncode": 1, "stderr": "TIMEOUT", "stdout": ""})()
          except Exception as e:
              return type("R", (), {"returncode": 1, "stderr": str(e), "stdout": ""})()

      def extract_links(html):
          hrefs = re.findall(r'href=["\']([^"\']+)["\']', html or "")
          urls = re.findall(r'https?://[^\s<>"\']+', html or "")
          return list(dict.fromkeys(hrefs + urls))

      def extract_imgs(html):
          return re.findall(r'<img[^>]+src=["\']([^"\']+)["\']', html or "", re.IGNORECASE)

      for i, site in enumerate(sites):
          name, url, cat = site["name"], site["url"], site["category"]
          inc_png = f"{qa_dir}/incognidium/{name}.png"
          ff_png = f"{qa_dir}/firefox/{name}.png"

          inc = run_render(
              [cargo, "run", "--release", "--bin", "render_to_png", url, inc_png],
              cwd=repo, capture_output=True, text=True, timeout=60
          )
          inc_ok = inc.returncode == 0 and os.path.exists(inc_png) and os.path.getsize(inc_png) > 500
          inc_stderr = getattr(inc, "stderr", "") or ""
          extracted_text = (getattr(inc, "stdout", "") or "").strip()

          text_boxes = flat_boxes = css_bytes = dom_nodes = img_w = img_h = html_bytes = 0
          for line in inc_stderr.split("\n"):
              if "text boxes" in line:
                  try:
                      text_boxes = int(line.split()[0])
                  except:
                      pass
              if "flat boxes" in line:
                  try:
                      flat_boxes = int(line.split()[0])
                  except:
                      pass
              if "CSS:" in line and "external" in line:
                  try:
                      css_bytes = int(line.split()[1])
                  except:
                      pass
              if "DOM:" in line:
                  try:
                      dom_nodes = int(line.split()[1])
                  except:
                      pass
              m = re.search(r'(\d+)x(\d+)', line)
              if m and "Saved" in line:
                  img_w, img_h = int(m.group(1)), int(m.group(2))
              if "bytes of HTML" in line:
                  try:
                      html_bytes = int(line.split()[1])
                  except:
                      pass

          raw_html = ""
          hc = f"{qa_dir}/incognidium/{name}.html"
          if not os.path.exists(hc):
              run_render(["curl", "-sL", "--max-time", "10", "-o", hc, url], capture_output=True, text=True, timeout=15)
          if os.path.exists(hc):
              try:
                  with open(hc, errors="replace") as f:
                      raw_html = f.read()
              except:
                  pass

          links = extract_links(raw_html or extracted_text)
          imgs = extract_imgs(raw_html)

          # Firefox via headless Firefox with a temp profile
          ff_ok = False
          tmpdir = run_render(["mktemp", "-d"], capture_output=True, text=True, timeout=5)
          profile = tmpdir.stdout.strip() if tmpdir.returncode == 0 else ""
          try:
              ff = run_render(
                  ["firefox", "--headless", f"--profile={profile}", "--screenshot", ff_png,
                   "--window-size=1024,2000", url],
                  capture_output=True, text=True, timeout=30
              )
              ff_ok = ff.returncode == 0 and os.path.exists(ff_png) and os.path.getsize(ff_png) > 500
          finally:
              if profile:
                  run_render(["rm", "-rf", profile], capture_output=True, text=True, timeout=5)

          col_timestamp.append(now.isoformat())
          col_date.append(date_str)
          col_site_name.append(name)
          col_url.append(url)
          domain = re.sub(r'^https?://(www\.)?', '', url).split('/')[0]
          col_domain.append(domain)
          col_category.append(cat)
          col_extracted_text.append(extracted_text)
          col_text_length.append(len(extracted_text))
          col_content_hash.append(hashlib.md5(extracted_text.encode()).hexdigest() if extracted_text else "")
          col_links.append(links)
          col_link_count.append(len(links))
          col_image_urls.append(imgs)
          col_image_count.append(len(imgs))
          col_html_bytes.append(html_bytes or len(raw_html))
          col_css_bytes.append(css_bytes)
          col_dom_nodes.append(dom_nodes)
          col_text_boxes.append(text_boxes)
          col_flat_boxes.append(flat_boxes)
          col_render_width.append(img_w)
          col_render_height.append(img_h)
          col_render_ok.append(inc_ok)
          col_firefox_ok.append(ff_ok)
          col_inc_path.append(inc_png)
          col_ff_path.append(ff_png)

          status = "OK" if inc_ok else "FAIL"
          ff_status = "OK" if ff_ok else "FAIL"
          print(f"[{i+1}/{len(sites)}] {name:20s} boxes={text_boxes:5d} h={img_h:6d} {status} ff={ff_status}")

      # Write local JSON report
      report = {
          "timestamp": now.isoformat(),
          "date": date_str,
          "qa_dir": qa_dir,
          "sites": []
      }
      for idx in range(len(col_url)):
          report["sites"].append({
              "name": col_site_name[idx],
              "url": col_url[idx],
              "domain": col_domain[idx],
              "category": col_category[idx],
              "text": col_extracted_text[idx],
              "text_length": col_text_length[idx],
              "links": col_links[idx],
              "link_count": col_link_count[idx],
              "image_urls": col_image_urls[idx],
              "image_count": col_image_count[idx],
              "html_bytes": col_html_bytes[idx],
              "css_bytes": col_css_bytes[idx],
              "dom_nodes": col_dom_nodes[idx],
              "text_boxes": col_text_boxes[idx],
              "flat_boxes": col_flat_boxes[idx],
              "render_width": col_render_width[idx],
              "render_height": col_render_height[idx],
              "render_ok": col_render_ok[idx],
              "firefox_ok": col_firefox_ok[idx],
              "inc_path": col_inc_path[idx],
              "ff_path": col_ff_path[idx]
          })
      report_path = f"{qa_dir}/report.json"
      with open(report_path, "w") as f:
          json.dump(report, f, indent=2)

      ok_count = sum(1 for ok in col_render_ok if ok)
      ff_ok_count = sum(1 for ok in col_firefox_ok if ok)
      context["qa_dir"] = qa_dir
      context["report_path"] = report_path
      output = f"Compared {len(sites)} sites. Incognidium OK: {ok_count}. Firefox OK: {ff_ok_count}. Report: {report_path}"
