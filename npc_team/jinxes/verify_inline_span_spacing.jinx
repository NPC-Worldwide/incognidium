#!/usr/bin/env npc
jinx_name: verify_inline_span_spacing
description: |
  Regression check that a whitespace-only inline wrapper (e.g. <span> </span>)
  between inline siblings preserves the inter-word gap. Renders the fixture in
  Incognidium and checks the extracted text: the joined output must read
  "Hello world" with a visible space instead of "Helloworld".
inputs: []
steps:
  - name: render_and_check
    engine: python
    code: |
      import os
      import sys

      repo = os.getcwd()
      if repo not in sys.path:
          sys.path.insert(0, repo)
      from npc_team.jinxes.lib.render_local import render_local_file

      fixture = os.path.join(repo, "tests", "test_inline_span_spacing.html")
      out_png = os.path.join("/tmp", "verify_inline_span_spacing.png")
      dump_path = os.path.join("/tmp", "verify_inline_span_spacing_boxes.txt")

      info = render_local_file(
          fixture,
          out_png,
          repo=repo,
          max_height="400",
          dump_boxes=dump_path,
      )

      if not info.get("ok"):
          context['output'] = (
              "FAIL: could not render inline span spacing fixture\n" +
              info.get("stderr", "")[-500:]
          )
          raise SystemExit(1)

      rendered_text = " ".join(info.get("extracted_text", "").splitlines())
      if "Hello world" not in rendered_text:
          context['output'] = (
              "FAIL: whitespace-only inline wrapper did not preserve the inter-word gap. "
              f"Extracted text: {rendered_text}"
          )
          raise SystemExit(1)

      context['output'] = (
          "PASS: whitespace-only inline wrapper preserves the inter-word gap"
      )
