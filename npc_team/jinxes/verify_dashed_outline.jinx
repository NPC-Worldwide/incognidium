#!/usr/bin/env npc
jinx_name: verify_dashed_outline
description: |
  Regression check that dashed CSS outlines draw all four sides of the box.
  Before the fix the left and right vertical segments were missing, so dashed
  outlines looked like open top-and-bottom bars.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_outline_styles.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_outline_styles"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=800)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached Incognidium screenshot of a test page with
            several CSS outline samples. There are blue and orange dashed
            outlines, green dotted outlines, red solid outlines, and purple
            double outlines.

            Focus on the dashed outlines. Each dashed outline should be a
            complete rectangle with a top edge, a bottom edge, a left edge,
            and a right edge. It must not look like two separate horizontal
            bars with no vertical sides.

            Reply exactly "PASS" if every dashed outline forms a full four-sided
            rectangle. Reply exactly "FAIL" if any dashed outline is missing its
            left or right side, and add one short sentence describing what you see.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: dashed outlines draw all four sides")
            context["output"] = "PASS: dashed outlines draw all four sides"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
