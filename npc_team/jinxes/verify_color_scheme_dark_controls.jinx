#!/usr/bin/env npc
jinx_name: verify_color_scheme_dark_controls
inputs: []

description: |
  Regression check that `color-scheme: dark` form controls keep a visible
  checked state. Renders the color-scheme fixture and asks a vision model to
  confirm the dark card's checked checkbox and selected radio are clearly
  visible, not washed out by the dark background.

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_color_scheme.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_color_scheme"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo)
        if not incog.get("ok"):
            context["output"] = f"FAIL: Incognidium render failed for {fixture}"
            raise SystemExit(1)

        extracted = incog.get("extracted_text", "")
        expected_labels = [
            "color-scheme: light (default)",
            "color-scheme: dark",
            "Checked checkbox (dark)",
            "Selected radio (dark)",
            "accent-color variations",
        ]
        missing = [label for label in expected_labels if label not in extracted]
        if missing:
            context["output"] = (
                f"FAIL: expected labels missing from extracted text: {missing}\n"
                f"Extracted text:\n{extracted}"
            )
            raise SystemExit(1)

        prompt = f"""
          Look at the attached screenshot of a simple HTML page titled "CSS color-scheme Demo".

          The page has three cards. The second card is labeled "color-scheme: dark" and has a
          dark background. Inside that dark card there are four controls:
          - a checked checkbox labeled "Checked checkbox (dark)"
          - an unchecked checkbox labeled "Unchecked checkbox (dark)"
          - a selected radio button labeled "Selected radio (dark)"
          - an unselected radio button labeled "Unselected radio (dark)"

          Are all four controls clearly visible and visually consistent with the dark card?
          The checked/selected states should show a colored fill with a contrasting mark.
          The unchecked/unselected states should show a dark or gray outline, not a bright
          white/light box that looks like it belongs to the light card.

          Answer with exactly one of these phrases:
          - "controls visible" if all four dark-card controls are clearly visible and scheme-appropriate
          - "controls missing" if the checked/selected states blend into the background or look unchecked
          - "light outline" if the unchecked/unselected states have bright white/light outlines
          - "unclear" if you cannot tell

          Then add one short sentence describing what you see.
        """

        response = get_llm_response(
            prompt,
            model="glm-5.3-flash:cloud",
            provider="ollama",
            api_url="http://127.0.0.1:11434",
            images=[incog_png],
            npc=npc,
            temperature=0.2,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["incog_png"] = incog_png
        context["extracted_text"] = extracted
        context["vision_review"] = review_text

        fail_phrases = ["controls missing", "light outline", "unclear"]
        if any(phrase in review_text.lower() for phrase in fail_phrases):
            context["output"] = f"FAIL: {review_text}"
            raise SystemExit(1)

        print(review_text)
        print("PASS: dark color-scheme form controls are visible and scheme-appropriate.")
        context["output"] = "PASS: dark color-scheme form controls are visible and scheme-appropriate."
