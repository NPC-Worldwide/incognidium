#!/usr/bin/env npc
jinx_name: verify_css_table_cells
description: |
  Regression check that `display: table-cell` children of a `display: table`
  box are wrapped in an anonymous table row and laid out side by side. The test
  page has two rows; each row has a fixed-width left cell with a triangle
  symbol and a score, and a flexible right cell with a headline, inline tags,
  and a metadata line. Before the fix the cells stacked vertically and the
  triangle rendered as a placeholder box.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_css_table_cells.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_css_table_cells"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=800)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached screenshot of a small test page.

            The page shows two story rows. Each row should have:
            - a narrow left column containing an upward-pointing triangle and a number below it (like "70" and "42"),
            - a wider right column containing a headline, one or two yellow inline tags, a domain, and a metadata line.

            The left column and right column for each row should be side by side, not stacked vertically. The triangle should be visible, not an empty square or box.

            If both rows have the left triangle+number column sitting beside the right headline column, reply exactly "PASS".
            Otherwise reply exactly "FAIL" and add one short sentence describing what is wrong.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: CSS table cells form side-by-side columns with visible triangle symbols")
            context["output"] = "PASS: CSS table cells form side-by-side columns with visible triangle symbols"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
