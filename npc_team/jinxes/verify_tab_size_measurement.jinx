#!/usr/bin/env npc
jinx_name: verify_tab_size_measurement
description: |
  Regression check that `tab-size` is honored when measuring the intrinsic
  inline size of `white-space: pre` text. A flex row of tab-indented code
  blocks must be wide enough to show every comparison box without clipping
  at the viewport edge.

  The jinx verifies the indented source text is present, then asks a vision
  model whether all side-by-side boxes are fully visible.
inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_tab_size.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_tab_size"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        expected = "console.log(\"Double indented\");"
        extracted = incog.get("extracted_text", "")
        if expected not in extracted:
            print("FAIL: expected tab-indented source text missing from extracted output")
            context["output"] = f"FAIL: expected tab-indented source text missing\nExtracted:\n{extracted}"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached Incognidium screenshot of the CSS tab-size demo.
            Near the bottom of the page is a "Side-by-side Comparison" section
            with three boxes labeled "8 spaces", "4 spaces", and "2 spaces".
            Each box contains vertical bar markers separated by tab stops.

            Are all three comparison boxes fully visible inside the page, with
            no part of any box clipped at the right edge of the window or card?
            Reply exactly "PASS" if every box is completely visible. Reply
            exactly "FAIL" if any box is cut off or overflows, and add one short
            sentence describing what you see.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: tab-size measurement keeps side-by-side pre boxes fully visible")
            context["output"] = "PASS: tab-size measurement keeps side-by-side pre boxes fully visible"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
