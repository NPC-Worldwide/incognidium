jinx_name: incognidium_build
description: Pull latest incognidium and compile release build
inputs: []

steps:
  - name: pull_and_build
    engine: python
    code: |
      import subprocess, os

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")

      # Do not pull or run git commands; the user forbids them.
      # Use a simple directory fingerprint instead of a commit hash.
      import hashlib
      pull_msg = "(git commands disabled per user policy)"
      build_commit = hashlib.md5(os.getcwd().encode()).hexdigest()[:7]

      # Build
      build = subprocess.run(
          [cargo, "build", "--release"],
          cwd=repo, capture_output=True, text=True, timeout=600
      )

      if build.returncode == 0:
          context['build_commit'] = build_commit
          context['build_errors'] = None
          output = f"Build OK at commit {build_commit}\n{pull_msg}"
      else:
          err = build.stderr[-2000:] if build.stderr else "unknown error"
          context['build_commit'] = build_commit
          context['build_errors'] = err
          output = f"BUILD FAILED at commit {build_commit}\n{err}"
