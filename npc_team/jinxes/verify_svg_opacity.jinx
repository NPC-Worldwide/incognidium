#!/usr/bin/env npc
jinx_name: verify_svg_opacity
description: |
  Regression check that CSS `opacity` on an inline `<svg>` element is applied
  when the SVG is rasterized. Without the fix the square renders as solid black;
  with the fix it should appear as a medium-gray semi-transparent square.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_review
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_svg_opacity.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_svg_opacity"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=200)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached screenshot of a small test page. It contains a
            single black square SVG that has `opacity: 0.5` applied through CSS.
            A correct rendering should show the square as a medium gray,
            semi-transparent shape, not as a solid black square.

            Is the square solid black, or is it gray/semi-transparent?
            Reply exactly "PASS" if it looks gray or semi-transparent.
            Reply exactly "FAIL" if it looks solid black, and add one short
            sentence describing what you see.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: CSS opacity is applied to inline SVG rasterization")
            context["output"] = "PASS: CSS opacity is applied to inline SVG rasterization"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
