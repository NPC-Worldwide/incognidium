#!/usr/bin/env npc
jinx_name: knowledge_update
description: |
  Update the Incognidium knowledge graph and/or project memory files.
  Mirrors npcpy's memory lifecycle / knowledge-graph workflow.
inputs:
  - command
  - args

steps:
  - name: update_knowledge
    engine: python
    code: |
      import subprocess, os, json
      repo = os.getcwd()
      script = os.path.join(repo, "scripts", "knowledge.py")

      command = {{ command | tojson }}
      args = {{ args | default([]) | tojson }}

      cmd = ["python3", script, command] + [str(a) for a in args]
      r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
      output = r.stdout.strip() if r.returncode == 0 else f"ERROR: {r.stderr}"
