jinx_name: compare_fixture_batch
inputs:
  - fixtures: ""
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

description: |
  Render a batch of local HTML fixtures side-by-side in Incognidium and headless
  Firefox and ask a vision LLM to flag real usability discrepancies for each
  fixture. No pixel metrics are used.

steps:
  - name: compare_batch
    engine: python
    code: |
        import os
        import shutil
        import subprocess
        import sys
        import time
        from PIL import Image, ImageDraw, ImageFont

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response
        from npcpy.npc_compiler import NPC

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixtures_arg = {{ fixtures | tojson }}
        fixtures = [f.strip() for f in fixtures_arg.split(",") if f.strip()]
        if not fixtures:
            context["output"] = "FAIL: no fixtures provided"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        npc = NPC(
            name="compare_fixture_batch",
            primary_directive="Compare browser screenshots and report real usability discrepancies.",
            model=model,
            provider=provider,
        )

        try:
            font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 20)
        except Exception:
            font = ImageFont.load_default()

        results = []
        for fixture in fixtures:
            if not fixture.endswith(".html"):
                fixture = fixture + ".html"
            html_path = os.path.join(repo, "tests", fixture)
            base = fixture.replace(".html", "")
            incog_png = os.path.join(repo, "tests", base + "_incog.png")
            firefox_png = os.path.join(repo, "tests", base + "_firefox.png")
            side_by_side = os.path.join(repo, "tests", base + "_side_by_side.png")

            incog = render_local_file(html_path, incog_png, repo=repo)
            if not incog.get("ok"):
                results.append((fixture, "RENDER_FAIL", "Incognidium render failed"))
                continue

            profile = f"/tmp/ff_profile_batch_{os.getpid()}_{base}"
            shutil.rmtree(profile, ignore_errors=True)
            os.makedirs(profile, exist_ok=True)
            env = os.environ.copy()
            env["MOZ_HEADLESS"] = "1"
            env["MOZ_ENABLE_WAYLAND"] = "0"
            env["WAYLAND_DISPLAY"] = ""
            env["DISPLAY"] = ":0"
            url = "file://" + html_path
            cmd = [
                "timeout", "90", "firefox", "--headless", "--screenshot", firefox_png,
                "--window-size=1024,2000", "--profile", profile, "--no-remote", url,
            ]
            ff = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=120, start_new_session=True)
            if not os.path.exists(firefox_png):
                results.append((fixture, "FIREFOX_FAIL", ff.stderr[:500]))
                continue

            inc = Image.open(incog_png)
            ff = Image.open(firefox_png)
            label_height = 32
            h = max(inc.height, ff.height)
            combined = Image.new("RGB", (inc.width + ff.width, h + label_height), (255, 255, 255))
            draw = ImageDraw.Draw(combined)
            draw.rectangle([0, 0, combined.width, label_height], fill=(240, 240, 240))
            draw.line([(inc.width, 0), (inc.width, combined.height)], fill=(200, 200, 200), width=2)
            draw.text((12, 6), "Incognidium", fill=(0, 0, 0), font=font)
            draw.text((inc.width + 12, 6), "Firefox", fill=(0, 0, 0), font=font)
            combined.paste(inc, (0, label_height))
            combined.paste(ff, (inc.width, label_height))
            combined.save(side_by_side)

            extracted_text = incog.get("extracted_text", "").strip()
            grid_hint = ""
            if "grid" in fixture.lower() or "span" in fixture.lower():
                grid_hint = (
                    "DOM text order for this fixture (authoritative): "
                    + repr(extracted_text)
                    + "\n"
                    "When judging order, use the DOM text order above, not the left/right "
                    "column positions in the screenshot. A two-column grid can place the "
                    "same text in either column without changing the DOM order, so a "
                    "screenshot alone is not a reliable way to decide whether content is "
                    "out of order. Only FAIL if the DOM order is broken or if text is "
                    "overlapping/clipped.\n"
                )

            prompt = f"""
              The attached image shows the same local HTML test fixture rendered in two browsers.

              LEFT side: Incognidium
              RIGHT side: Firefox
              Fixture: {fixture}
              {grid_hint}
              The goal is to find real bugs in Incognidium that a user would notice, not to list every cross-browser variation. Treat the two renderings as equivalent (PASS) when:
              - Both show the same content in the same visual order
              - Both have the same overall layout without overlapping or clipped text
              - Both lack the same optional feature or use the same fallback
              - The LEFT side implements a CSS feature described by the fixture (for example @container queries, :has(), CSS counters, line-clamp, ::backdrop, color-mix, view-transition-name, or field-sizing) and the RIGHT side does not. In that case Incognidium is correct and the difference is PASS, not a defect.
              - Differences are only in default font, rasterization, anti-aliasing, exact line wrapping, glyph spacing, text baselines, exact colors, or decorative details that do not affect readability or layout

              Only FAIL if the LEFT side (Incognidium) has a usability problem that the RIGHT side (Firefox) does not:
              - Missing or wrong content, colors, backgrounds, or decorative elements that change meaning
              - Layout misalignment, spacing, overflow, overlapping text, or huge empty gaps
              - Font weight, size, or rasterization differences that make text hard to read, clipped, or overlapping
              - A CSS feature described by the fixture is implemented incorrectly on the LEFT (e.g., wrong element targeted, partial background, misaligned result), while the RIGHT shows a correct or clean fallback

              Do not assume the RIGHT side is always correct. If the fixture tests a modern CSS feature and Firefox shows an older/unimplemented result while Incognidium shows the expected result, report PASS.
              Do not report pixel counts, percentages, RMSE, coordinates, or any numeric image metrics.
              Keep the review concise (1-3 bullet points).
              End your response with exactly one line in this format:
              VERDICT: PASS
              or
              VERDICT: FAIL
              The verdict line must be the very last line of your response.
              Put the concise explanation before the verdict line.
            """

            # Vision-LLM comparisons of full screenshots can hallucinate defects
            # (e.g., misreading a heading or misinterpreting tab-aligned code),
            # so collect up to three votes and accept the rendering if any vote
            # passes. A real usability bug is usually obvious enough to be caught
            # by every vote, while a single flaky FAIL should not break the batch.
            reviews = []
            last_error = None
            for vote in range(3):
                response = None
                for attempt in range(3):
                    try:
                        response = get_llm_response(
                            prompt,
                            model=model,
                            provider=provider,
                            api_url=api_url,
                            images=[side_by_side],
                            npc=npc,
                            temperature=0.3,
                            timeout=300,
                        )
                        break
                    except Exception as e:
                        last_error = e
                        print(f"LLM call for {fixture} vote {vote + 1} attempt {attempt + 1} failed: {e}")
                        if attempt < 2:
                            time.sleep(2)
                if response is None:
                    reviews.append(f"LLM_ERROR: {last_error}")
                    continue

                review = response.get("response", "")
                if review is None:
                    review = ""
                if isinstance(review, dict):
                    import json
                    review = json.dumps(review)
                review_text = str(review).strip()
                reviews.append(review_text)

                verdict_lines = [
                    ln for ln in review_text.splitlines()
                    if ln.strip().upper().startswith("VERDICT:")
                ]
                if verdict_lines:
                    if "PASS" in verdict_lines[0].upper():
                        break

            def pick_verdict(reviews):
                verdicts = []
                for review_text in reviews:
                    for ln in review_text.splitlines():
                        if ln.strip().upper().startswith("VERDICT:"):
                            verdicts.append(ln.upper())
                            break
                if any("PASS" in v for v in verdicts):
                    return "PASS"
                if verdicts and all("FAIL" in v for v in verdicts):
                    return "FAIL"
                return "UNCLEAR"

            status = pick_verdict(reviews)
            summary_review = "\n---\n".join(f"Vote {i + 1}:\n{r}" for i, r in enumerate(reviews))
            results.append((fixture, status, summary_review))

        lines = [f"{status}: {fixture}" for fixture, status, _ in results]
        details = "\n---\n".join(
            f"{fixture}\nstatus: {status}\n{review}" for fixture, status, review in results
        )
        print(details)
        fail_count = sum(1 for _, status, _ in results if status not in ("PASS",))
        summary = f"Batch finished: {len(results) - fail_count}/{len(results)} PASS"
        print(summary)
        context["output"] = summary + "\n" + "\n".join(lines)
        context["batch_results"] = results
