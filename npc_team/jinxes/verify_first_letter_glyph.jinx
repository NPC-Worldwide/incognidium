jinx_name: verify_first_letter_glyph
inputs: []

description: |
  Render a paragraph with `::first-letter` styling and ask a vision LLM
  whether the initial glyph is enlarged, colored, and uppercased.

steps:
  - name: render_and_check
    engine: python
    code: |
      import os
      import sys
      import tempfile
      from pathlib import Path

      os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"

      repo = os.getcwd()
      if repo not in sys.path:
          sys.path.insert(0, repo)
      from npc_team.jinxes.lib.render_local import render_local_file
      from npcpy.llm_funcs import get_llm_response

      test_dir = Path(tempfile.gettempdir()) / "incognidium_first_letter_glyph"
      test_dir.mkdir(parents=True, exist_ok=True)
      html_path = test_dir / "first_letter_glyph.html"
      png_path = test_dir / "first_letter_glyph.png"

      html_path.write_text(
          """<!DOCTYPE html>
          <html>
          <head>
            <meta charset="utf-8">
            <style>
              body { margin: 24px; font-family: serif; background: #fff; }
              .drop-cap {
                font-size: 18px;
                width: 420px;
              }
              .drop-cap::first-letter {
                font-size: 260%;
                color: #c0392b;
                text-transform: uppercase;
              }
            </style>
          </head>
          <body>
            <p class="drop-cap">agnificent first-letter styling makes the opening
            glyph large, red, and uppercase.</p>
          </body>
          </html>
          """
      )

      info = render_local_file(str(html_path), str(png_path), repo=repo)
      if not info.get("ok"):
          context["output"] = "render failed"
          raise SystemExit(1)

      prompt = f"""Look at the attached screenshot of a simple HTML fixture.

          The fixture shows a paragraph whose CSS uses `::first-letter` to style
          the first character: it should be enlarged, colored red, and forced to
          uppercase. The paragraph text begins with a lowercase "a" in the source,
          so the rendered first letter should appear as a large red "A".

          Question: is the first character of the paragraph a large, red,
          uppercase "A" that is clearly separate from the rest of the text?

          Answer with exactly one of these lines first:
          - PASS: the first character is a large red uppercase "A".
          - FAIL: the first character is missing, not red, not enlarged, not
            uppercase, or the paragraph starts with lowercase "a" or "gnificent".

          Then add one short sentence explaining your choice.
          """

      last_error = None
      response = None
      for attempt in range(3):
          try:
              response = get_llm_response(
                  prompt,
                  model="glm-5.3-flash:cloud",
                  provider="ollama",
                  api_url="http://127.0.0.1:11434",
                  images=[str(png_path)],
                  npc=npc,
                  temperature=0.2,
                  timeout=120,
              )
              break
          except Exception as e:
              last_error = e
              print(f"LLM call attempt {attempt + 1} failed: {e}")
              if attempt < 2:
                  import time
                  time.sleep(2)
      if response is None:
          context["output"] = f"FAIL: LLM review failed after 3 attempts: {last_error}"
          raise SystemExit(1)

      review = response.get("response", "")
      if isinstance(review, dict):
          import json
          review = json.dumps(review)

      context["output"] = review
      print(review)
      if "PASS" in review:
          print("PASS: ::first-letter renders the initial glyph large, red, and uppercase.")
      else:
          raise SystemExit(1)

  - name: summary
    engine: python
    code: |
      output = context.get("output", "no result")
