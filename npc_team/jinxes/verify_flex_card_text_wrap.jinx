jinx_name: verify_flex_card_text_wrap

description: |
  Deterministic check for `test_flex_card_text_wrap.html`. The fixture uses
  `flex: 1 1 0%` items with `white-space: nowrap` links, so the expected CSS
  behavior is that the three items share the flex line and the unbreakable
  headline text overflows each narrow item. No pixel metrics are used;
  assertions are on the extracted text and flat-box positions.

steps:
  - name: render_and_check
    engine: python
    code: |
        import os, sys, traceback

        try:
            repo = os.getcwd()
            if repo not in sys.path:
                sys.path.insert(0, repo)
            from npc_team.jinxes.lib.render_local import render_local_file

            fixture = os.path.join(repo, "tests", "test_flex_card_text_wrap.html")
            out_png = os.path.join(repo, "tests", "test_flex_card_text_wrap_incog.png")
            result = render_local_file(fixture, out_png, repo=repo)
            if not result.get("ok"):
                context["output"] = f"render failed: {result.get('stderr', '')}"
                print(context["output"])
                raise SystemExit(1)

            text = result.get("extracted_text", "")
            headlines = [
                "Long headline text should wrap neatly inside this narrow flex card instead of overflowing",
                "Another long headline that must stay within the card width and never overlap the neighbor",
                "Third headline with enough words to demonstrate correct wrapping behavior in flex cards",
            ]
            missing = [h for h in headlines if h not in text]
            if missing:
                context["output"] = f"missing headline text: {missing}\nrendered text:\n{text}"
                print(context["output"])
                raise SystemExit(1)

            flat = result.get("flat_box_lines", [])
            item_boxes = [
                (x, y, w, h)
                for (_, tag, cls, x, y, w, h, _, _) in flat
                if tag == "div" and "item" in cls.split()
            ]
            if len(item_boxes) < 3:
                context["output"] = f"expected 3 flex items, found {len(item_boxes)}"
                print(context["output"])
                raise SystemExit(1)

            # The three items should share the same flex line (same y) and each
            # receive roughly a third of the 755px container.
            y_positions = [round(y, 1) for (_, y, _, _) in item_boxes]
            widths = [round(w, 1) for (_, _, w, _) in item_boxes]
            if len(set(y_positions)) != 1:
                context["output"] = f"flex items are not on the same line: y positions {y_positions}"
                print(context["output"])
                raise SystemExit(1)

            container_width = 755.0
            avg_width = sum(widths) / len(widths)
            expected_share = container_width / 3.0
            if not (expected_share * 0.6 <= avg_width <= expected_share * 1.4):
                context["output"] = f"flex item widths do not share the container: {widths}"
                print(context["output"])
                raise SystemExit(1)

            # Each nowrap headline link should be laid out as a single wide line
            # that is wider than its item's content box, confirming the text is
            # not being silently wrapped or torn into fragments.
            link_text_boxes = [
                (x, y, w, h)
                for (_, tag, cls, x, y, w, h, _, text) in flat
                if tag == "#text"
                and text
                and any(hl[:20] in text for hl in headlines)
            ]
            failures = []
            for (x, y, w, h) in link_text_boxes:
                # Find the item that contains this text box.
                for (ix, iy, iw, ih) in item_boxes:
                    if ix <= x < ix + iw and iy <= y < iy + ih:
                        content_width = iw - 40.0  # padding: 0 20px
                        if w <= content_width + 1.0:
                            failures.append(
                                f"nowrap headline inside item {round(ix,1)} fits unexpectedly "
                                f"(text width {round(w,1)} <= content width {round(content_width,1)})"
                            )
                        break

            if failures:
                context["output"] = "FAIL\n" + "\n".join(failures)
                print(context["output"])
                raise SystemExit(1)

            context["output"] = "PASS: flex items share the row and nowrap text overflows as expected"
            print(context["output"])
        except Exception as e:
            msg = f"ERROR: {e}\n{traceback.format_exc()}"
            context["output"] = msg
            print(msg)
            raise SystemExit(1)
