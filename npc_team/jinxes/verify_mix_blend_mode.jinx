jinx_name: verify_mix_blend_mode

description: |
  Deterministic smoke check that the mix-blend-mode fixture renders without
  crashing and keeps its visible text. The visual correctness of the blend is
  covered by the Firefox comparison jinx; this test guards against total
  content loss from future regressions.

steps:
  - name: render_and_check
    engine: python
    code: |
        import os, sys, traceback

        try:
            repo = os.getcwd()
            if repo not in sys.path:
                sys.path.insert(0, repo)
            from npc_team.jinxes.lib.render_local import render_local_file

            fixture = os.path.join(repo, "tests", "test_mix_blend_mode.html")
            out_png = os.path.join(repo, "tests", "test_mix_blend_mode_incog.png")
            result = render_local_file(
                fixture,
                out_png,
                repo=repo,
                viewport_width=800,
            )
            if not result.get("ok"):
                context["output"] = f"render failed: {result.get('stderr', '')}"
                print(context["output"])
                raise SystemExit(1)

            extracted = result.get("extracted_text", "")
            if "Blend Mode Test" not in extracted:
                context["output"] = f"regression: blend-mode fixture text missing\n{extracted}"
                print(context["output"])
                raise SystemExit(1)

            context["output"] = "PASS: mix-blend-mode fixture renders and preserves its text"
            print(context["output"])
        except Exception as e:
            msg = f"ERROR: {e}\n{traceback.format_exc()}"
            context["output"] = msg
            print(msg)
            raise SystemExit(1)
