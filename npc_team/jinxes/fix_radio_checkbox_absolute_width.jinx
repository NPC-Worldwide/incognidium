#!/usr/bin/env npc
jinx_name: fix_radio_checkbox_absolute_width
description: |
  Fix absolutely/fixed positioned radio buttons and checkboxes collapsing to
  just their border frame when width is auto. They are replaced form controls
  with a real intrinsic size, so intrinsic width must fall back to the UA
  default control size rather than zero.
inputs:
  - repro_path: "/tmp/poll_bar_repro.html"
  - output_name: "poll_bar_npc"

steps:
  - name: patch_layout_intrinsic_width
    engine: python
    code: |
      import os

      repo = os.getcwd()
      path = os.path.join(repo, "crates/incognidium-layout/src/lib.rs")
      with open(path) as f:
          src = f.read()

      old_lines = [
          "        // Empty inline/inline-block fallback to the laid-out width. Absolutely",
          "        // or fixed positioned boxes must not use that laid-out width: it is the",
          "        // containing-block width, not an intrinsic size, so using it makes",
          "        // shrink-to-fit parents (and absolute auto-width sizing) expand to the",
          "        // full container. Fall back to the horizontal padding/border frame so",
          "        // empty generated pseudo-elements still occupy their visual width.",
          "        let style = styles.get(&lb.node_id).cloned().unwrap_or_default();",
          "        if style.position == Position::Absolute || style.position == Position::Fixed {",
          "            let pb = style.padding_left_px(0.0)",
          "                + style.padding_right_px(0.0)",
          "                + style.border_left_width",
          "                + style.border_right_width;",
          "            return pb;",
          "        }",
          "        if lb.width > 0.0 {",
          "            return lb.width;",
          "        }",
          "        return lb.content_width.min(lb.width);",
      ]

      new_lines = [
          "        // Empty inline/inline-block fallback to the laid-out width. Absolutely",
          "        // or fixed positioned boxes must not use that laid-out width: it is the",
          "        // containing-block width, not an intrinsic size, so using it makes",
          "        // shrink-to-fit parents (and absolute auto-width sizing) expand to the",
          "        // full container. Fall back to the horizontal padding/border frame so",
          "        // empty generated pseudo-elements still occupy their visual width.",
          "        let style = styles.get(&lb.node_id).cloned().unwrap_or_default();",
          "        if style.position == Position::Absolute || style.position == Position::Fixed {",
          "            // Replaced form controls (radio buttons, checkboxes) have a real",
          "            // intrinsic size and must not collapse to just their border frame",
          "            // when absolutely positioned with auto width. Return the UA default",
          "            // control size plus padding/border so shrink-to-fit and absolute",
          "            // auto-width sizing produce a usable control.",
          "            let is_replaced_form_control = matches!(",
          "                lb.input_type,",
          "                Some(InputType::Radio { .. }) | Some(InputType::Checkbox { .. })",
          "            );",
          "            if is_replaced_form_control {",
          "                const DEFAULT_CONTROL_SIZE: f32 = 13.0;",
          "                let pb = style.padding_left_px(0.0)",
          "                    + style.padding_right_px(0.0)",
          "                    + style.border_left_width",
          "                    + style.border_right_width;",
          "                return DEFAULT_CONTROL_SIZE + pb;",
          "            }",
          "            let pb = style.padding_left_px(0.0)",
          "                + style.padding_right_px(0.0)",
          "                + style.border_left_width",
          "                + style.border_right_width;",
          "            return pb;",
          "        }",
          "        if lb.width > 0.0 {",
          "            return lb.width;",
          "        }",
          "        return lb.content_width.min(lb.width);",
      ]

      old = "\n".join(old_lines)
      new = "\n".join(new_lines)

      log_file = "/tmp/fix_radio_checkbox_step.log"
      log = []
      if old not in src:
          if new in src:
              log.append(path + " already contains the fix")
              patched = True
          else:
              log.append("ERROR: expected code block not found and fix not present")
              patched = False
      else:
          src = src.replace(old, new, 1)
          with open(path, "w") as f:
              f.write(src)
          log.append("Patched " + path)
          patched = True
      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("RENDER_PNG=" + (render_png if render_png else "") + "\n")
          f.write("\n".join(log) + "\n")
      context["patched"] = patched
      context["log_file"] = log_file
      context["output"] = "\n".join(log)

  - name: fmt_and_check
    engine: python
    code: |
      import subprocess, os

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      log_file = context.get("log_file", "/tmp/fix_radio_checkbox_step.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched_flag = raw[0] if raw and raw[0].startswith("PATCHED=") else "PATCHED=0"
      patched = patched_flag == "PATCHED=1"
      render_png = ""
      for line in raw:
          if line.startswith("RENDER_PNG="):
              render_png = line[len("RENDER_PNG="):]
      log = [line for line in raw if not line.startswith("PATCHED=") and not line.startswith("RENDER_PNG=")]

      if not patched:
          msg = "Skipping fmt/check because patch did not apply."
      else:
          r = subprocess.run([cargo, "fmt", "--all"], cwd=repo, capture_output=True, text=True, timeout=120)
          if r.returncode != 0:
              msg = "cargo fmt FAILED:\n" + r.stderr[-500:]
          else:
              r = subprocess.run([cargo, "check", "--all"], cwd=repo, capture_output=True, text=True, timeout=300)
              if r.returncode == 0:
                  msg = "cargo fmt --all OK; cargo check --all OK"
              else:
                  msg = "cargo check --all FAILED:\n" + r.stderr[-500:]
      log.append(msg)
      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("RENDER_PNG=" + (render_png if render_png else "") + "\n")
          f.write("\n".join(log) + "\n")
      context["output"] = "\n".join(log)

  - name: tests
    engine: python
    code: |
      import subprocess, os

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      log_file = context.get("log_file", "/tmp/fix_radio_checkbox_step.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched_flag = raw[0] if raw and raw[0].startswith("PATCHED=") else "PATCHED=0"
      patched = patched_flag == "PATCHED=1"
      render_png = ""
      for line in raw:
          if line.startswith("RENDER_PNG="):
              render_png = line[len("RENDER_PNG="):]
      log = [line for line in raw if not line.startswith("PATCHED=") and not line.startswith("RENDER_PNG=")]

      if not patched:
          msg = "Skipping tests because patch did not apply."
      else:
          r = subprocess.run(
              [cargo, "test", "--workspace", "--lib"],
              cwd=repo, capture_output=True, text=True, timeout=600
          )
          if r.returncode == 0:
              msg = "cargo test --workspace --lib OK"
          else:
              msg = "cargo test --workspace --lib FAILED:\n" + r.stderr[-1000:]
      log.append(msg)
      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("RENDER_PNG=" + (render_png if render_png else "") + "\n")
          f.write("\n".join(log) + "\n")
      context["output"] = "\n".join(log)

  - name: build_and_render
    engine: python
    code: |
      import subprocess, os

      repo = os.getcwd()
      cargo = os.path.expanduser("~/.cargo/bin/cargo")
      repro_path = {{ repro_path | tojson }}
      output_name = {{ output_name | tojson }}
      out_png = "/tmp/incognidium_tests/" + output_name + ".png"
      log_file = context.get("log_file", "/tmp/fix_radio_checkbox_step.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched_flag = raw[0] if raw and raw[0].startswith("PATCHED=") else "PATCHED=0"
      patched = patched_flag == "PATCHED=1"
      render_png = ""
      for line in raw:
          if line.startswith("RENDER_PNG="):
              render_png = line[len("RENDER_PNG="):]
      log = [line for line in raw if not line.startswith("PATCHED=") and not line.startswith("RENDER_PNG=")]

      if not patched:
          msg = "Skipping build/render because patch did not apply."
          render_png = ""
      else:
          r = subprocess.run([cargo, "build", "--release", "--bin", "render_to_png"], cwd=repo, capture_output=True, text=True, timeout=600)
          if r.returncode != 0:
              msg = "Build failed (exit " + str(r.returncode) + "):\n" + r.stderr[-800:]
              render_png = ""
          else:
              binary = os.path.join(repo, "target/release/render_to_png")
              rr = subprocess.run([binary, repro_path, out_png, "--no-js"], cwd=repo, capture_output=True, text=True, timeout=120)
              if rr.returncode != 0:
                  msg = "Render failed (exit " + str(rr.returncode) + "):\n" + rr.stderr[-800:]
                  render_png = ""
              else:
                  msg = "Rendered " + out_png
                  render_png = out_png
      log.append(msg)
      with open(log_file, "w") as f:
          f.write("PATCHED=" + ("1" if patched else "0") + "\n")
          f.write("RENDER_PNG=" + (render_png if render_png else "") + "\n")
          f.write("\n".join(log) + "\n")
      context["render_png"] = render_png
      context["output"] = "\n".join(log)

  - name: summary
    engine: python
    code: |
      log_file = context.get("log_file", "/tmp/fix_radio_checkbox_step.log")
      with open(log_file) as f:
          raw = f.read().splitlines()
      patched_flag = raw[0] if raw and raw[0].startswith("PATCHED=") else "PATCHED=0"
      patched = patched_flag == "PATCHED=1"
      render_png = ""
      for line in raw:
          if line.startswith("RENDER_PNG="):
              render_png = line[len("RENDER_PNG="):]
      log = [line for line in raw if not line.startswith("PATCHED=") and not line.startswith("RENDER_PNG=")]
      lines = [
          "=== Steps ===",
      ] + log + [
          "",
          "Fix: radio and checkbox inputs with auto width no longer collapse to their border frame when absolutely or fixed positioned.",
          "The intrinsic width now falls back to the UA default control size so the controls remain visible and clickable.",
          "Draft commit message: Preserve the intrinsic width of absolutely positioned radio buttons and checkboxes so auto-width controls do not collapse to a border-only sliver.",
          "Render output: " + (render_png if render_png else "(not rendered)"),
      ]
      context["output"] = "\n".join(lines)
