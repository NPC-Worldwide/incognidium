jinx_name: verify_inline_svg_em_size
inputs: []

description: |
  Deterministically verify that inline SVG elements sized with em units render
  without errors and do not produce stray text boxes.

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os, sys

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_inline_svg_em_size.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_inline_svg_em_size"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, max_height="300")
        if not incog.get("ok"):
            context['output'] = f"Incognidium render failed for {fixture}"
            raise SystemExit(1)

        if incog.get("extracted_text", "").strip():
            context['output'] = (
                f"FAIL: {fixture} should contain only icons, but text was extracted:\n"
                f"{incog.get('extracted_text', '')}"
            )
            raise SystemExit(1)

        context['output'] = (
            "PASS: em-sized inline SVGs render without producing stray text"
        )
        print(context['output'])
