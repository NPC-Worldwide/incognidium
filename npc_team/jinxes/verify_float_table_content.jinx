#!/usr/bin/env npc
jinx_name: verify_float_table_content
description: |
  Regression check for floated table paint order. A floated table with
  background and borders must paint its text contents on top of the table
  background, not have them covered by it.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_infobox_float_table.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_infobox_float_table"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=700)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached screenshot of a small test page. There is a
            paragraph of text on the left and a gray-bordered floating table on
            the right.

            The floating table should contain several rows of text, including
            "Rust", "Paradigms", "Multi-paradigm", "Developer", "The Rust Team",
            "First appeared", and "2010".

            Is the table populated with this text, or is it an empty gray box?
            Reply exactly "PASS" if the table rows are clearly visible. Reply
            exactly "FAIL" if the table is empty or the text is missing, and add
            one short sentence describing what you see.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: floated table content is visible above its background")
            context["output"] = "PASS: floated table content is visible above its background"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
