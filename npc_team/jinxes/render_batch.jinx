#!/usr/bin/env npc
jinx_name: render_batch
description: Batch render a site list through Incognidium and Firefox, classify results, and archive. Inputs iterations, model, provider, api_url.
inputs:
  - iterations: "1"
  - model: "kimi-k2.7-code:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"
steps:
  - name: batch
    engine: python
    code: |
      import sys, os
      sys.path.insert(0, os.path.join(os.getcwd(), "npc_team", "helpers"))
      import render_batch_helper
      output = render_batch_helper.run(
          iterations=int({{ iterations | default("1") | tojson }}),
          model={{ model | default("kimi-k2.7-code:cloud") | tojson }},
          provider={{ provider | default("ollama") | tojson }},
      )
