jinx_name: render_batch
description: Batch render a site list through Incognidium and Firefox, classify results, and archive. Inputs iterations, model, provider.
inputs:
  - iterations: "1"
  - model: "ornith:9b"
  - provider: "ollama"
steps:
  - name: batch
    engine: python
    code: |
      import sys, os
      sys.path.insert(0, os.path.join(os.getcwd(), "npc_team", "helpers"))
      import render_batch_helper
      output = render_batch_helper.run(
          iterations=int({{ iterations | default("1") | tojson }}),
          model={{ model | default("ornith:9b") | tojson }},
          provider={{ provider | default("ollama") | tojson }},
      )
