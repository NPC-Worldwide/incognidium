      def verify_hebrew_marker_suffix():
          import os
          import sys
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = "test_marker.html"
          html_path = os.path.join(repo, "tests", fixture)
          base = "test_marker"
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          
          incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=1024)
          if not incog.get("ok"):
              print("FAIL: Incognidium render failed")
              print(incog.get("stderr", ""))
              context["output"] = "FAIL: Incognidium render failed"
              raise SystemExit(1)
          
          # Find the Hebrew Numerals list and collect marker text boxes.
          # List markers are represented by li boxes with non-empty marker text.
          hebrew_markers = []
          in_hebrew = False
          for node_id, tag, cls, x, y, w, h, img, text in incog.get("flat_box_lines", []):
              if tag == "ol" and "hebrew" in cls:
                  in_hebrew = True
              elif tag == "ol":
                  in_hebrew = False
              if in_hebrew and tag == "li" and text and len(text.strip()) <= 4:
                  # These are the marker pseudo-element boxes, not the item text.
                  hebrew_markers.append(text.strip())
          
          expected = ["א.", "ב.", "ג."]
          if hebrew_markers != expected:
              print(f"FAIL: Hebrew markers {hebrew_markers!r} do not match expected {expected!r}")
              context["output"] = f"FAIL: Hebrew markers {hebrew_markers!r} do not match expected {expected!r}"
              raise SystemExit(1)
          
          print("PASS: Hebrew list counters include the '. ' suffix")
          context["output"] = "PASS: Hebrew list counters include the '. ' suffix"
          return context.get("output", "")
      
      def verify_hyphens():
          import os, sys, traceback
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_hyphens.html")
              out_png = os.path.join(repo, "tests", "test_hyphens_incog.png")
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
                  viewport_width=800,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              text = result.get("extracted_text", "")
              section_start = text.find("hyphens: none")
              if section_start < 0:
                  context["output"] = "FAIL: hyphens: none section not found"
                  print(context["output"])
                  raise SystemExit(1)
          
              section_end = text.find("hyphens: manual", section_start)
              if section_end < 0:
                  section_end = len(text)
              section = text[section_start:section_end]
          
              if "internationalization" not in section:
                  context["output"] = (
                      f"FAIL: intact word not in hyphens:none section:\n{section}"
                  )
                  print(context["output"])
                  raise SystemExit(1)
          
              # Reject visible or invisible hyphen artifacts in the section text.
              if "-" in section or "­" in section:
                  context["output"] = (
                      f"FAIL: hyphen artifacts remained in hyphens:none section:\n{section}"
                  )
                  print(context["output"])
                  raise SystemExit(1)
          
              context["output"] = "PASS: hyphens: none removes soft hyphens"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
