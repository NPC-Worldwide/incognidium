      def verify_text_align_last():
          import os
          import sys
          import tempfile
          from pathlib import Path
          
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          from npcpy.llm_funcs import get_llm_response
          
          test_dir = Path(tempfile.gettempdir()) / "incognidium_text_align_last"
          test_dir.mkdir(parents=True, exist_ok=True)
          html_path = test_dir / "text_align_last.html"
          png_path = test_dir / "text_align_last.png"
          
          html_path.write_text(
              """<!DOCTYPE html>
              <html>
              <head>
                <meta charset="utf-8">
                <style>
                  body { margin: 20px; font-family: sans-serif; background: #fff; }
                  .box {
                    width: 360px;
                    padding: 20px;
                    border: 2px solid #333;
                    text-align: justify;
                    text-align-last: center;
                  }
                </style>
              </head>
              <body>
                <div class="box">
                  This paragraph is fully justified, meaning the text is spaced to
                  align with both the left and the right edges. The last line of this
                  paragraph should be centered rather than justified.
                </div>
              </body>
              </html>
              """
          )
          
          info = render_local_file(str(html_path), str(png_path), repo=repo)
          if not info.get("ok"):
              context["output"] = "render failed"
              raise SystemExit(1)
          
          prompt = f"""Look at the attached screenshot of a simple HTML fixture.
          
              The fixture shows a gray-bordered box containing one paragraph. The
              paragraph is set to `text-align: justify` and `text-align-last: center`,
              so the final line should be centered in the box while the earlier lines
              fill the width rather than being centered.
          
              Question: is the final line centered, and are the earlier lines clearly
              not centered (they should stretch across the box instead)?
          
              Answer with exactly one of these lines first:
              - PASS: the final line is centered and the earlier lines are not centered.
              - FAIL: the final line is left-aligned, right-aligned, or the whole
                paragraph is centered like a normal `text-align: center` block.
          
              Then add one short sentence explaining your choice.
              """
          
          last_error = None
          response = None
          for attempt in range(3):
              try:
                  response = get_llm_response(
                      prompt,
                      model="glm-5.3-flash:cloud",
                      provider="ollama",
                      api_url="http://127.0.0.1:11434",
                      images=[str(png_path)],
                      npc=npc,
                      temperature=0.2,
                      timeout=120,
                  )
                  break
              except Exception as e:
                  last_error = e
                  print(f"LLM call attempt {attempt + 1} failed: {e}")
                  if attempt < 2:
                      import time
                      time.sleep(2)
          if response is None:
              context["output"] = f"FAIL: LLM review failed after 3 attempts: {last_error}"
              raise SystemExit(1)
          
          review = response.get("response", "")
          if isinstance(review, dict):
              import json
              review = json.dumps(review)
          
          context["output"] = review
          print(review)
          if "PASS" in review:
              print("PASS: text-align-last center is applied to the final line of a justified paragraph.")
          else:
              raise SystemExit(1)
          output = context.get("output", "no result")
          return context.get("output", "")
      
      def verify_text_decoration_auto():
          import os
          import shutil
          import subprocess
          import sys
          
          # The NPC runtime sometimes drops the explicit api_url for Ollama models
          # and routes them to a failing cloud endpoint. Force the local host here
          # before any LLM imports so the ollama client picks it up by default.
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          
          from PIL import Image, ImageDraw, ImageFont
          from npcpy.llm_funcs import get_llm_response
          from npcpy.npc_compiler import NPC
          
          fixture = "test_text_decoration_solid_auto"
          if not fixture.endswith(".html"):
              fixture = fixture + ".html"
          
          model = "glm-5.3-flash:cloud"
          provider = "ollama"
          api_url = "http://127.0.0.1:11434"
          
          npc = NPC(
              name="verify_text_decoration_auto",
              primary_directive="Compare browser screenshots and judge continuous underlines across word spaces.",
              model=model,
              provider=provider,
          )
          
          repo = os.getcwd()
          html_path = os.path.join(repo, "tests", fixture)
          base = fixture.replace(".html", "")
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          firefox_png = os.path.join(repo, "tests", base + "_firefox.png")
          side_by_side = os.path.join(repo, "tests", base + "_side_by_side.png")
          
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          incog = render_local_file(html_path, incog_png, repo=repo)
          if not incog.get("ok"):
              print("FAIL: Incognidium render failed")
              context["output"] = "FAIL: Incognidium render failed"
              raise SystemExit(1)
          
          profile = f"/tmp/ff_profile_{os.getpid()}"
          shutil.rmtree(profile, ignore_errors=True)
          os.makedirs(profile, exist_ok=True)
          env = os.environ.copy()
          env["MOZ_HEADLESS"] = "1"
          env["MOZ_ENABLE_WAYLAND"] = "0"
          env["WAYLAND_DISPLAY"] = ""
          env["DISPLAY"] = ":0"
          url = "file://" + html_path
          cmd = [
              "timeout", "90", "firefox", "--headless", "--screenshot", firefox_png,
              "--window-size=1024,2000", "--profile", profile, "--no-remote", url,
          ]
          ff = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=120, start_new_session=True)
          if not os.path.exists(firefox_png):
              print("FAIL: Firefox screenshot missing")
              context["output"] = "FAIL: Firefox screenshot missing"
              raise SystemExit(1)
          
          inc = Image.open(incog_png)
          ff = Image.open(firefox_png)
          h = max(inc.height, ff.height)
          combined = Image.new("RGB", (inc.width + ff.width, h), (255, 255, 255))
          combined.paste(inc, (0, 0))
          combined.paste(ff, (inc.width, 0))
          combined.save(side_by_side)
          
          # Locate the rendered vertical position of each target phrase from the
          # flat boxes so the crop stays aligned even if font metrics shift.
          def text_top(label):
              for line in incog.get("flat_box_lines", []):
                  if len(line) >= 9 and label in (line[8] or ""):
                      return line[4]
              return None
          
          thin_top = text_top("Thin red underline")
          thick_top = text_top("Thick blue underline")
          double_top = text_top("Double solid underline")
          if thin_top is None or thick_top is None or double_top is None:
              print("FAIL: could not locate target text in flat boxes")
              context["output"] = "FAIL: could not locate target text in flat boxes"
              raise SystemExit(1)
          
          half = inc.width
          crop_h = 36
          def crop_row(top):
              top = int(max(0, top - 2))
              return combined.crop((40, top, half + 360, top + crop_h))
          
          thin_crop = crop_row(thin_top + 18)
          thick_crop = crop_row(thick_top + 18)
          double_crop = crop_row(double_top + 18)
          
          try:
              font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 14)
          except Exception:
              font = ImageFont.load_default()
          
          labeled = Image.new(
              "RGB",
              (thin_crop.width, thin_crop.height + thick_crop.height + double_crop.height + 70),
              (255, 255, 255),
          )
          draw = ImageDraw.Draw(labeled)
          draw.text((8, 4), "1. Thin red underline", fill=(0, 0, 0), font=font)
          labeled.paste(thin_crop, (0, 22))
          y2 = thin_crop.height + 26
          draw.text((8, y2), "2. Thick blue underline", fill=(0, 0, 0), font=font)
          labeled.paste(thick_crop, (0, y2 + 18))
          y3 = y2 + thick_crop.height + 22
          draw.text((8, y3), "3. Double solid underline", fill=(0, 0, 0), font=font)
          labeled.paste(double_crop, (0, y3 + 18))
          crop_path = os.path.join(repo, "tests", base + "_underline_crops.png")
          labeled.save(crop_path)
          
          prompt = f"""
              This image shows three labeled crops from a side-by-side browser
              comparison. LEFT is Incognidium, RIGHT is Firefox.
          
              Crop 1: "Thin red underline" (thin red single underline)
              Crop 2: "Thick blue underline" (thick blue single underline)
              Crop 3: "Double solid underline" (green double underline)
          
              All words are chosen to have no descender glyphs, so any visible gap
              is at a word space and is a real defect.
          
              Judge only the spaces BETWEEN words ("Thin"–"red", "red"–"underline",
              "Thick"–"blue", "blue"–"underline",
              "Double"–"solid", "solid"–"underline"). On the LEFT side, do all three
              underlines run unbroken across those inter-word spaces, matching the
              continuous underlines on the RIGHT side? Or is there a visible break
              at a word space where the background shows through?
          
              Answer with exactly one of these two lines first, then add one short
              sentence explaining your choice:
              - PASS: all three LEFT-side underlines are continuous across inter-word spaces.
              - FAIL: one or more LEFT-side underlines have a visible gap at an inter-word space (name the line and the word space).
          """
          
          # The judgment is subtle, so ask the vision model several times and
          # only fail if every attempt reports a real word-space gap. A single
          # PASS is enough because the broad comparison and crop inspection
          # already filter out obvious defects.
          reviews = []
          last_error = None
          for attempt in range(3):
              try:
                  response = get_llm_response(
                      prompt,
                      model=model,
                      provider=provider,
                      api_url=api_url,
                      images=[crop_path],
                      npc=npc,
                      temperature=0.1,
                      timeout=300,
                  )
                  review = response.get("response", "")
                  if review is None:
                      review = ""
                  if isinstance(review, dict):
                      import json
                      review = json.dumps(review)
                  review_text = str(review).strip()
                  reviews.append(review_text)
                  if review_text.upper().startswith("PASS"):
                      break
              except Exception as e:
                  last_error = e
                  print(f"LLM call attempt {attempt + 1} failed: {e}")
                  if attempt < 2:
                      import time
                      time.sleep(2)
          
          context["reviews"] = reviews
          context["side_by_side"] = side_by_side
          context["incog_png"] = incog_png
          context["firefox_png"] = firefox_png
          
          if any(r.upper().startswith("PASS") for r in reviews):
              print("PASS: default skip-ink auto underlines are continuous across word spaces")
              context["output"] = "PASS: default skip-ink auto underlines are continuous across word spaces"
          elif reviews:
              print(reviews[-1])
              context["output"] = reviews[-1]
              raise SystemExit(1)
          else:
              context["output"] = f"FAIL: LLM review failed after 3 attempts: {last_error}"
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_text_decoration_no_skip():
          import os
          import shutil
          import subprocess
          import sys
          from PIL import Image, ImageDraw, ImageFont
          from npcpy.llm_funcs import get_llm_response
          from npcpy.npc_compiler import NPC
          
          # The NPC runtime sometimes drops the explicit api_url for Ollama models
          # and routes them to a failing cloud endpoint. Force the local host here
          # before any LLM imports so the ollama client picks it up by default.
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          
          fixture = "test_text_decoration_no_skip"
          if not fixture.endswith(".html"):
              fixture = fixture + ".html"
          
          model = "glm-5.3-flash:cloud"
          provider = "ollama"
          api_url = "http://127.0.0.1:11434"
          
          npc = NPC(
              name="verify_text_decoration_no_skip",
              primary_directive="Compare browser screenshots and judge continuous underlines.",
              model=model,
              provider=provider,
          )
          
          repo = os.getcwd()
          html_path = os.path.join(repo, "tests", fixture)
          base = fixture.replace(".html", "")
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          firefox_png = os.path.join(repo, "tests", base + "_firefox.png")
          side_by_side = os.path.join(repo, "tests", base + "_side_by_side.png")
          
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          incog = render_local_file(html_path, incog_png, repo=repo)
          if not incog.get("ok"):
              print("FAIL: Incognidium render failed")
              context["output"] = "FAIL: Incognidium render failed"
              raise SystemExit(1)
          
          profile = f"/tmp/ff_profile_{os.getpid()}"
          shutil.rmtree(profile, ignore_errors=True)
          os.makedirs(profile, exist_ok=True)
          env = os.environ.copy()
          env["MOZ_HEADLESS"] = "1"
          env["MOZ_ENABLE_WAYLAND"] = "0"
          env["WAYLAND_DISPLAY"] = ""
          env["DISPLAY"] = ":0"
          url = "file://" + html_path
          cmd = [
              "timeout", "90", "firefox", "--headless", "--screenshot", firefox_png,
              "--window-size=1024,2000", "--profile", profile, "--no-remote", url,
          ]
          ff = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=120, start_new_session=True)
          if not os.path.exists(firefox_png):
              print("FAIL: Firefox screenshot missing")
              context["output"] = "FAIL: Firefox screenshot missing"
              raise SystemExit(1)
          
          inc = Image.open(incog_png)
          ff = Image.open(firefox_png)
          h = max(inc.height, ff.height)
          combined = Image.new("RGB", (inc.width + ff.width, h), (255, 255, 255))
          combined.paste(inc, (0, 0))
          combined.paste(ff, (inc.width, 0))
          combined.save(side_by_side)
          
          def text_top(label):
              for line in incog.get("flat_box_lines", []):
                  if len(line) >= 9 and label in (line[8] or ""):
                      return line[4]
              return None
          
          solid_top = text_top("Thick 4px underline")
          double_top = text_top("Double underline")
          offset_top = text_top("Underline with 4px offset")
          if solid_top is None or double_top is None or offset_top is None:
              print("FAIL: could not locate target text in flat boxes")
              context["output"] = "FAIL: could not locate target text in flat boxes"
              raise SystemExit(1)
          
          half = inc.width
          crop_h = 40
          def crop_row(top):
              top = int(max(0, top - 2))
              return combined.crop((40, top, half + 360, top + crop_h))
          
          solid_crop = crop_row(solid_top + 20)
          double_crop = crop_row(double_top + 20)
          offset_crop = crop_row(offset_top + 20)
          
          try:
              font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 14)
          except Exception:
              font = ImageFont.load_default()
          
          labeled = Image.new(
              "RGB",
              (solid_crop.width, solid_crop.height + double_crop.height + offset_crop.height + 70),
              (255, 255, 255),
          )
          draw = ImageDraw.Draw(labeled)
          draw.text((8, 4), "1. Thick 4px underline", fill=(0, 0, 0), font=font)
          labeled.paste(solid_crop, (0, 22))
          y2 = solid_crop.height + 26
          draw.text((8, y2), "2. Double underline", fill=(0, 0, 0), font=font)
          labeled.paste(double_crop, (0, y2 + 18))
          y3 = y2 + double_crop.height + 22
          draw.text((8, y3), "3. Underline with 4px offset", fill=(0, 0, 0), font=font)
          labeled.paste(offset_crop, (0, y3 + 18))
          crop_path = os.path.join(repo, "tests", base + "_underline_crops.png")
          labeled.save(crop_path)
          
          prompt = f"""
              This image shows three labeled crops from a side-by-side browser
              comparison. LEFT is Incognidium, RIGHT is Firefox. The CSS sets
              `text-decoration-skip-ink: none`, so the underline should run
              continuously under the whole phrase.
          
              Crop 1: "Thick 4px underline" (blue 4px solid underline)
              Crop 2: "Double underline" (blue double underline)
              Crop 3: "Underline with 4px offset" (purple solid underline)
          
              Do these LEFT-side solid/double lines cross the spaces between words
              as one continuous bar, the way Firefox does on the RIGHT? Or are they
              clearly broken into separate word-sized segments with blank gaps at the
              spaces?
          
              Answer with exactly one of these two lines first, then add one short
              sentence explaining your choice:
              - PASS: the LEFT-side solid/double underlines are continuous across word spaces like Firefox.
              - FAIL: the LEFT-side solid/double underlines are visibly split into word-sized segments with blank gaps (name the affected line).
          """
          
          response = get_llm_response(
              prompt,
              model=model,
              provider=provider,
              api_url=api_url,
              images=[crop_path],
              npc=npc,
              temperature=0.1,
              timeout=300,
          )
          review = response.get("response", "")
          if review is None:
              review = ""
          if isinstance(review, dict):
              import json
              review = json.dumps(review)
          
          review_text = str(review).strip()
          context["review"] = review_text
          context["crop_path"] = crop_path
          context["side_by_side"] = side_by_side
          context["incog_png"] = incog_png
          context["firefox_png"] = firefox_png
          
          if review_text.upper().startswith("PASS"):
              print("PASS: text-decoration-skip-ink: none draws continuous underlines")
              context["output"] = "PASS: text-decoration-skip-ink: none draws continuous underlines"
          else:
              print(review_text)
              context["output"] = review_text
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_text_decoration_thickness():
          import os
