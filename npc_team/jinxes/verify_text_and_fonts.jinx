      def verify_font_stack_fallback():
          import os
          import sys
          
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          from npcpy.llm_funcs import get_llm_response
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = "test_sr_only_breakpoint.html"
          html_path = os.path.join(repo, "tests", fixture)
          base = "test_sr_only_breakpoint"
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          
          incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=1024)
          if not incog.get("ok"):
              print("FAIL: Incognidium render failed")
              print(incog.get("stderr", ""))
              context["output"] = "FAIL: Incognidium render failed"
              raise SystemExit(1)
          
          model = "glm-5.3-flash:cloud"
          provider = "ollama"
          api_url = "http://127.0.0.1:11434"
          
          prompt = f"""
              Look at the attached screenshot. It shows a single button near the
              top-left with a hamburger icon (a stack of three horizontal lines,
              Unicode U+2261) followed by the word "Menu".
          
              Does the icon render as a visible stack of three lines, or as a
              missing-glyph placeholder box (a hollow rectangle / tofu box)?
              Reply exactly "PASS" if you see a proper hamburger icon of three
              horizontal lines. Reply exactly "FAIL" if the icon is a missing-glyph
              placeholder or tofu box, and add one short sentence describing what
              you see.
          """
          
          response = get_llm_response(
              prompt,
              model=model,
              provider=provider,
              api_url=api_url,
              images=[incog_png],
              npc=npc,
              temperature=0.1,
              timeout=300,
          )
          review = response.get("response", "")
          if review is None:
              review = ""
          if isinstance(review, dict):
              import json
              review = json.dumps(review)
          
          review_text = str(review).strip()
          context["review"] = review_text
          context["incog_png"] = incog_png
          
          if review_text.upper().startswith("PASS"):
              print("PASS: hamburger icon renders through font-family fallback, not as tofu")
              context["output"] = "PASS: hamburger icon renders through font-family fallback, not as tofu"
          else:
              print(review_text)
              context["output"] = review_text
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_font_variant_emoji():
          import os
          import sys
          
          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          from npcpy.llm_funcs import get_llm_response
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = "test_font_variant_emoji.html"
          html_path = os.path.join(repo, "tests", fixture)
          base = "test_font_variant_emoji"
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          
          incog = render_local_file(html_path, incog_png, repo=repo)
          if not incog.get("ok"):
              context["output"] = f"FAIL: Incognidium render failed for {fixture}"
              raise SystemExit(1)
          
          expected_emoji = ["😀", "🎉", "❤", "🌟"]
          extracted = incog.get("extracted_text", "")
          missing = [ch for ch in expected_emoji if ch not in extracted]
          if missing:
              context["output"] = (
                  f"FAIL: emoji codepoints missing from extracted text: {missing}\n"
                  f"Extracted text:\n{extracted}"
              )
              raise SystemExit(1)
          
          prompt = f"""
            Look at the attached screenshot of a local HTML page titled "CSS font-variant-emoji Demo".
          
            The page shows four rows labeled Normal, Text style, Emoji style, and Unicode.
            Each row should contain four recognizable emoji: a smiley face, a party popper,
            a heart, and a star. Ignore minor style differences such as color vs. monochrome.
          
            Are there any empty boxes, tofu placeholders, or missing-glyph symbols among the
            emoji in any row?
          
            Answer with exactly one of these phrases:
            - "all emoji visible" if every row shows all four emoji clearly
            - "missing glyphs" if any row has empty boxes or placeholders
            - "unclear" if you cannot tell
          
            Then add one short sentence describing what you see.
          """
          
          last_error = None
          reviews = []
          for vote in range(3):
              response = None
              for attempt in range(3):
                  try:
                      response = get_llm_response(
                          prompt,
                          model="glm-5.3-flash:cloud",
                          provider="ollama",
                          api_url="http://127.0.0.1:11434",
                          images=[incog_png],
                          npc=npc,
                          temperature=0.2,
                          timeout=300,
                      )
                      break
                  except Exception as e:
                      last_error = e
                      print(f"LLM call vote {vote + 1} attempt {attempt + 1} failed: {e}")
                      if attempt < 2:
                          import time
                          time.sleep(2)
              if response is None:
                  reviews.append(f"LLM_ERROR: {last_error}")
                  continue
              review = response.get("response", "")
              if review is None:
                  review = ""
              if isinstance(review, dict):
                  import json
                  review = json.dumps(review)
              review_text = str(review).strip()
              reviews.append(review_text)
              if "missing glyphs" not in review_text.lower():
                  break
          
          context["incog_png"] = incog_png
          context["extracted_text"] = extracted
          context["vision_review"] = "\n---\n".join(
              f"Vote {i + 1}:\n{r}" for i, r in enumerate(reviews)
          )
          
          clean_reviews = [r for r in reviews if not r.startswith("LLM_ERROR:")]
          passing_review = next(
              (r for r in clean_reviews if "missing glyphs" not in r.lower()),
              None,
          )
          
          if not reviews:
              context["output"] = f"FAIL: vision review failed after 3 attempts: {last_error}"
              raise SystemExit(1)
          if not clean_reviews or passing_review is None:
              print(clean_reviews[-1] if clean_reviews else reviews[-1])
              context["output"] = f"FAIL: {clean_reviews[-1] if clean_reviews else reviews[-1]}"
              raise SystemExit(1)
          
          print(passing_review)
          print("PASS: all emoji are visible with no missing-glyph boxes.")
          context["output"] = "PASS: all emoji are visible with no missing-glyph boxes."
          return context.get("output", "")
      
