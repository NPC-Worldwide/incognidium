              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              boxes = result.get("text_lines", [])
              # Sort text boxes by visual line (y) then x.
              by_visual = sorted(boxes, key=lambda b: (b[1], b[0]))
              for i in range(len(by_visual) - 1):
                  x, y, w, h, text = by_visual[i]
                  if text.strip() != "CSS":
                      continue
                  nx, ny, nw, nh, ntext = by_visual[i + 1]
                  if abs(ny - y) > 5.0:
                      context["output"] = (
                          f"regression: 'CSS' link at y={y} is followed by '\"{ntext}\"' at y={ny}, "
                          f"so the trailing punctuation is on a different line."
                      )
                      print(context["output"])
                      raise SystemExit(1)
                  if ")" not in ntext:
                      context["output"] = (
                          f"regression: 'CSS' link at y={y} is not followed by its closing parenthesis."
                      )
                      print(context["output"])
                      raise SystemExit(1)
          
              context["output"] = "PASS: inline link punctuation stays on the same visual line"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_inline_wrap_code_siblings():
          import os, sys, traceback, re
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_inline_wrap_code_siblings.html")
              out_png = os.path.join(repo, "tests", "test_inline_wrap_code_siblings_incog.png")
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
                  viewport_width=800,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              text = result.get("extracted_text", "")
              # Normalize the renderer's extracted text: collapse runs of
              # whitespace and remove spurious spaces before punctuation that the
              # text-extraction step inserts from whitespace nodes.
              normalized = re.sub(r"\s+", " ", text).strip()
              normalized = normalized.replace(" ,", ",").replace(" .", ".")
          
              expected_phrase = (
                  "alpha, beta, gamma, delta, epsilon, zeta, eta, theta, "
                  "iota, kappa, lambda, and mu."
              )
              if expected_phrase not in normalized:
                  context["output"] = (
                      f"missing ordered phrase: {expected_phrase}\n"
                      f"normalized text:\n{normalized}"
                  )
                  print(context["output"])
                  raise SystemExit(1)
          
              # A stranded punctuation-only line indicates the old tearing bug.
              for raw_line in result.get("extracted_text", "").splitlines():
                  line = raw_line.strip()
                  if line in {",", ".", ", and", "and", "mu."}:
                      context["output"] = (
                          f"regression: stranded fragment '{line}'\n{text}"
                      )
                      print(context["output"])
                      raise SystemExit(1)
          
              context["output"] = "PASS: inline code siblings wrap without tearing"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
