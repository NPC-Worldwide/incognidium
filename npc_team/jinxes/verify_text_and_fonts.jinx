          os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
          from npcpy.llm_funcs import get_llm_response
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          html_path = os.path.join(repo, "tests", "test_text_gradient_background.html")
          png_path = os.path.join(repo, "tests", "test_text_gradient_background_incog.png")
          result = render_local_file(html_path, png_path, repo=repo)
          if not result.get("ok"):
              context["output"] = "FAIL: render"
              raise SystemExit(1)
          
          prompt = (
              "Look at the rendered image. "
              "There is a purple-gradient box with white text inside it. "
              "Does the white text sit directly on the gradient background, "
              "or is there a separate dark or opaque rectangle behind the text? "
              "Answer exactly PASS if the text sits directly on the gradient. "
              "Answer exactly FAIL if there is any extra rectangle, highlight, "
              "or darker slab behind the text."
          )
          answer = get_llm_response(
              prompt=prompt,
              model="glm-5.3-flash:cloud",
              provider="ollama",
              api_url="http://127.0.0.1:11434",
              images=[png_path],
          )
          if isinstance(answer, dict):
              answer_text = answer.get("response", "")
          else:
              answer_text = str(answer)
          answer_text = answer_text.strip()
          if "PASS" not in answer_text or "FAIL" in answer_text:
              context["output"] = "FAIL: vision review: " + answer_text
              raise SystemExit(1)
          
          print("PASS: white text sits directly on the gradient background")
          context["output"] = "PASS"
          return context.get("output", "")
      
      def verify_webfont_var():
          import os, sys, traceback
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_webfont_var.html")
              out_png = os.path.join(repo, "tests", "test_webfont_var_incog.png")
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
                  viewport_width=800,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              text_widths = [
                  w for (_nid, tag, _cls, _x, _y, w, _h, _img, text) in result["flat_box_lines"]
                  if tag == "#text" and text.strip() == "Webfont via declaration"
              ]
              if len(text_widths) < 2:
                  context["output"] = f"expected 2 text boxes, found {len(text_widths)}"
                  print(context["output"])
                  raise SystemExit(1)
          
              first, second = text_widths[0], text_widths[1]
              if abs(first - second) > 0.5:
                  context["output"] = f"width mismatch: direct={first} variable={second}"
                  print(context["output"])
                  raise SystemExit(1)
          
              context["output"] = f"PASS: webfont via CSS variable matches direct declaration ({first}px)"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
