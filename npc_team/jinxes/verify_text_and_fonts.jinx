      def verify_inline_wrap_resplit():
          import os, sys, traceback, re
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_inline_wrap_resplit.html")
              out_png = os.path.join(repo, "tests", "test_inline_wrap_resplit_incog.png")
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
                  viewport_width=800,
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              extracted = result.get("extracted_text", "")
              lines = [l.strip() for l in extracted.splitlines()]
              if any(l == "generally" for l in lines):
                  context["output"] = f"regression: 'generally' rendered as its own line\n{extracted}"
                  print(context["output"])
                  raise SystemExit(1)
              if not any(re.search(r"generally\s+used", l) for l in lines):
                  context["output"] = f"regression: 'generally' and 'used' not on the same line\n{extracted}"
                  print(context["output"])
                  raise SystemExit(1)
          
              # Guard against tiny single-word text boxes produced by the bug.
              for x, y, w, h, text in result.get("text_lines", []):
                  if text.strip() == "generally":
                      context["output"] = f"regression: single-word text box 'generally' at ({x},{y})"
                      print(context["output"])
                      raise SystemExit(1)
          
              context["output"] = "PASS: inline wrap does not re-split continuation fragments"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_marker_no_letter_word_spacing():
          import os
          import re
          import sys
          import tempfile
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = "test_marker_spacing.html"
          html_path = os.path.join(repo, "tests", fixture)
          base = "test_marker_no_letter_word_spacing"
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          
          html = open(html_path).read()
          # Strip the letter-spacing and word-spacing declarations from ::marker
          # rules so we can compare marker widths with and without them.
          no_spacing_html = re.sub(r"\s*(letter-spacing|word-spacing):\s*[^;]+;", "", html)
          tmp_fd, tmp_html_path = tempfile.mkstemp(suffix=".html", prefix="marker_no_spacing_")
          try:
              with os.fdopen(tmp_fd, "w") as f:
                  f.write(no_spacing_html)
          
              incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=1024)
              if not incog.get("ok"):
                  print("FAIL: Incognidium render failed")
                  print(incog.get("stderr", ""))
                  context["output"] = "FAIL: Incognidium render failed"
                  raise SystemExit(1)
          
              ref_png = os.path.join(repo, "tests", base + "_ref.png")
              ref = render_local_file(tmp_html_path, ref_png, repo=repo, viewport_width=1024)
              if not ref.get("ok"):
                  print("FAIL: reference render failed")
                  print(ref.get("stderr", ""))
                  context["output"] = "FAIL: reference render failed"
                  raise SystemExit(1)
          
              def marker_boxes(render):
                  boxes = []
                  for node_id, tag, cls, x, y, w, h, img, text in render.get("flat_box_lines", []):
                      if tag == "li" and text:
                          boxes.append((y, text, w))
                  boxes.sort(key=lambda b: b[0])
                  return boxes
          
              spaced = marker_boxes(incog)
              plain = marker_boxes(ref)
          
              if len(spaced) != len(plain):
                  print(f"FAIL: marker count mismatch ({len(spaced)} vs {len(plain)})")
                  context["output"] = f"FAIL: marker count mismatch ({len(spaced)} vs {len(plain)})"
                  raise SystemExit(1)
          
              tolerance = 1.0
              for (sy, stext, sw), (py, ptext, pw) in zip(spaced, plain):
                  if abs(sw - pw) > tolerance:
                      print(f"FAIL: marker {stext!r} width differs with spacing ({sw:.1f}px vs {pw:.1f}px)")
                      context["output"] = f"FAIL: marker {stext!r} width differs with spacing ({sw:.1f}px vs {pw:.1f}px)"
                      raise SystemExit(1)
          
              print("PASS: ::marker ignores letter-spacing and word-spacing, matching the no-spacing reference")
              context["output"] = "PASS: ::marker ignores letter-spacing and word-spacing, matching the no-spacing reference"
          finally:
              try:
                  os.unlink(tmp_html_path)
              except FileNotFoundError:
                  pass
          return context.get("output", "")
      
      def verify_marker_spacing():
          import os
          import re
          import sys
          
          repo = os.getcwd()
          if repo not in sys.path:
              sys.path.insert(0, repo)
          
          fixture = "test_marker_spacing.html"
          html_path = os.path.join(repo, "tests", fixture)
          base = "test_marker_spacing"
          incog_png = os.path.join(repo, "tests", base + "_incog.png")
          
          incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=800)
          if not incog.get("ok"):
              print("FAIL: Incognidium render failed")
              context["output"] = "FAIL: Incognidium render failed"
              raise SystemExit(1)
          
          text = incog.get("extracted_text", "")
          lines = [ln for ln in text.splitlines() if ln.strip()]
          
          # Ordered markers (decimal/alpha/roman) and the circle bullet used in the
          # fixture should be followed by whitespace, not immediately by content.
          marker_patterns = [
              re.compile(r"^(\d+\.)\S"),
              re.compile(r"^([A-Za-z]+\.)\S"),
              re.compile(r"^(◦)\S"),
          ]
          
          failures = []
          for ln in lines:
              for pat in marker_patterns:
                  m = pat.match(ln)
                  if m:
                      failures.append(f"fused marker: {ln!r}")
                      break
          
          if failures:
              msg = "FAIL: " + "; ".join(failures)
              print(msg)
              context["output"] = msg
              raise SystemExit(1)
          
          print("PASS: list markers keep a visual gap before item text")
          context["output"] = "PASS: list markers keep a visual gap before item text"
          return context.get("output", "")
      
      def verify_negative_word_spacing_no_overlap():
          import os, sys, traceback
          
          try:
              repo = os.getcwd()
              if repo not in sys.path:
                  sys.path.insert(0, repo)
          
              fixture = os.path.join(repo, "tests", "test_uppercase_byline3.html")
              out_png = "/tmp/verify_negative_word_spacing_no_overlap.png"
              result = render_local_file(
                  fixture,
                  out_png,
                  repo=repo,
                  dump_boxes="flat",
              )
              if not result.get("ok"):
                  context["output"] = f"render failed: {result.get('stderr', '')}"
                  print(context["output"])
                  raise SystemExit(1)
          
              # Find the two visible text boxes in document order.
              texts = [
                  (x, y, w, h, text)
                  for _node_id, _tag, _class, x, y, w, h, _image_src, text in result.get("flat_box_lines", [])
                  if text.strip()
              ]
              if len(texts) < 2:
                  context["output"] = f"expected two text boxes, got {len(texts)}"
                  print(context["output"])
                  raise SystemExit(1)
          
              first = texts[0]
              second = texts[1]
              first_right = first[0] + first[2]
              overlap = first_right - second[0]
              if overlap > 0.5:
                  context["output"] = (
                      f"FAIL: negative word-spacing makes inline siblings overlap by {overlap:.1f}px "
                      f"(first ends at {first_right:.1f}, second starts at {second[0]:.1f})"
                  )
                  print(context["output"])
                  raise SystemExit(1)
          
              context["output"] = "PASS: negative word-spacing does not overlap inline siblings"
              print(context["output"])
          except Exception as e:
              msg = f"ERROR: {e}\n{traceback.format_exc()}"
              context["output"] = msg
              print(msg)
              raise SystemExit(1)
          return context.get("output", "")
      
      def verify_no_leading_hyphen_break():
          import os
          import sys
          
