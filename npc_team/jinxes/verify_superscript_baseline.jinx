#!/usr/bin/env npc
jinx_name: verify_superscript_baseline
description: |
  Regression check that the default UA stylesheet renders <sup> above the
  baseline and <sub> below it, matching browser defaults.

inputs:
  - model: "glm-5.3-flash:cloud"
  - provider: "ollama"
  - api_url: "http://127.0.0.1:11434"

steps:
  - name: render_and_verify
    engine: python
    code: |
        import os
        import sys

        os.environ["OLLAMA_HOST"] = "http://127.0.0.1:11434"
        from npcpy.llm_funcs import get_llm_response

        repo = os.getcwd()
        if repo not in sys.path:
            sys.path.insert(0, repo)
        from npc_team.jinxes.lib.render_local import render_local_file

        fixture = "test_superscript_baseline.html"
        html_path = os.path.join(repo, "tests", fixture)
        base = "test_superscript_baseline"
        incog_png = os.path.join(repo, "tests", base + "_incog.png")

        incog = render_local_file(html_path, incog_png, repo=repo, viewport_width=400)
        if not incog.get("ok"):
            print("FAIL: Incognidium render failed")
            context["output"] = "FAIL: Incognidium render failed"
            raise SystemExit(1)

        model = {{ model | default("glm-5.3-flash:cloud") | tojson }}
        provider = {{ provider | default("ollama") | tojson }}
        api_url = {{ api_url | default("http://127.0.0.1:11434") | tojson }}

        prompt = f"""
            Look at the attached screenshot of a small test page. The sentence
            reads "Einstein wrote [1] and water is H2O."

            The "[1]" is wrapped in a <sup> element and should appear as a
            superscript: smaller than the surrounding text and raised above the
            baseline. The "2" in "H2O" is wrapped in a <sub> element and should
            appear as a subscript: smaller and lowered below the baseline.

            Are both the superscript "[1]" and the subscript "2" clearly raised
            and lowered respectively, and are they smaller than the surrounding
            text? Reply exactly "PASS" if yes. Reply exactly "FAIL" if either
            marker sits on the baseline or is the same size as the surrounding
            text, and add one short sentence describing what you see.
        """

        response = get_llm_response(
            prompt,
            model=model,
            provider=provider,
            api_url=api_url,
            images=[incog_png],
            npc=npc,
            temperature=0.1,
            timeout=300,
        )
        review = response.get("response", "")
        if review is None:
            review = ""
        if isinstance(review, dict):
            import json
            review = json.dumps(review)

        review_text = str(review).strip()
        context["review"] = review_text
        context["incog_png"] = incog_png

        if review_text.upper().startswith("PASS"):
            print("PASS: default sup/sub vertical-align renders above and below the baseline")
            context["output"] = "PASS: default sup/sub vertical-align renders above and below the baseline"
        else:
            print(review_text)
            context["output"] = review_text
            raise SystemExit(1)
